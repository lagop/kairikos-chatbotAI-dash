{
  "name": "kairikos-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:cross-tenant": "playwright test tests/specs/cross-tenant.spec.ts",
    "test:onboarding": "playwright test tests/specs/onboarding.spec.ts",
    "test:conversations": "playwright test tests/specs/conversations.spec.ts",
    "test:billing": "playwright test tests/specs/billing.spec.ts",
    "test:admin": "playwright test tests/specs/admin.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "smoke:internal-activity": "tsx scripts/smoke-internal-activity.ts",
    "smoke:internal-routes": "tsx scripts/smoke-internal-routes.ts",
    "smoke:internal-state-transition": "tsx scripts/smoke-internal-state-transition.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@node-rs/argon2": "^2.0.2",
    "@otplib/preset-default": "^12.0.1",
    "@prisma/client": "^5.22.0",
    "@hookform/resolvers": "^3.9.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "next": "14.2.13",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "resend": "^6.12.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.13",
    "postcss": "^8.5.16",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.8"
  }
}
