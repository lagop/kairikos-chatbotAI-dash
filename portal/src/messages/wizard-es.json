"emails": {
    "abandonment": {
      "recoveryEarly": {
        "subject": "Tu bot te espera",
        "body": "Hola {nombre},\n\nVi que empezaste a configurar tu asistente pero no terminaste. No pasa nada — lo guardamos todo para que continúes cuando quieras.\n\nSon solo unos minutos para tener tu bot funcionando. ¿Continuamos?\n\n[{boton_cta}]({url_wizard})\n\nSi tienes dudas, escríbenos y te ayudo.\n¡Un saludo!\nKira"
      },
      "recoveryLate": {
        "subject": "Tu bot de {nombre_comercial} te espera",
        "body": "Hola {nombre},\n\nHace unos días empezaste a configurar tu bot pero no pudiste terminar. Lo tenemos todo guardado.\n\nSon 11 pasos y puedes hacerlo en ratos sueltos. ¿Le das un empujón hoy?\n\n[{boton_cta}]({url_wizard})\n\nSi prefieres que te ayudemos por teléfono, escríbenos y te llamamos.\n¡Un saludo!\nKira"
      }
    }
  },

  "notifications": {
    "submitted": {
      "subject": "Nueva configuración pendiente",
      "body": "Nueva configuración de {nombre_cliente} ({vertical}).\n\nCliente: {nombre_comercial}\nPasos: {pasos_completados}\n\nRevisar: {url_admin}"
    },
    "approved": {
      "subject": "¡Tu bot está aprobado!",
      "body": "Hola {nombre},\n\n¡Buenas noticias! Tu configuración ha sido aprobada.\n\nQueda un último paso: cablear el bot. Te avisamos en cuanto esté listo (24-48h).\n\nSi tienes dudas, escríbenos.\n\n¡Un saludo!\nKira"
    },
    "needsRevision": {
      "subject": "Tu configuración necesita ajustes",
      "body": "Hola {nombre},\n\nTu configuración necesita algunos ajustes:\n\n{comentario}\n\nAccede aquí: {url_wizard}\n\nSi tienes dudas, escríbenos y te ayudo.\n\n¡Un saludo!\nKira"
    },
    "live": {
      "subject": "¡Tu bot ya está vivo!",
      "body": "Hola {nombre},\n\n¡Enhorabuena! Tu asistente ya está funcionando.\n\nPruébalo en {url_canales}. El bot responderá según la configuración que nos diste.\n\nPuedes hacer cambios cuando quieras desde el panel.\n\n¡Un saludo!\nKira"
    }
  }
