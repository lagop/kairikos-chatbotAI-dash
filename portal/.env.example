# Kairikos Portal — frontend env

# --- Database (Prisma + PostgreSQL 16) ---------------------------------------
# Prisma reads DATABASE_URL from the Node.js process at build time and at
# runtime (migrations, `prisma db seed`, the Next.js server). The URL points
# at the `postgres` service in docker-compose.yml on the host loopback for
# local dev; in the VPS production deploy it is reached over the internal
# Docker network as `postgres:5432`. NEVER commit a real DATABASE_URL to git.
DATABASE_URL=postgresql://kairikos:kairikos_dev_password@localhost:5432/kairikos_portal?schema=public
# Shadow URL used by Prisma Migrate for non-destructive commands. Same value
# as DATABASE_URL in dev; in prod the deploy script can scope it to a
# read-only role if desired.
SHADOW_DATABASE_URL=postgresql://kairikos:kairikos_dev_password@localhost:5432/kairikos_portal_shadow?schema=public

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_PORTAL_URL=https://portal.kairikos.com

# Server-only
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
PORTAL_API_BASE_URL=https://api.kairikos.com

# Analytics (optional — leave blank to disable)
PORTAL_ANALYTICS_ENDPOINT=
PORTAL_ANALYTICS_SITE_ID=kairikos-portal
