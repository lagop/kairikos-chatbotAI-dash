# Kairikos Portal — frontend env

# --- Database (Prisma + PostgreSQL 16) ---------------------------------------
# Prisma reads DATABASE_URL from the Node.js process at build time and at
# runtime (migrations, `prisma db seed`, the Next.js server). The URL points
# at the `postgres` service in docker-compose.yml on the host loopback for
# local dev; in the VPS production deploy it is reached over the internal
# Docker network as `postgres:5432`. NEVER commit a real DATABASE_URL to git.
DATABASE_URL=postgresql://kairikos:kairikos_dev_password@localhost:5432/kairikos_portal?schema=public
# Shadow URL used by Prisma Migrate for non-destructive commands. Same value
# as DATABASE_URL in dev; in prod the deploy script can scope it to a
# read-only role if desired.
SHADOW_DATABASE_URL=postgresql://kairikos:kairikos_dev_password@localhost:5432/kairikos_portal_shadow?schema=public

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_PORTAL_URL=https://portal.kairikos.com

# Server-only
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
PORTAL_API_BASE_URL=https://api.kairikos.com

# Analytics (optional — leave blank to disable)
PORTAL_ANALYTICS_ENDPOINT=
PORTAL_ANALYTICS_SITE_ID=kairikos-portal

# --- KAIA-753 — NextAuth.js v5 magic-link (Resend) ----------------------------
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_EMAIL_FROM=Kairikos Portal <hola@kairikos.com>
AUTH_SUPPORT_EMAIL=hola@kairikos.com
AUTH_SUPPORT_WHATSAPP=https://wa.me/34600000000
# Resend SMTP API key — get from https://resend.com/api-keys
RESEND_API_KEY=
# Canonical production URL (no trailing slash). Used by NextAuth for the magic
# link host part. In dev with `next dev` on port 3001 the framework sets this
# automatically; in production it MUST match the external URL.
NEXTAUTH_URL=https://portal.kairikos.com

# --- KAIA-756 — internal API auth (n8n → portal) -----------------------------
# Shared secret used by the n8n T+0/3/7/14 workflows and the status-change
# watcher to authenticate against the portal's /api/internal/* routes. The
# portal refuses to start serving internal routes if this is unset (fail
# closed). The matching n8n credential lives in the n8n vault under
# `PORTAL_API_KEY`; rotate both sides together. Generate with:
#   openssl rand -hex 32
PORTAL_API_KEY=

# --- KAIA-1177 — CEO escalation recipient (review-overdue AU-2) --------------
# Recipient of `review-overdue/escalation` notifications; required — the route
# fails closed with HTTP 500 `ceo_not_configured` when this is empty. Set this
# in staging + production env files. Read by
# portal/src/app/api/internal/review-overdue/fire/route.ts (see
# resolveCeoRecipient in portal/src/lib/operator-notify.ts).
KAIRIKOS_CEO_EMAIL=
