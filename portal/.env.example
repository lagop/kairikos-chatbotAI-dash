# Kairikos Portal — frontend env

# --- Database (Prisma + PostgreSQL 16) ---------------------------------------
# Prisma reads DATABASE_URL from the Node.js process at build time and at
# runtime (migrations, `prisma db seed`, the Next.js server). The URL points
# at the `postgres` service in docker-compose.yml on the host loopback for
# local dev; in the VPS production deploy it is reached over the internal
# Docker network as `postgres:5432`. NEVER commit a real DATABASE_URL to git.
DATABASE_URL=postgresql://kairikos:kairikos_dev_password@localhost:5432/kairikos_portal?schema=public
# Shadow URL used by Prisma Migrate for non-destructive commands. Same value
# as DATABASE_URL in dev; in prod the deploy script can scope it to a
# read-only role if desired.
SHADOW_DATABASE_URL=postgresql://kairikos:kairikos_dev_password@localhost:5432/kairikos_portal_shadow?schema=public
# KAIA-14409 — direct (port 5432) PostgreSQL URL bypassing the
# transaction-mode PgBouncer pool (port 6543). The Prisma schema
# declares `directUrl = env("DIRECT_URL")`, which Prisma uses for
# migration-related operations (e.g. `prisma migrate deploy`).
# The Vercel build script added on commit 3453364 runs
# `prisma migrate deploy` against this URL on every production build,
# so this must be set in the Vercel build environment before
# `prisma generate` runs. Vercel already exposes `DIRECT_URL` on
# production + preview targets. NEVER commit a real DIRECT_URL to git.
#
# KAIA-14440 — use the *session-mode pooler*, not the db.<ref> host:
#
#   DATABASE_URL  aws-0-<region>.pooler.supabase.com:6543   (app queries, txn mode)
#   DIRECT_URL    aws-0-<region>.pooler.supabase.com:5432   (migrations, session mode)
#
# Do NOT set DIRECT_URL to db.<project-ref>.supabase.co:5432. That host is
# IPv6-only and Vercel/CI build containers are IPv4-only, so migrations fail
# there with "Network is unreachable" even though the URL looks right. The
# pooler host resolves to IPv4 and supports the advisory locks DDL needs.
DIRECT_URL=
# KAIA-14388 — secondary alias for the direct URL still consumed by
# older deploy scripts and ad-hoc Prisma tooling. The portal code
# itself only reads DATABASE_URL above. NEVER commit a real
# SUPABASE_DB_URL to git.
SUPABASE_DB_URL=

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_PORTAL_URL=https://portal.kairikos.com

# Server-only
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
PORTAL_API_BASE_URL=https://api.kairikos.com

# Analytics (optional — leave blank to disable)
PORTAL_ANALYTICS_ENDPOINT=
PORTAL_ANALYTICS_SITE_ID=kairikos-portal

# --- KAIA-753 — NextAuth.js v5 magic-link (Resend) ----------------------------
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_EMAIL_FROM=Kairikos Portal <hola@kairikos.com>
AUTH_SUPPORT_EMAIL=hola@kairikos.com
AUTH_SUPPORT_WHATSAPP=https://wa.me/34624514425
# Resend SMTP API key — get from https://resend.com/api-keys
RESEND_API_KEY=
# Canonical production URL (no trailing slash). Used by NextAuth for the magic
# link host part. In dev with `next dev` on port 3001 the framework sets this
# automatically; in production it MUST match the external URL.
NEXTAUTH_URL=https://portal.kairikos.com

# --- KAIA-756 — internal API auth (n8n → portal) -----------------------------
# Shared secret used by the n8n T+0/3/7/14 workflows and the status-change
# watcher to authenticate against the portal's /api/internal/* routes. The
# portal refuses to start serving internal routes if this is unset (fail
# closed). The matching n8n credential lives in the n8n vault under
# `PORTAL_API_KEY`; rotate both sides together. Generate with:
#   openssl rand -hex 32
PORTAL_API_KEY=

# --- KAIA-2103 — Operator bypass key for admin page access -------------------
# Shared secret sent as the `x-kaia-operator-key` header to bypass the
# NextAuth session check on admin pages and API routes. Also used by the
# admin password endpoints as an alternative to operator session auth.
# Generate with: openssl rand -hex 32
KAIA_OPERATOR_API_KEY=

# --- KAIA-13797 — QA SSR probe token (staging only) --------------------------
# Server-side secret used by `/api/qa-probe` to render operator-only SSR
# pages for QA verification on staging. The route stays 404 in production
# when this is unset, so the value is intentionally NEVER set there. The
# QA harness sends it as `X-QA-Probe-Token`; the route refuses anything
# outside `/admin/portal/*` and never echoes the value back. Must be at
# least 32 chars. Rotate by writing a new value to Vercel env and
# re-deploying; the matching load-secrets.sh entry on the QA side picks
# up the new value on the next heartbeat. Generate with:
#   openssl rand -hex 32
QA_PROBE_TOKEN=

# --- KAIA-2103 — Allowed email domain for setup-password ----------------------
# Comma-separated list of email domains permitted to use /api/portal/setup-password.
# Defaults to "kairikos.com" when unset. Restricts which email addresses can
# self-service set a password.
ALLOWED_SETUP_DOMAIN=kairikos.com

# --- KAIA-1107 — Operator TOTP encryption key ---------------------------------
# 256-bit hex key (32 bytes = 64 hex chars) used to encrypt operator TOTP
# secrets at rest. Generate with: openssl rand -hex 32
OPERATOR_TOTP_ENCRYPTION_KEY=

# --- KAIA-1177 — CEO escalation recipient (review-overdue AU-2) --------------
# Recipient of `review-overdue/escalation` notifications; required — the route
# fails closed with HTTP 500 `ceo_not_configured` when this is empty. Set this
# in staging + production env files. Read by
# portal/src/app/api/internal/review-overdue/fire/route.ts (see
# resolveCeoRecipient in portal/src/lib/operator-notify.ts).
KAIRIKOS_CEO_EMAIL=

# --- KAIA-2900 — Canonical test-user password (staging only) -----------------
# Plaintext password that the Backend Developer's `scripts/seed-test-credentials.ts`
# writes into `User.passwordHash` (argon2id) for the four seeded test users:
#   - onboarding-test1@kairikos.dev  (client — Acme Clay Ovens, Pro tier)
#   - onboarding-test2@kairikos.dev  (client — Brisa Beach Houses, Starter)
#   - staff-test@kairikos.dev        (client — staff-role seed)
#   - ops-staging@kairikos.com       (operator — admin login)
# The Playwright fixture in `tests/fixtures/portal.ts` and the QA `load-secrets.sh`
# source this same env var so the `portal-credentials` POST in
# `authedPortalFixture` succeeds. See `STAGING.md` §"Test logins" for the
# full runbook. Set in staging `.env` ONLY — never in production.
# Generate with: openssl rand -base64 18
STAGING_TEST_USER_PASSWORD=

# --- KAIA-2913 — In-house intake endpoint configuration ---------------------
# Google OAuth credentials used by POST /api/public/intake to provision the
# per-client Drive folder under Clientes/<NombreNegocio>/. The refresh
# token MUST live in Secret Manager (not adapterConfig.env) per KAIA-1702.
# Rotate together with the OAuth client secret in GCP.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Parent Drive folder id under which Clientes/ lives. When unset the
# folder is created in the OAuth user's My Drive root (dev convenience).
DRIVE_PARENT_FOLDER_ID=
# Public URL of the on-call onboarding kit PDF, fetched and uploaded as
# 01_Kit_de_Onboarding.pdf into each client folder. When unset the kit
# PDF step is logged and skipped (intake still completes).
KAIRIKOS_KIT_INTAKE_PDF_URL=

# Paperclip control plane — used by the intake endpoint to open the Day-2
# onboarding issue for the Automation Engineer. PAPERCLIP_DAY2_AGENT_ID is
# the agent id of the Automation Engineer (optional — when unset the issue
# is created unassigned and triage decides who picks it up).
PAPERCLIP_API_URL=
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_DAY2_AGENT_ID=

# --- WP-21 — Google Business Profile OAuth (client-facing, reviews) ---------
# A SEPARATE OAuth client from GOOGLE_OAUTH_CLIENT_ID/SECRET above — those
# authorize Kairikos's OWN Google account for internal Drive provisioning
# (KAIA-2913, one static refresh token). This client authorizes each
# CLIENT's own Google account, scope `business.manage`, one connection
# per Business Profile location (see GoogleBusinessConnection). Requires
# the Business Profile APIs to be enabled AND access-approved on the
# associated Google Cloud project (WP-20) before the consent screen will
# work — enabling the APIs alone is not enough.
GOOGLE_BUSINESS_OAUTH_CLIENT_ID=
GOOGLE_BUSINESS_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client in
# Google Cloud Console. When unset, derived as
# `${NEXT_PUBLIC_PORTAL_URL}/api/portal/google-business/oauth/callback`.
GOOGLE_BUSINESS_OAUTH_REDIRECT_URI=
# 256-bit hex key (32 bytes = 64 hex chars) used to encrypt each
# connection's refresh token at rest (AES-256-GCM, lib/operator-crypto.ts).
# Deliberately a DIFFERENT key from OPERATOR_TOTP_ENCRYPTION_KEY above —
# different secret classes should never share key material.
# Generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- WP: conexión de canales — Meta (WhatsApp/Messenger/Instagram) ----------
# NOT a plain OAuth redirect like the Google integration above — this uses
# Meta's WhatsApp Embedded Signup, the flow Meta recommends for SaaS
# platforms. The client-side JS SDK (loaded by MetaChannelCard.tsx) opens
# Meta's own popup flow using a Business Login "configuration" (META_CONFIG_ID)
# created in the Meta App Dashboard — that configuration decides which
# permissions get requested (whatsapp_business_management, pages_show_list,
# pages_messaging, instagram_basic, instagram_manage_messages,
# business_management) and is external setup, not something this repo
# creates. The SDK returns an authorization `code` (not a redirect) that
# the client posts to POST /api/portal/channels/meta/complete-signup, which
# exchanges it server-side. META_APP_ID and META_CONFIG_ID are not secrets
# (Meta's SDK expects them visible in the browser) — /portal/canales reads
# them server-side and passes them as props into MetaChannelCard.tsx rather
# than baking them into a NEXT_PUBLIC_ var. Only META_APP_SECRET is a real
# secret, read exclusively server-side (lib/meta-business.ts).
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Fase 8 ('recall') — Coexistence. A SEPARATE Configuration from
# META_CONFIG_ID above, created in the Meta App Dashboard from the
# "WhatsApp Embedded Signup Configuration With 60 Expiration Token"
# template (or a custom coexistence configuration) — which config_id the
# popup opens with is what selects Coexistence vs. the standard
# Cloud-API-only flow, not a client-side flag. Gates
# /portal/llamadas's "Conectar tu WhatsApp" card and POST
# /api/portal/recall/meta-connect independently of META_CONFIG_ID, so
# the standard chatbot channel connect keeps working even before this
# one is set up. See src/lib/meta-business.ts.
META_COEXISTENCE_CONFIG_ID=
# Graph API version pin — Meta deprecates old versions on a schedule, keep
# this current. Defaults to v21.0 in code when unset.
META_GRAPH_API_VERSION=

# --- WP-22a — Google review sync -------------------------------------------
# Minimum minutes between two review-sync runs for the SAME connection —
# both the manual "Sincronizar ahora" button and the cron sweep honor
# this, so it's the one place that controls how often the WP-20-granted
# quota gets spent. Defaults to 60 when unset.
GOOGLE_REVIEWS_SYNC_MIN_INTERVAL_MINUTES=60
# Shared secret Vercel Cron sends back as `Authorization: Bearer
# <CRON_SECRET>` on every scheduled invocation of
# /api/cron/sync-google-reviews (see vercel.json). Generate with:
# openssl rand -hex 32
CRON_SECRET=

# --- WP-22c — AI-drafted review replies ------------------------------------
# First AI-provider integration in this portal — the real chatbot's own
# generation lives in a different system. Get a key from
# https://console.anthropic.com/. Absence disables the "Generar
# borrador" button (dev-safe no-op, same convention as RESEND_API_KEY).
ANTHROPIC_API_KEY=
# Optional override — defaults to a fast/cheap model in code.
ANTHROPIC_REVIEW_REPLY_MODEL=

# --- Canales Fase 7 — resúmenes periódicos de conversaciones ---------------
# Reusa ANTHROPIC_API_KEY / RESEND_API_KEY / CRON_SECRET de arriba — sin
# secretos nuevos. Optional override — defaults to a fast/cheap model in code.
ANTHROPIC_CONVERSATION_DIGEST_MODEL=

# --- Canales Fase 4 — widget de chat Web ------------------------------------
# URL pública del webhook de n8n que atiende el tráfico de mensajes del
# widget (workflow "Kairikos Webchat Multi-tenant") — NO es secreta (el
# widget la recibe vía GET /api/public/channels/web/config y llama a n8n
# directo desde el navegador del visitante, sin pasar por el portal).
# El propio portal solo la reenvía; nunca la usa para autenticar nada.
N8N_WEBCHAT_URL=

# --- Stripe billing ----------------------------------------------------------
# Used only as a FALLBACK when no credential has been saved via
# /admin/portal/settings/billing yet (see stripe-credentials.ts's
# resolveActiveStripeSecret()) — once an operator saves a key there and
# picks an active mode, that DB-stored key takes priority over this env
# var for every Stripe API call (checkout, billing overview, catalog
# bootstrap/reprice). Kept as a fallback so local dev / a fresh
# environment isn't hard-broken before the first key is pasted.
STRIPE_SECRET_KEY=
# Tied to the webhook endpoint configured in the Stripe Dashboard — NOT
# sourced from the DB-stored credential above, since it authenticates
# incoming webhook payloads rather than outgoing API calls.
STRIPE_WEBHOOK_SECRET=

# --- Stripe operator credential encryption ----------------------------------
# 256-bit hex key (32 bytes = 64 hex chars) used to encrypt the operator's
# Stripe secret keys (test + live), pasted via
# /admin/portal/settings/billing, at rest (AES-256-GCM,
# lib/operator-crypto.ts). Deliberately a DIFFERENT key from
# OPERATOR_TOTP_ENCRYPTION_KEY / GOOGLE_TOKEN_ENCRYPTION_KEY above —
# different secret classes should never share key material. Losing this
# key makes every saved Stripe credential unrecoverable — the operator
# would need to paste both keys again from the Stripe Dashboard.
# Generate with: openssl rand -hex 32
STRIPE_CREDENTIAL_ENCRYPTION_KEY=

# --- Operator integration credential encryption ------------------------------
# 256-bit hex key (32 bytes = 64 hex chars) used to encrypt the operator's
# own third-party API keys (currently just Google Places), pasted via
# /admin/portal/settings/integrations, at rest (AES-256-GCM,
# lib/operator-crypto.ts / lib/integration-credentials.ts). Deliberately a
# DIFFERENT key from every other *_ENCRYPTION_KEY above — different secret
# classes should never share key material. Losing this key makes every
# saved integration credential unrecoverable — the operator would need to
# paste the key again from that integration's own dashboard.
# Generate with: openssl rand -hex 32
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=

# --- WP: conexión de canales — cifrado de credenciales de canal --------------
# 256-bit hex key (32 bytes = 64 hex chars) used to encrypt at rest
# (AES-256-GCM, lib/channel-crypto.ts) the credentials a client provides
# to connect a chatbot channel: Telegram bot tokens and Meta access
# tokens (WhatsApp/Messenger/Instagram) share this ONE key — both are the
# same class of secret ("chat channel credential"). Deliberately a
# DIFFERENT key from every other *_ENCRYPTION_KEY above — different
# secret classes should never share key material. The Web widget's
# public embed token is NOT covered by this key — it's a public
# identifier, not a secret.
# Generate with: openssl rand -hex 32
CHANNEL_CREDENTIAL_ENCRYPTION_KEY=

# --- WP: conexión de canales — puente saliente hacia n8n ---------------------
# The portal→n8n direction only (no read access from the external
# conversation engine into this database). Every channel connect/
# disconnect fires an authenticated webhook to N8N_CHANNEL_WEBHOOK_URL —
# an awareness/audit signal for n8n, not the thing that makes the
# channel work. Telegram's own webhook subscription is called by the
# PORTAL directly (setWebhook/deleteWebhook, lib/telegram-api.ts) at
# connect/disconnect time, since the portal has the bot token in memory
# right then, before encrypting it — n8n never sees the raw token.
# Failed N8N_CHANNEL_WEBHOOK_URL deliveries are retried by the
# /api/cron/sync-channel-webhooks cron (ChannelWebhookDelivery table)
# and, past the retry ceiling, can be re-fired manually by an operator
# from /admin/portal/[clientId].
N8N_CHANNEL_WEBHOOK_URL=
# Shared secret sent as `x-kairikos-internal-key` on every delivery —
# same header/comparison convention as PORTAL_API_KEY (internal-auth.ts),
# but in the reverse direction: here the PORTAL is the caller proving its
# identity to n8n, not the other way around. Generate with:
#   openssl rand -hex 32
N8N_CHANNEL_WEBHOOK_SECRET=

# Base URL of the n8n webhook that receives INCOMING Telegram messages —
# one path per connection, built as `${N8N_TELEGRAM_WEBHOOK_BASE_URL}/<connectionId>`.
# The connect route (telegram/connect) registers this exact URL with
# Telegram via setWebhook; the disconnect route unregisters it via
# deleteWebhook. Not secret (Telegram itself must be able to reach it),
# but unguessable in practice since connectionId is a UUID.
N8N_TELEGRAM_WEBHOOK_BASE_URL=

# --- 'recall' (Llamadas perdidas) — Twilio telephony -------------------------
# Account-level Twilio credentials (lib/telephony/twilio.ts) — provision/
# release virtual numbers, send SMS fallback, and verify the signature on
# every inbound call/recording webhook. NOT per-client: this product
# forwards the client's OWN line to a pooled Twilio number, so one
# account covers every client.
# UNVERIFIED AGAINST A REAL TWILIO ACCOUNT — no credentials reachable
# from any environment this code has been built in. See that file's
# header.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Spanish numbering has a regulatory requirement: Twilio rejects
# provisioning a number without a Bundle (and usually an Address) proving
# who the service provider is. Registered ONCE in the Twilio console —
# never per client — then referenced here so every provisioning call
# carries it.
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=
# The public origin Twilio's webhook signature was actually computed
# against — required in production. Behind nginx the app sees an
# internal host, so reconstructing the signed URL from the request alone
# produces a different string and every signature check fails silently.
# See lib/telephony/twilio-signature.ts.
TWILIO_WEBHOOK_BASE_URL=
# Full public URL of the TwiML voice webhook (.../api/webhooks/twilio/
# voice) — set on each pooled number at provisioning time (POST
# /api/admin/portal/recall/numbers), so a number is never live without a
# handler. A separate value from TWILIO_WEBHOOK_BASE_URL above (not
# derived from it in code) — keep them pointed at the same origin.
TWILIO_VOICE_WEBHOOK_URL=

# --- 'prospecting' (Prospección con IA) — Google Places API (New) ------------
# FALLBACK ONLY as of the /admin/portal/settings/integrations page — the
# key pasted there (encrypted in the DB, see lib/integration-credentials.ts)
# takes precedence. This plain env var is read only when no key has been
# saved through the portal yet.
#
# Places API (New) key — sent as the X-Goog-Api-Key header, never a
# query param, on every call in lib/google-places.ts. A DIFFERENT key
# from GOOGLE_OAUTH_CLIENT_ID/GOOGLE_BUSINESS_OAUTH_* above: those are
# OAuth client credentials for acting on a CLIENT's own Google account
# (reviews sync); this is a plain server-side API key for OUR OWN
# billed usage of Places, with no OAuth consent involved.
# UNVERIFIED AGAINST A REAL KEY — no credentials reachable from any
# environment this code has been built in. See lib/google-places.ts's
# header.
GOOGLE_PLACES_API_KEY=
