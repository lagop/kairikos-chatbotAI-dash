// =============================================================================
// Kairikos — Chatbot AI end-client portal (KAIA-752)
// Prisma schema for the Prisma + PostgreSQL 16 + Docker on VPS stack
// (plan rev 3, KAIA-719).
//
// Per-row isolation: every portal API route resolves clientId from
//   ChatbotClientUser.nextAuthEmail = session.user.email
// before any other query. No raw SQL — all reads go through Prisma
// `where: { clientId }` clauses. See prisma/README.md for the rule.
//
// Multi-tenant: KAIA-4258 — tenant isolation via profiles.tenant_id FK.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // KAIA-2858 — Vercel runtime is Amazon Linux 2 (RHEL-derived, glibc, openssl
  // 3.0.x), but `prisma generate` on the build host (Debian) defaults to
  // `debian-openssl-3.0.x`. The mismatch means every route that transitively
  // imports `@/lib/prisma` (e.g. `/portal`, `/api/auth/*`) blows up at
  // module-load time on Vercel with "Failed to load query engine" → HTTP 500,
  // while routes that never import prisma (`/portal/login`, `/api/health`)
  // keep working. Emit both binaries so the same generated client works in
  // the Docker / VPS build (debian) AND in Vercel serverless (rhel).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // KAIA-14409 — `prisma migrate deploy` cannot run DDL through the
  // transaction-mode PgBouncer pool (port 6543). It needs a direct
  // connection (port 5432). Vercel project already exposes `DIRECT_URL`
  // for production + preview targets; the build script added on
  // commit 3453364 runs `prisma migrate deploy` and reads this
  // env var through the schema's directUrl. Do not remove without
  // first re-routing the build script to a direct URL.
  //
  // KAIA-14440 — DIRECT_URL must be the Supabase *session-mode pooler*
  // (aws-0-<region>.pooler.supabase.com:5432), NOT db.<project-ref>.supabase.co:5432.
  // The db.<ref> host is IPv6-only; Vercel and most CI build containers are
  // IPv4-only, so pointing DIRECT_URL there makes every build-time migration
  // fail with "Network is unreachable" while still looking correctly
  // configured. The pooler host resolves to IPv4 and speaks session mode, so
  // it can hold the advisory locks DDL requires.
  directUrl = env("DIRECT_URL")
}

// One row per paying client. Source of truth for billing + onboarding state.
// Stripe remains the billing source of truth (stripeCustomerId is the link).
model ChatbotClient {
  id               String    @id @default(cuid())
  // NextAuth magic-link recipient. Unique — v1 has no shared inboxes.
  email            String    @unique
  name             String
  // Company name (free-form, may differ from the legal entity on Stripe).
  companyName      String?
  // Active subscription tier. Mirrors the value Stripe reports back via webhook.
  tier             String    @default("starter")
  // Stripe customer id (populated by the Stripe webhook handler in
  // kira-studio-billing-backend). NULL during the trial window.
  stripeCustomerId String?
  // Explicit onboarding-state column. KAIA-1062 self-service UI sets
  // this to 'go-live-pending' when the client clicks "I'm ready for
  // go-live" on the portal. The CTO flips it to 'live' and sets
  // `goLiveAt` in the same transaction. KAIA-1261 (BE-1 v1) extends
  // the allowlist with 'ready' and 'updating' for the wizard state
  // machine. WP-23 — this comment previously listed only 5 values;
  // ALLOWED_STATES in api/admin/portal/clients/[id]/route.ts also lets
  // the operator PATCH the column to 'pending' / 'paused' / 'cancelled'
  // by hand (account-lifecycle overrides, not wizard transitions), so
  // the real allowlist is 8. src/types/portal.ts's OnboardingStatus is
  // the single canonical type for all 8 — keep it in sync with this list.
  //   * 'in-progress'    — default; wizard in progress, not yet live
  //   * 'go-live-pending'— client requested go-live approval
  //   * 'ready'          — wizard v1: every mandatory step reached
  //                        'approved' for the first time. n8n listens
  //                        for the config_complete trigger at this edge.
  //   * 'live'           — operator approved go-live (goLiveAt also set)
  //   * 'updating'       — wizard v1: a step moved to needs_revision
  //                        (or a new draft was created) while the client
  //                        was 'live'. The bot keeps running on the last
  //                        approved version per step until the operator
  //                        approves the new one.
  //   * 'pending'        — operator override; account-lifecycle state,
  //                        not written by the wizard/self-service flows.
  //   * 'paused'         — operator override; account-lifecycle state.
  //   * 'cancelled'      — operator override; account-lifecycle state.
  state            String    @default("in-progress")
  // Set when the CTO marks the chatbot live in the operator flow.
  goLiveAt         DateTime?
  // KAIA-13281 — Operator-editable free-form notes. Mutated via
  // PATCH /api/admin/portal/clients/[clientId] by an operator session;
  // every write produces an OperatorAction audit row in the same
  // transaction.
  notes            String?
  // Supabase chatbot_clients.id (UUID). Populated by the backfill in KAIA-762
  // so the status-change watcher can resolve the Supabase UUID to the
  // portal's cuid without going through the email join path.
  supabaseClientId String?   @unique
  // KAIA-4258: tenant isolation FK. All client data is scoped to this tenant.
  // NULL during the migration window; the data backfill migration sets it
  // to the default tenant for any row that pre-dates this column.
  tenantId         String?   @map("tenant_id") @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities                ChatbotActivity[]
  conversations             ChatbotConversation[]
  users                     ChatbotClientUser[]
  operatorNotifications     OperatorNotification[]
  n8nExecutions             N8nExecution[]
  configSteps               ChatbotConfigStep[]
  intakeSubmissions         IntakeSubmission[]
  supportRequests           SupportRequest[]
  tenant                    Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  clientProducts            ClientProduct[]
  productAudits             ClientProductAudit[]
  subscriptions             Subscription[]
  invoices                  Invoice[]
  operatorActions           OperatorAction[]
  googleBusinessConnections GoogleBusinessConnection[]
  googleReviews             GoogleReview[]
  reviewRequestCampaigns    ReviewRequestCampaign[]
  webBrief                  WebBrief?
  webQuotes                 WebQuote[]
  chatWebEmbeds             ChatWebEmbed[]
  telegramConnections       TelegramConnection[]
  metaChannelConnections    MetaChannelConnection[]
  channelWebhookDeliveries  ChannelWebhookDelivery[]

  @@index([stripeCustomerId])
  @@index([tier])
  @@index([state])
  @@index([tenantId])
}

// =============================================================================
// KAIA-2913 — In-house intake submission (replaces Tally webhook ingestion).
//
// One row per accepted POST /api/public/intake. The endpoint:
//   1. validates the payload with the Zod schema in src/lib/intake-schema.ts
//   2. upserts a ChatbotClient + ChatbotClientUser pair (idempotency on email)
//   3. writes the IntakeSubmission row with the resolved client_id
//   4. triggers Drive folder creation + CTO notify-operator + Paperclip Day-2
//
// Idempotency: client supplies X-Idempotency-Key (or the server mints a
// UUIDv4 fallback). The route resolves to the existing row on retries and
// returns the same response payload — never duplicates the side effects.
// =============================================================================

model IntakeSubmission {
  id                String   @id @default(cuid())
  // Client-supplied or server-generated idempotency token. UNIQUE.
  idempotencyKey    String   @unique @map("idempotency_key")
  // 'public_intake' | future sources (csv_import, partner_api, ...). Free-form.
  source            String
  // Vertical tag derived from the `sector` field in the payload.
  vertical          String
  // Slug of the form spec this submission belongs to. Keeps the table
  // multi-form-friendly in case more intake funnels land later.
  intakeSlug        String   @map("intake_slug")
  // Full payload as JSONB so the admin portal can re-render the submission.
  payload           Json
  // FK to ChatbotClient. NULL during the brief window between row insert
  // and the client upsert completing in the same transaction.
  clientId          String?  @map("client_id")
  // KAIA-4258: tenant isolation FK. NULL for pre-multi-tenant rows; the
  // backfill migration sets it to the default tenant.
  tenantId          String?  @map("tenant_id") @db.Uuid
  // Denormalized for list/search views so the admin query doesn't have to
  // extract from JSONB on every page load.
  businessName      String   @map("business_name")
  humanHandoffEmail String   @map("human_handoff_email")
  ipHash            String?  @map("ip_hash")
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  client ChatbotClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([vertical])
  @@index([source])
  @@index([intakeSlug])
  @@index([businessName])
  @@index([humanHandoffEmail])
  @@index([clientId])
  @@index([tenantId])
}

// One row per operator notification fired (KAIA-1061). Drives the
// dedup logic in POST /api/internal/notify-operator and the future
// operator inbox view.
//
// Idempotency: the unique constraint on (clientId, kind, day) — where
// `day` is a YYYY-MM-DD UTC date — makes the route a true upsert.
// Repeated calls within the same UTC day collapse to a no-op. `clientId`
// is nullable so non-client-scoped events (e.g. a global n8n failure)
// can still be logged without violating the constraint.
model OperatorNotification {
  id              String         @id @default(cuid())
  clientId        String?
  // KAIA-4258: tenant isolation FK. NULL for non-client-scoped events
  // (e.g. a global n8n failure) and for pre-multi-tenant rows; the
  // backfill migration sets it from ChatbotClient.tenantId where known.
  tenantId        String?        @map("tenant_id") @db.Uuid
  // 'stuck' | 'execution-failed' | 'escalation'
  // | 'review-overdue-warning' | 'review-overdue-escalation'. Enforced
  // server-side in the route handlers — Postgres does not need a CHECK
  // constraint because no production code writes an unknown value.
  kind            String
  // Date the notification fired (YYYY-MM-DD). For stuck / execution-failed
  // / escalation this is the UTC date (stable across timezones); for
  // review-overdue-* the route computes it in the operator's timezone
  // (see `operator_day_in_tz` SQL function) so a Friday-evening review
  // in Madrid and a Monday-morning re-fire land on distinct days.
  day             String
  // Wizard step id (KAIA-1163 cuid) for review-overdue kinds. NULL for
  // the other three kinds. Carries the per-step dedup key.
  stepId          String?
  subject         String
  // JSON-as-string with the request body that fired the notification.
  context         String?
  // Resend message id, populated after a successful send.
  resendMessageId String?
  sentAt          DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  client          ChatbotClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([clientId, kind, day])
  @@index([day])
  @@index([resendMessageId])
  // KAIA-1177: per-step dedup lookup for review-overdue kinds. The
  // partial UNIQUE on (stepId, kind, day) lives in
  // 20260613124100_operator_notification_step_dedup/migration.sql
  // because Prisma does not natively model partial indexes; the @@index
  // here gives the route a fast lookup so the dedup check is one round
  // trip.
  @@index([stepId, kind, day])
  @@index([stepId])
  @@index([tenantId])
}

// =============================================================================
// WP-11 — Client help requests, persisted and manageable in the admin panel.
//
// Before this table, "Necesito ayuda" (POST /api/portal/operator with
// kind: 'help-request') only wrote its subject/message into
// OperatorNotification.context — a JSON-as-string blob keyed by
// (clientId, kind, day). A second help request from the same client on
// the same UTC day silently overwrote the first one's context (the route
// dedupes the EMAIL per day, which is correct — the operator shouldn't
// get spammed — but that dedup was also erasing the client's own
// message history, and there was no admin view to read past requests at
// all). This table is the durable, queryable record: one row per
// request, independent of the email dedup window, with a status the
// operator can move from 'open' to 'resolved' from the admin panel.
// =============================================================================
model SupportRequest {
  id       String  @id @default(cuid())
  clientId String  @map("client_id")
  // KAIA-4258: tenant isolation FK. NULL for pre-multi-tenant rows.
  tenantId String? @map("tenant_id") @db.Uuid

  subject String
  message String

  // 'open' | 'resolved'. Enforced server-side (route allowlist), not a
  // DB CHECK constraint — same convention as OperatorNotification.kind.
  status               String    @default("open")
  // Operator email/id who marked it resolved — free-form string, same
  // convention as OperatorAction.actorId (not a FK to Operator; v1 auth
  // reads the identity from the admin session, not a DB-enforced actor).
  resolvedByOperatorId String?   @map("resolved_by_operator_id")
  resolvedAt           DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([tenantId])
}

// =============================================================================
// KAIA-1107 — Per-operator identity (email + password + TOTP MFA).
// One row per operator who can access the admin portal. The password hash
// is argon2id (OWASP 2026 recommendation). The TOTP secret is encrypted at
// rest with a server-side key so a DB dump alone does not compromise MFA
// enrollment. Soft-deletion via isActive preserves the audit trail.
// =============================================================================

model Operator {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String
  // Encrypted TOTP secret (AES-256-GCM with OPERATOR_TOTP_ENCRYPTION_KEY).
  // NULL until the operator initiates TOTP enrollment.
  totpSecret     String?
  // NULL until the operator completes TOTP enrollment (verified a valid code).
  totpEnrolledAt DateTime?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  lastTotpAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions            OperatorSession[]
  recoveryCodes       OperatorRecoveryCode[]
  auditLogs           OperatorSettingsAudit[]
  approvedConfigSteps ChatbotConfigStep[]
  stripeCatalogAudits StripeCatalogAudit[]
  webQuotesCreated    WebQuote[]              @relation("WebQuoteCreatedBy")
  webQuotesSent       WebQuote[]              @relation("WebQuoteSentBy")
  webQuoteAudits      WebQuoteAudit[]
  invoicesMarkedPaid  Invoice[]

  @@index([email])
  @@index([isActive])
}

// Server-side session store. The session `id` IS the opaque session token,
// returned to the operator as an httpOnly secure cookie. Sessions have a
// 7-day absolute lifetime. Revoked sessions cannot be reused.
model OperatorSession {
  id             String    @id @default(uuid()) @db.Uuid
  operatorId     String    @db.Uuid
  // Set when the operator passes TOTP step-up. Mutations check this.
  totpVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  ip             String?
  userAgent      String?
  // Soft-revoke. When non-null the session is dead even if not yet expired.
  revokedAt      DateTime?

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([expiresAt])
}

// One-time recovery codes generated at TOTP enrollment. Stored as argon2id
// hashes. Shown to the operator exactly once at enrollment time; never
// retrievable afterwards. Each code can be consumed at most once.
model OperatorRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  operatorId String    @db.Uuid
  // argon2id hash of the recovery code — never stored in plaintext.
  codeHash   String
  // NULL until consumed; set to the timestamp of use.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

// =============================================================================
// KAIA-1073 — n8n execution capture for the operator flow-health dashboard.
// Every T+N workflow run (success or failure) is upserted here by the
// POST /api/internal/n8n-execution endpoint so the dashboard can surface
// the last n8n status per client without querying n8n directly.
//
// Upsert key: `id` (n8n's own execution id — stable across retried calls).
// Indexes: (clientId, startedAt desc) for per-client history; (status,
// startedAt desc) for the failure-listing dashboard panel.
// =============================================================================
model N8nExecution {
  id           String    @id
  clientId     String?
  // KAIA-4258: tenant isolation FK. NULL for non-client-scoped flows
  // (e.g. a global n8n failure) and for pre-multi-tenant rows.
  tenantId     String?   @map("tenant_id") @db.Uuid
  clientName   String?
  workflow     String
  milestone    String?
  status       String
  startedAt    DateTime
  finishedAt   DateTime?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime  @default(now())

  client ChatbotClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([tenantId])
}

// Maps a NextAuth session email to a ChatbotClient row. v1 is 1:1 — one
// nextAuthEmail per client. (Multi-tenant org switching is a v2 backlog item.)
model ChatbotClientUser {
  id            String        @id @default(cuid())
  clientId      String
  // NextAuth session email (the JWT subject). Unique — credentials login email.
  nextAuthEmail String        @unique
  // FK to User — the canonical identity row that holds the credential hash.
  // NULL for users who have not yet been linked (backfill completes this).
  userId        String?       @unique
  // KAIA-4258: tenant isolation FK, resolved via the linked Profile on insert.
  // NULL for pre-multi-tenant rows; the backfill migration sets it from
  // ChatbotClient.tenantId.
  tenantId      String?       @map("tenant_id") @db.Uuid
  client        ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([tenantId])
}

// =============================================================================
// KAIA-2103 — Unified user identity for credential-based auth.
// Stores role (client | operator), email, and the password hash.
// Both ChatbotClientUser and Operator link to User via userId.
// =============================================================================
model User {
  id            String    @id @default(cuid())
  // 'client' | 'operator'. Determines which auth provider accepts this user.
  role          String    @default("client")
  email         String    @unique
  // argon2id hash of the password. NULL until the user sets a password via
  // the setup-password flow. '__must_reset__' is the backfill marker for
  // existing ChatbotClientUser rows that had NULL passwordHash — these users
  // cannot authenticate until they complete setup-password.
  passwordHash  String?
  passwordSetAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chatbotClientUsers ChatbotClientUser[]
  profile            Profile?

  @@index([email])
  @@index([role])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: Tenant organizations
//
// One row per tenant organization. The tenant owns all client data.
// Feature flags stored as JSONB for per-tenant rollout (mirrors the
// Supabase supabase/migrations/20260724_tenant_isolation_v1.up.sql
// shape so the two databases stay aligned for the same logical entity).
// =============================================================================
model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  // 'active' | 'suspended' | 'cancelled'. Enforced server-side.
  status           String   @default("active")
  features         Json     @default("{}")
  // KAIA-4262 — Stripe Customer link. NULL until the portal (or owner
  // operator flow) creates the Customer and the Stripe webhook stores
  // the id back. UNIQUE so the same Stripe customer can only be
  // linked to one tenant.
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  profiles                  Profile[]
  chatbotClients            ChatbotClient[]
  chatbotClientUsers        ChatbotClientUser[]
  chatbotActivities         ChatbotActivity[]
  chatbotConversations      ChatbotConversation[]
  chatbotConfigSteps        ChatbotConfigStep[]
  chatbotConfigStepAudits   ChatbotConfigStepAudit[]
  intakeSubmissions         IntakeSubmission[]
  operatorNotifications     OperatorNotification[]
  supportRequests           SupportRequest[]
  n8nExecutions             N8nExecution[]
  clientProducts            ClientProduct[]
  productAudits             ClientProductAudit[]
  subscriptions             Subscription[]
  invoices                  Invoice[]
  googleBusinessConnections GoogleBusinessConnection[]
  googleReviews             GoogleReview[]
  reviewRequestCampaigns    ReviewRequestCampaign[]
  webBriefs                 WebBrief[]
  webQuotes                 WebQuote[]
  chatWebEmbeds             ChatWebEmbed[]
  telegramConnections       TelegramConnection[]
  metaChannelConnections    MetaChannelConnection[]

  @@index([slug])
  @@index([status])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: User profiles
//
// One row per linked User (1:1). Carries the tenant FK and the role that
// gates RLS-equivalent application-layer checks. The portal routes resolve
// `tenantId` from Profile via the session email; rows are created when a
// User is provisioned (the credentials signup flow creates User + Profile
// in the same transaction).
// =============================================================================
model Profile {
  id        String   @id @default(cuid())
  // FK to User — 1:1. UNIQUE so the canonical identity row is unambiguous.
  userId    String   @unique @map("user_id")
  tenantId  String   @map("tenant_id") @db.Uuid
  // 'owner' | 'admin' | 'viewer'. Enforced server-side. Owner sees all
  // tenant data; admin can mutate; viewer is read-only.
  role      String   @default("viewer")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([role])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: Service products (tiers)
//
// Kairikos service tiers. Source of truth is Stripe, but we store metadata
// here for portal display and feature-gating. Mirrors the shape of the
// Supabase products table so the same Stripe webhook can write both.
//
// WP-12 — this used to be "one row per chatbot tier" (`tier` was
// @unique). Kairikos sells five products (chatbot, web platform, AI lead
// capture, SEO, Google reviews), not one, so `tier` is now unique only
// WITHIN a product's `code` (@@unique([code, tier])) — two different
// products can each have their own 'standard'/'pro' tier without
// colliding. The price model also changed: `priceCents` is the monthly
// fee (0 for one-time-only products like the web platform) and
// `setupFeeCents` is the one-time onboarding fee. Billing type is
// derived from the two rather than stored as a third field: fee=0 +
// setup>0 is one-time, both>0 is setup-plus-subscription. See
// prisma/migrations/*_product_multi_service for the backfill.
// =============================================================================
model Product {
  id                     String   @id @default(uuid()) @db.Uuid
  // 'chatbot' | 'web' | 'captacion' | 'seo' | 'resenas'. Free-form so a
  // sixth product doesn't need a schema migration.
  code                   String
  // The Stripe Product these two Price ids below belong to. NULL until
  // an operator bootstraps this tier from /admin/portal/settings/billing
  // (src/lib/stripe-catalog.ts) — needed so a later reprice creates the
  // new Price under the SAME Stripe Product instead of a duplicate one.
  stripeProductId        String?  @map("stripe_product_id")
  // Stripe recurring-price id for the monthly fee (populated by the
  // Stripe webhook handler). NULL for unsynced/grandfathered rows or
  // products with no subscription component.
  stripeRecurringPriceId String?  @unique @map("stripe_recurring_price_id")
  // Stripe one-time-price id for the setup fee. NULL when setupFeeCents
  // is 0, or when the fee hasn't been provisioned on Stripe yet.
  stripeSetupPriceId     String?  @map("stripe_setup_price_id")
  // 'test' | 'live' | NULL — which Stripe mode stripeProductId/
  // stripeRecurringPriceId/stripeSetupPriceId were created under. There
  // is no reliable, documented way to infer test-vs-live from a Stripe
  // id's shape alone, so this is tracked explicitly at bootstrap/reprice
  // time. Used to warn an operator in the UI when this tier's Price
  // objects were created in a different mode than the one currently
  // active (see StripeOperatorCredential.activeMode) — a checkout
  // against a mismatched mode fails with a Stripe "resource_missing"
  // error, since Price ids are scoped to a single mode.
  stripePriceMode        String?  @map("stripe_price_mode")
  name                   String
  // 'starter' | 'pro' | 'premium' for chatbot; 'standard' for the
  // single-tier products. Unique per `code`, not globally.
  tier                   String
  priceCents             Int      @map("price_cents")
  setupFeeCents          Int      @default(0) @map("setup_fee_cents")
  currency               String   @default("EUR")
  features               Json     @default("{}")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")

  clientProducts ClientProduct[]
  auditLogs      ClientProductAudit[]
  catalogAudits  StripeCatalogAudit[]

  @@unique([code, tier])
  @@index([code])
  @@index([tier])
  @@index([isActive])
}

// Immutable audit trail for product assignment and lifecycle changes.
model ClientProductAudit {
  id              String   @id @default(uuid()) @db.Uuid
  clientProductId String   @map("client_product_id") @db.Uuid
  clientId        String   @map("client_id")
  productId       String   @map("product_id") @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  action          String
  statusBefore    String?  @map("status_before")
  statusAfter     String?  @map("status_after")
  actorId         String   @map("actor_id")
  changedAt       DateTime @default(now()) @map("changed_at")

  clientProduct ClientProduct @relation(fields: [clientProductId], references: [id], onDelete: Restrict)
  client        ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientProductId, changedAt])
  @@index([clientId, changedAt])
  @@index([tenantId])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: Client-Product many-to-many join

//
// Associates chatbot clients with their subscribed products. Stripe stores
// the subscription itself; this row is the portal/Supabase denormalization
// for owner views and feature gating. UNIQUE (clientId, productId) so a
// client cannot have two rows for the same tier — reactivation goes
// through UPDATE on the existing row, not a fresh INSERT.
// =============================================================================
model ClientProduct {
  id              String    @id @default(uuid()) @db.Uuid
  clientId        String    @map("client_id")
  productId       String    @map("product_id") @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  // 'pending_payment' | 'active' | 'paused' | 'cancelled' | 'past_due' |
  // 'quote_pending'. The last one is 'web'-specific (WP-XX): covers the
  // ENTIRE pre-payment stretch of the custom-quote flow — from the
  // client's free request through the operator's quote, the client's
  // acceptance, and the resulting invoice — until it's paid, at which
  // point this flips straight to 'active' (see
  // activateClientProductFromWebQuotePayment in stripe-billing.ts).
  // WebQuote.status carries the fine-grained state within this one
  // coarse value, same relationship 'pending_payment' already has to
  // the plain self-serve Stripe Checkout flow.
  status          String    @default("active")
  subscribedAt    DateTime  @default(now()) @map("subscribed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdBy       String?   @map("created_by")
  changedBy       String?   @map("changed_by")
  changedAt       DateTime  @default(now()) @map("changed_at")
  // WP-14 — per-product onboarding lifecycle. `status` above is the
  // Stripe-mirroring billing state (active/cancelled/past_due);
  // `onboardingState` is a different axis entirely — where THIS
  // product's wizard/onboarding sits, using the same vocabulary as
  // ChatbotClient.state / types/portal.ts's OnboardingStatus. This
  // column is now the source of truth for onboarding lifecycle;
  // ChatbotClient.state is kept as a mirror of the chatbot product's
  // onboardingState (n8n still reads it — see the migration's COMPAT
  // note) rather than removed.
  onboardingState String    @default("in-progress") @map("onboarding_state")
  goLiveAt        DateTime? @map("go_live_at")

  client       ChatbotClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  tenant       Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  auditLogs    ClientProductAudit[]
  subscription Subscription?
  // WP-19 — one-time-purchase products (no recurring price) invoice
  // directly against the ClientProduct instead of through a Subscription
  // — see Invoice.clientProductId.
  invoices     Invoice[]
  webQuote     WebQuote?

  @@unique([clientId, productId])
  @@index([clientId])
  @@index([productId])
  @@index([status])
  @@index([tenantId])
}

// =============================================================================
// KAIA-4262 — Stripe Subscription state mirror (per ClientProduct)
//
// One row per Stripe Subscription. Stripe is the source of truth — this
// row is the portal/Supabase denormalization for the owner billing UI,
// the client billing page, and the MRR aggregation.
//
// Idempotency: stripe_id is UNIQUE so the webhook upsert is naturally
// idempotent even if the StripeWebhookEvent idempotency row is missing.
// 1:1 with ClientProduct so each product-tier subscription per client
// maps to exactly one ClientProduct row.
// =============================================================================
model Subscription {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  clientId           String    @map("client_id")
  clientProductId    String    @unique @map("client_product_id") @db.Uuid
  // Stripe identifiers — stripe_id is the business key.
  stripeId           String    @unique @map("stripe_id")
  stripeCustomerId   String    @map("stripe_customer_id")
  stripePriceId      String?   @map("stripe_price_id")
  // 'incomplete' | 'trialing' | 'active' | 'past_due' | 'canceled' |
  // 'unpaid' | 'incomplete_expired' | 'paused'. Mirrors Stripe's enum.
  status             String    @default("incomplete")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")
  // Currency minor units (9900 = 99€).
  amountCents        Int?      @map("amount_cents")
  currency           String    @default("eur")
  // Latest Stripe subscription snapshot. NOT source of truth.
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client        ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientProduct ClientProduct @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([stripeCustomerId])
}

// =============================================================================
// KAIA-4262 — Stripe Invoice state mirror (per Subscription or, since
// WP-19, per one-time-purchase ClientProduct)
//
// One row per Stripe Invoice. Used by the client billing page (latest
// invoice + PDF link) and by the owner MRR aggregation. host_invoice_url
// is what the portal sends the user to for the Stripe-hosted view;
// invoice_pdf_url is the direct PDF download.
//
// WP-19 — subscriptionId is now nullable and clientProductId was added.
// A product with no recurring price (e.g. the one-time web platform
// purchase) never gets a Subscription row at all — its Invoice links
// straight to the ClientProduct instead. Exactly one of
// subscriptionId / clientProductId is set per row; which one tells you
// whether this invoice came from the recurring or the one-time path.
// Pre-WP-19 rows are all subscription-linked (clientProductId stays
// NULL for them — no backfill needed, the FK is purely additive).
//
// Idempotency: stripe_id is UNIQUE so webhook retries collapse to a
// no-op upsert.
// =============================================================================
model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  clientId        String    @map("client_id")
  subscriptionId  String?   @map("subscription_id") @db.Uuid
  clientProductId String?   @map("client_product_id") @db.Uuid
  stripeId        String    @unique @map("stripe_id")
  // 'draft' | 'open' | 'paid' | 'uncollectible' | 'void'. 'void' is set
  // via voidWebQuoteInvoice() (stripe.invoices.voidInvoice) — see
  // canVoidInvoice in web-quotes.ts for when that's allowed.
  status          String    @default("draft")
  number          String?
  // 'full' | 'deposit' | 'final' | null. Set from the Stripe invoice's
  // kairikos_invoice_role metadata by syncInvoiceFromStripe — denormalized
  // here so the UI never has to inspect Stripe metadata to know whether an
  // Invoice is a WebQuote's single full payment, its deposit, or its final
  // balance. Null for invoices unrelated to a WebQuote.
  invoiceRole     String?   @map("invoice_role")
  amountDueCents  Int       @default(0) @map("amount_due_cents")
  amountPaidCents Int       @default(0) @map("amount_paid_cents")
  currency        String    @default("eur")
  issuedAt        DateTime? @map("issued_at")
  dueAt           DateTime? @map("due_at")
  paidAt          DateTime? @map("paid_at")
  periodStart     DateTime? @map("period_start")
  periodEnd       DateTime? @map("period_end")
  hostInvoiceUrl  String?   @map("host_invoice_url")
  invoicePdfUrl   String?   @map("invoice_pdf_url")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // WP-XX — manual (offline) payment tracking for web-quote invoices.
  // CRITICAL: syncInvoiceFromStripe() must NEVER write to these 5
  // columns, in either its `create` or `update` — Stripe has no concept
  // of "channel", only the read-only `paid_out_of_band` boolean it
  // returns on the Invoice object, which we separately store here to
  // remember whether a payment was manual. If a future sync change ever
  // includes these fields, it silently erases the audit trail of who
  // marked a payment manually and how (transfer vs cash, reference
  // number) — there is deliberately only ONE code path that writes them:
  // markInvoicePaidManually() in stripe-billing.ts.
  paymentChannel         String?   @map("payment_channel")
  paymentReference       String?   @map("payment_reference")
  paidOutOfBand          Boolean   @default(false) @map("paid_out_of_band")
  markedPaidByOperatorId String?   @map("marked_paid_by_operator_id") @db.Uuid
  markedPaidAt           DateTime? @map("marked_paid_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client        ChatbotClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  clientProduct ClientProduct? @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  markedPaidBy  Operator?      @relation(fields: [markedPaidByOperatorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clientId])
  @@index([subscriptionId])
  @@index([clientProductId])
  @@index([status])
}

// =============================================================================
// KAIA-4262 — Stripe webhook event idempotency log
//
// Primary key = Stripe event id. Inserted before any state mutation so
// a redelivery of the same event id short-circuits. payload_hash guards
// against the (rare) case where Stripe re-delivers an event id with a
// mutated body — we still no-op on the second delivery.
// =============================================================================
model StripeWebhookEvent {
  eventId          String    @id @map("event_id")
  eventType        String    @map("event_type")
  payloadHash      String    @map("payload_hash")
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  // 'pending' | 'processed' | 'failed'. failed means the handler
  // threw; we keep the row so retry deliveries are still no-ops.
  status           String    @default("pending")
  errorMessage     String?   @map("error_message")
  // 'subscription' | 'invoice' | 'ignored' — what the event mutated.
  appliedTo        String?   @map("applied_to")
  stripeApiVersion String?   @map("stripe_api_version")

  @@index([status])
  @@index([receivedAt])
}

// =============================================================================
// KAIA-2103 — Password reset tokens for client portal users.
// Supports forgot-password + reset-password flow via time-limited tokens.
// Tokens are single-use; once consumed they cannot be reused.
// =============================================================================
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
}

// One row per T+N event the n8n flow emits (T+0, T+3, T+7, T+14, …).
// Drives the portal onboarding timeline.
//
// Idempotency: the unique constraint on (clientId, milestone) makes the
// portal's POST /api/internal/activity endpoint a true upsert. n8n flows
// can re-run freely; the second write collapses to a no-op. The
// (clientId, milestone) pair is the natural business key — there is at
// most one row per T+N milestone per client.
model ChatbotActivity {
  id          String        @id @default(cuid())
  clientId    String
  // KAIA-4258: tenant isolation FK (denormalized from ChatbotClient for query
  // plans that filter by tenant_id directly without a join). NULL for
  // pre-multi-tenant rows; the backfill migration sets it from
  // ChatbotClient.tenantId.
  tenantId    String?       @map("tenant_id") @db.Uuid
  // WP-14 — which product's onboarding this milestone belongs to. Was
  // implicitly "the chatbot's" (the unique key was (clientId, milestone),
  // so a client could only ever have one "T+0" total). Defaults to
  // 'chatbot' at the DB level for the same reason ChatbotConfigStep's
  // productCode does — see that column's comment.
  productCode String        @default("chatbot")
  // T+N milestone label — "T+0", "T+3", "T+7", "T+14" by convention; free-form
  // string so n8n can extend without a schema migration. Enforced allowlist
  // lives in the route handler at src/app/api/internal/activity/route.ts.
  milestone   String
  // NULL when the row is created up-front (e.g. the schedule); set when the
  // event actually fires.
  completedAt DateTime?
  notes       String?
  client      ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([clientId, productCode, milestone])
  @@index([clientId, completedAt])
  @@index([clientId, productCode])
  @@index([tenantId])
}

// One row per chatbot conversation. Read-only on the portal in v1
// (writes come from the chatbot platform via n8n).
model ChatbotConversation {
  id         String        @id @default(cuid())
  clientId   String
  // KAIA-4258: tenant isolation FK (denormalized from ChatbotClient for
  // query plans that filter by tenant_id directly). NULL for
  // pre-multi-tenant rows; the backfill migration sets it.
  tenantId   String?       @map("tenant_id") @db.Uuid
  startedAt  DateTime
  // Duration in seconds. NULL while the conversation is still open.
  duration   Int?
  // Outcome / resolution status. Free-form string so the chatbot platform
  // can extend without a schema migration. Conventional values:
  //   resolved | escalated | abandoned | fallback | unknown
  outcome    String?
  // Full transcript as JSON — message list, metadata, tool calls, etc.
  transcript Json?
  client     ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId, startedAt])
  @@index([clientId, outcome])
  @@index([tenantId])
}

// =============================================================================
// KAIA-1163 — Wizard configuration step. One row per (client, stepKey, version).
// The wizard creates version=1 on first save; subsequent edits increment version.
// The bot always reads the row where activeForBot=true for a given (clientId,
// stepKey). The operator approves a version, which sets activeForBot=true on the
// new version and false on the previous one.
//
// Status lifecycle (enforced server-side):
//   draft → submitted → approved  (forward)
//         → needs_revision ←       (operator can flip back)
//
// KAIA-1261 (BE-1 v1) extends this with:
//   * `revisionComment` — denormalized latest operator reason when the step
//     was sent to needs_revision. The audit table remains the source of
//     truth for history; this column makes the portal GET a single round
//     trip. Added in
//     20260615010000_chatbot_config_step_v1_addendum/migration.sql.
//   * A DB-level partial UNIQUE constraint on (clientId, stepKey) WHERE
//     activeForBot = true. Prisma cannot model partial uniques natively,
//     so the @@index below is a planning hint and the actual constraint
//     lives in raw SQL. The bot config loader relies on this invariant;
//     duplicate actives are a 23505 unique_violation in the API layer.
// =============================================================================

model ChatbotConfigStep {
  id                   String    @id @default(cuid())
  clientId             String
  // KAIA-4258: tenant isolation FK (denormalized from ChatbotClient for
  // query plans that filter by tenant_id directly). NULL for
  // pre-multi-tenant rows; the backfill migration sets it.
  tenantId             String?   @map("tenant_id") @db.Uuid
  // WP-13 — which Kairikos product this step belongs to: 'chatbot' |
  // 'web' | 'captacion' | 'seo' | 'resenas' (matches Product.code). The
  // DB keeps a DEFAULT so a write that forgets to pass it lands on the
  // right product instead of failing outright — but application code
  // never relies on that default: every wizard-client.ts /
  // wizard-tier-prisma.ts function takes productCode as a required
  // parameter (no default value), so the compiler flags every call
  // site. Today every real caller passes 'chatbot' — the wizard UI has
  // no multi-product routing yet (that's WP-16) — but the (clientId,
  // productCode, stepKey, version) key below is already correct for
  // when it does.
  productCode          String    @default("chatbot")
  // Step identifier: "1" through "12" (Steps 1-10 + 11 Pruebas + 12 Integraciones).
  // Enforced server-side via a per-step Zod schema registry.
  stepKey              String
  // Monotonically increasing per (clientId, stepKey). Starts at 1.
  version              Int       @default(1)
  // 'draft' | 'submitted' | 'approved' | 'needs_revision'. Enforced server-side.
  status               String    @default("draft")
  // Opaque JSON blob — the wizard stores the step's form fields here as a flat
  // JSON object. v1: plaintext values. v1.1: ciphertext + envelope metadata.
  // Prisma maps Json to PostgreSQL JSONB.
  payload              Json?
  // Set when the client clicks "Submit for review" on this step.
  submittedAt          DateTime?
  // Set when the operator approves this version.
  approvedAt           DateTime?
  // Operator who approved this version (FK to Operator, nullable until approved).
  approvedByOperatorId String?   @db.Uuid
  // Exactly one row per (clientId, productCode, stepKey) has
  // activeForBot=true at any time. The bot's config-loader reads the
  // active version when constructing prompts. The DB-level invariant is
  // enforced by a partial UNIQUE index — see
  // 20260615010000_chatbot_config_step_v1_addendum/migration.sql
  // (originally (clientId, stepKey); repointed to include productCode by
  // 20260814100000_config_step_product_scope/migration.sql). Prisma
  // cannot model partial uniques natively, so the @@index below is a
  // query planning hint and the actual constraint lives in raw SQL.
  activeForBot         Boolean   @default(false)
  // Latest operator reason when the step was sent to needs_revision
  // (KAIA-1261 / BE-1 v1). Denormalized from the most recent
  // ChatbotConfigStepAudit row with action=request_revision so the
  // portal GET can render the operator's note in a single round trip.
  // The audit table remains the source of truth for history.
  revisionComment      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client     ChatbotClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  approvedBy Operator?                @relation(fields: [approvedByOperatorId], references: [id], onDelete: SetNull)
  tenant     Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  auditLogs  ChatbotConfigStepAudit[]

  @@unique([clientId, productCode, stepKey, version])
  @@index([clientId, stepKey])
  @@index([clientId, stepKey, activeForBot])
  @@index([clientId, productCode, stepKey])
  @@index([clientId, status])
  @@index([tenantId])
}

// Immutable (append-only) audit log for ChatbotConfigStep changes.
// Enforced at the application layer: the wizard API only exposes create
// (insert-only via the PATCH route handler). One row per discrete event:
// edit, submit, approve, request_revision, activate, deactivate.
model ChatbotConfigStepAudit {
  id        String   @id @default(cuid())
  stepId    String
  // KAIA-4258: tenant isolation FK (denormalized from the parent
  // ChatbotConfigStep so audit-list queries can filter by tenant_id
  // without joining the config step). NULL for pre-multi-tenant rows;
  // the backfill migration sets it.
  tenantId  String?  @map("tenant_id") @db.Uuid
  // Denormalized version at the time of the event so the audit trail is
  // meaningful even if versions are later cleaned up.
  version   Int
  // 'client' | 'operator' | 'system'. Enforced server-side.
  actor     String
  // Email or operator UUID — whichever identifies the actor. Null for 'system' events.
  actorId   String?
  // 'edit' | 'submit' | 'approve' | 'request_revision' | 'activate' | 'deactivate'.
  // Enforced server-side.
  action    String
  // Optional free-text reason (operator's review note, system trigger name, etc.).
  comment   String?
  createdAt DateTime @default(now())

  step   ChatbotConfigStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  tenant Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([stepId])
  @@index([stepId, createdAt])
  @@index([actor])
  @@index([action])
  @@index([tenantId])
}

// =============================================================================
// KAIA-1106 — Tool-integration settings. One row per external tool/service
// that the Kairikos operator portal integrates with (Resend, n8n, Supabase,
// Stripe, etc.). Stores the *reference* to where the secret lives (1Password)
// and operational metadata (last rotation, health status) but NEVER the
// secret value itself — those live in 1Password (CEO decision, KAIA-1058).
//
// API read/write: KAIA-1084  |  Rotate worker: KAIA-1083
// Health probes:  KAIA-1085  |  Frontend:      KAIA-1086
// =============================================================================
model OperatorSettings {
  id                   String    @id @default(uuid()) @db.Uuid
  // Stable identifier used in code and API routes. Never changes after creation.
  // Known values: 'resend', 'n8n', 'supabase', 'portal_api_key', 'postgres_password'
  toolKey              String    @unique
  // Human label shown in the settings UI (e.g. "Resend", "n8n", "Supabase").
  displayName          String
  // Category for dashboard grouping: 'email' | 'workflow' | 'database' | 'auth' | 'billing' | 'other'
  category             String
  // The env var that holds the secret value (nullable — some tools don't use one).
  envVarName           String?
  // 1Password reference path: op://Vault/Item/Field. Never the actual secret value.
  secretManagerRef     String
  // Last successful rotation timestamp (set by the rotate worker, KAIA-1083).
  lastRotatedAt        DateTime?
  // Last health-check timestamp (set by the health probe worker, KAIA-1085).
  lastHealthCheckAt    DateTime?
  // Most recent health status: 'healthy' | 'degraded' | 'failed' | 'unknown'
  lastHealthStatus     String    @default("unknown")
  // Days after which a rotation reminder badge appears (default 90).
  rotationReminderDays Int       @default(90)
  // Free-text notes from the operator.
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  auditLogs OperatorSettingsAudit[]

  @@index([category])
  @@index([lastHealthStatus, lastHealthCheckAt])
}

// Immutable (append-only) audit log for OperatorSettings changes.
// Enforced at the application layer: the helper module in
// src/lib/operator-settings.ts only exposes create — never update or delete.
// One row per discrete event: creation, field update, rotation request,
// rotation result, health status change, or deletion.
model OperatorSettingsAudit {
  id              String   @id @default(uuid()) @db.Uuid
  settingsId      String   @db.Uuid
  // FK to the future Operator identity model (KAIA-1082).
  // Nullable until KAIA-1082 lands; after that, this becomes required.
  actorOperatorId String?  @db.Uuid
  // Denormalized at write-time so the audit trail is meaningful even if
  // the operator is later removed from the DB.
  actorEmail      String?
  // Event type: 'created' | 'updated' | 'rotation_requested' | 'rotation_succeeded'
  // | 'rotation_failed' | 'health_status_changed' | 'deleted'
  action          String
  // Row snapshot before the change (omit secret values — only schema refs).
  before          Json?
  // Row snapshot after the change.
  after           Json?
  // Free-form metadata: request_id, user_agent, IP, TOTP-verified flag, etc.
  metadata        Json?
  createdAt       DateTime @default(now())

  operatorSettings OperatorSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  operator         Operator?        @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([settingsId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// KAIA-13281 — Operator action audit log for the admin editor mode.
//
// One row per field-level change an operator makes to a ChatbotClient via
// PATCH /api/admin/portal/clients/[clientId]. The route handler writes
// the ChatbotClient update + one OperatorAction row per changed field in
// a single Prisma `$transaction` so the audit trail and the live data
// cannot drift.
//
// Append-only at the application layer: the route only ever issues
// INSERT against this table (same enforcement pattern as
// ChatbotConfigStepAudit and OperatorSettingsAudit).
//
// actorId is the operator's email (or user id when the future
// Operator identity model becomes required). actorType defaults to
// 'operator' so future non-operator actors (e.g. system reaper) can be
// tagged without a schema migration.
// =============================================================================

model OperatorAction {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  // 'operator' (default). Free-form so future actor kinds can land
  // without a migration; enforced at the route layer.
  actorType   String   @default("operator") @map("actor_type")
  // Operator email or user id. Free-form string — v1 reads from the
  // NextAuth session; once Operator identity is required (KAIA-1082),
  // this should switch to a FK to Operator.id.
  actorId     String   @map("actor_id")
  // Field name that changed (one of the route allowlist). Enforced
  // server-side; not DB-constrained so future field names can land
  // without a migration.
  field       String
  beforeValue String?  @map("before_value")
  afterValue  String?  @map("after_value")
  createdAt   DateTime @default(now()) @map("created_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([field])
}

// =============================================================================
// NextAuth.js v5 (KAIA-753) — required by @auth/prisma-adapter.
// We run with JWT session strategy (no DB-backed sessions), so the Session
// model is unused at runtime, but the adapter still requires the model to
// exist in the schema. The VerificationToken model is the hot path for the
// Resend magic-link provider: one row per email send, deleted on click.
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// WP-21 — a client's own Google Business Profile, connected via OAuth so
// WP-22 can sync/reply to reviews on their behalf. Deliberately separate
// from the GOOGLE_OAUTH_CLIENT_ID/SECRET used by lib/google-drive.ts
// (KAIA-2913): that integration authorizes Kairikos's OWN Google account
// for internal Drive provisioning with one static refresh token; this one
// authorizes each CLIENT's Google account, one row per connected
// location, via its own OAuth client (scope: business.manage) so the two
// consent screens and credential sets never mix.
//
// The refresh token is the highest-value secret this schema stores after
// Stripe's own credentials — it grants ongoing API access to the client's
// real Google Business listing. It is never stored as plaintext or as a
// single opaque string: ciphertext/iv/tag are separate Bytes columns,
// encrypted with AES-256-GCM via the generic encryptBuffer/decryptBuffer
// primitives in lib/operator-crypto.ts (a DIFFERENT key,
// GOOGLE_TOKEN_ENCRYPTION_KEY, from the one guarding operator TOTP
// secrets — different secret classes should never share key material).
//
// `status`: 'active' | 'needs_reconnect' (refresh failed — Google
// revoked/expired it; surfaced in the portal as a degraded state with a
// reconnect prompt) | 'revoked' (the client disconnected from Kairikos's
// side; the row is kept, not hard-deleted, so sync history and the
// disconnect itself stay auditable).
model GoogleBusinessConnection {
  id                          String    @id @default(uuid()) @db.Uuid
  clientId                    String    @map("client_id")
  tenantId                    String    @map("tenant_id") @db.Uuid
  googleAccountId             String    @map("google_account_id")
  locationId                  String    @map("location_id")
  locationName                String    @map("location_name")
  refreshTokenCiphertext      Bytes     @map("refresh_token_ciphertext")
  refreshTokenIv              Bytes     @map("refresh_token_iv")
  refreshTokenTag             Bytes     @map("refresh_token_tag")
  scopes                      String[]
  status                      String    @default("active")
  connectedAt                 DateTime  @default(now()) @map("connected_at")
  lastSyncAt                  DateTime? @map("last_sync_at")
  lastSyncError               String?   @map("last_sync_error")
  // WP-22b — Google's own "leave a review" link for this location
  // (Business Information API's Location.metadata.newReviewUri).
  // Fetched lazily on first campaign creation and cached here — it does
  // not change for a given location, so there is no reason to re-fetch
  // it on every campaign.
  reviewUrl                   String?   @map("review_url")
  // WP-22c — when true, google-review-sync.ts publishes an AI-drafted
  // reply to a newly-synced review with no reply yet, with no human
  // approval step. Off by default (the AC's "salvo que el cliente
  // active lo contrario") — this pair of columns IS the audit trail the
  // AC requires ("queda auditado con quién y cuándo lo cambió"): who
  // last flipped the setting and when, not a full change history table,
  // which is more than a single boolean toggle needs.
  autoPublishReplies          Boolean   @default(false) @map("auto_publish_replies")
  autoPublishRepliesChangedBy String?   @map("auto_publish_replies_changed_by")
  autoPublishRepliesChangedAt DateTime? @map("auto_publish_replies_changed_at")

  client    ChatbotClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reviews   GoogleReview[]
  campaigns ReviewRequestCampaign[]

  @@unique([clientId, locationId])
  @@index([tenantId])
  @@index([status])
}

// =============================================================================
// WP-22a — one row per review synced from a client's connected Google
// Business Profile location (GoogleBusinessConnection, WP-21).
//
// `googleReviewId` stores the review's full Google resource name
// ("accounts/.../locations/.../reviews/...") rather than the bare
// reviewId — the resource name is guaranteed globally unique the same
// way GoogleBusinessConnection's locationId already is, whereas a bare
// reviewId's uniqueness scope is not documented by Google. It is the
// idempotency key: syncReviewsForConnection always upserts on it, so a
// retried or overlapping sync run can never create a duplicate row.
model GoogleReview {
  id             String    @id @default(uuid()) @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  clientId       String    @map("client_id")
  tenantId       String    @map("tenant_id") @db.Uuid
  googleReviewId String    @unique @map("google_review_id")
  reviewerName   String?   @map("reviewer_name")
  // 1-5. Google's API returns an enum string (ONE..FIVE) — mapped to an
  // int at the sync boundary (see google-review-sync.ts) so every
  // consumer downstream (sorting, averages) works with a plain number.
  starRating     Int       @map("star_rating")
  comment        String?
  createTime     DateTime  @map("create_time")
  updateTime     DateTime  @map("update_time")
  // The PUBLISHED reply, as last synced FROM Google — read-only,
  // written only by google-review-sync.ts.
  replyComment   String?   @map("reply_comment")
  replyUpdatedAt DateTime? @map("reply_updated_at")
  syncedAt       DateTime  @default(now()) @map("synced_at")

  // WP-22c — an AI-generated reply the client hasn't published yet.
  // Deliberately separate from replyComment/replyUpdatedAt above: those
  // two only ever reflect what Google reports as actually live. A draft
  // here is not published anywhere until the publish route sends it and
  // stamps replyPublishedAt.
  aiDraftReply       String?   @map("ai_draft_reply")
  aiDraftGeneratedAt DateTime? @map("ai_draft_generated_at")
  // 'client:<clientId>' for a human approval, 'auto' when
  // autoPublishReplies published it without a human in the loop — the
  // AC's "si fue auto-publicada" audit trail.
  replyApprovedBy    String?   @map("reply_approved_by")
  replyApprovedAt    DateTime? @map("reply_approved_at")
  replyPublishedAt   DateTime? @map("reply_published_at")

  connection GoogleBusinessConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  client     ChatbotClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([connectionId])
  @@index([clientId])
  @@index([starRating])
}

// =============================================================================
// WP-22b — a batch of review-request invitations for one connected
// location. AC: "la misma invitación se envía a todos los clientes por
// igual" — there is deliberately no field anywhere on these two models
// for a customer's satisfaction/experience rating. Review gating (asking
// first, routing only happy customers to the public review link)
// violates Google's policies; nothing in this schema makes it
// expressible.
model ReviewRequestCampaign {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  clientId     String   @map("client_id")
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  // 'active' | 'paused'.
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  connection GoogleBusinessConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  client     ChatbotClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requests   ReviewRequest[]

  @@index([clientId])
  @@index([connectionId])
}

// One row per invited recipient. `channel` is a free string so a future
// 'sms' implementation needs no schema change — WP-22b only implements
// 'email' (this codebase has no SMS provider integrated anywhere yet).
model ReviewRequest {
  id              String    @id @default(uuid()) @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  channel         String    @default("email")
  recipient       String
  recipientName   String?   @map("recipient_name")
  // Legal basis for contacting this recipient — set once per campaign,
  // applied uniformly to every request in it (same "no per-recipient
  // discrimination" principle as the review-gating constraint above).
  consentBasis    String    @map("consent_basis")
  // 'pending' | 'sent' | 'failed'. A retry (see
  // review-request-campaign.ts's retryFailedRequests) only ever touches
  // 'failed' rows — an already-'sent' request is never re-sent.
  status          String    @default("pending")
  resendMessageId String?   @map("resend_message_id")
  sendError       String?   @map("send_error")
  sentAt          DateTime? @map("sent_at")
  // Set the first time GET /r/[requestId] is visited — the AC's
  // "conversion rate" measure. Never records anything about the review
  // itself, only that the link was opened.
  clickedAt       DateTime? @map("clicked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  campaign ReviewRequestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipient])
  @@index([campaignId])
  @@index([status])
}

// =============================================================================
// Web brief — the 'web' product's own, standalone intake form. Deliberately
// NOT built on the chatbot's wizard engine (ChatbotConfigStep +
// wizard-visibility.ts's tier-aware step catalog): that machinery is
// hardcoded to chatbot in ~22 call sites across API routes and lib
// functions, and generalizing it for every product is its own large,
// higher-risk refactor of a system already in production. Web is also a
// fundamentally different shape of product — a one-time delivery (799€
// setup fee, no recurring price — see the 'web' Product row), not an
// ongoing service the client reconfigures — so a single-shot brief fits
// better than a multi-step, tier-aware, per-step-audited wizard anyway.
//
// One brief per client — a second website would be a new purchase cycle,
// handled manually, not modeled here.
// =============================================================================
model WebBrief {
  id       String  @id @default(cuid())
  clientId String  @unique @map("client_id")
  tenantId String? @map("tenant_id") @db.Uuid

  // 'draft' | 'submitted'. Resubmitting after 'submitted' is allowed
  // (upsert, no hard server-side lock) — the client can always send
  // Kairikos their latest answers; the portal UI just shows a read-only
  // summary instead of the form once submitted, with an explicit
  // "editar respuestas" action to reopen it.
  status String @default("draft")

  businessName   String? @map("business_name")
  vertical       String?
  // Objetivo principal del sitio: 'vender' | 'leads' | 'informar' |
  // 'reservas' | 'otro'. Free-form string, not an enum — same
  // convention as the rest of this schema's status/state columns
  // (enforced server-side via Zod, not the DB).
  goal           String?
  targetAudience String? @map("target_audience")

  hasExistingBrand Boolean? @map("has_existing_brand")
  brandAssetsNote  String?  @map("brand_assets_note")

  // string[] — which pages the client wants (Inicio, Servicios, etc.)
  pagesNeeded    Json?   @map("pages_needed")
  otherPagesNote String? @map("other_pages_note")

  // 'cliente' | 'kairikos' | 'mixto' — who writes the page copy.
  contentProvidedBy String? @map("content_provided_by")

  desiredDomain     String? @map("desired_domain")
  referenceWebsites String? @map("reference_websites")

  // string[] — WhatsApp, Calendario de citas, CRM, Formulario, Pagos, etc.
  integrationsNeeded    Json?   @map("integrations_needed")
  otherIntegrationsNote String? @map("other_integrations_note")

  additionalNotes String?   @map("additional_notes")
  submittedAt     DateTime? @map("submitted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// =============================================================================
// Stripe operator credentials — the Secret Key an operator pastes into
// /admin/portal/settings/billing so the app can create/reprice Stripe
// Products and Prices on their behalf, instead of doing it by hand in
// the Stripe Dashboard. Encrypted at rest (AES-256-GCM, same pattern as
// GoogleBusinessConnection.refreshToken* — see src/lib/operator-crypto.ts's
// encryptBuffer/decryptBuffer), with a DEDICATED encryption key
// (STRIPE_CREDENTIAL_ENCRYPTION_KEY) — never shared with the key used
// for TOTP secrets or Google refresh tokens.
//
// Singleton row (see STRIPE_CREDENTIAL_SINGLETON_ID in
// stripe-credentials.ts) rather than one row per mode: there is only
// ever one "which mode is active" concept in the whole app, so it lives
// as a single column here instead of needing a second table (or a
// unique-partial-index trick) just to enforce "at most one row per
// mode, exactly one active". Test and live keys are stored side by
// side so switching activeMode back and forth never requires
// re-pasting a key.
model StripeOperatorCredential {
  id         String  @id @default(uuid()) @db.Uuid
  // 'test' | 'live' | NULL — NULL means a key may already be saved
  // below but no mode has been explicitly activated yet, so
  // resolveActiveStripeSecret() falls back to STRIPE_SECRET_KEY (env).
  activeMode String? @map("active_mode")

  testSecretKeyCiphertext Bytes?    @map("test_secret_key_ciphertext")
  testSecretKeyIv         Bytes?    @map("test_secret_key_iv")
  testSecretKeyTag        Bytes?    @map("test_secret_key_tag")
  // Last 4 chars of the key in cleartext (e.g. "aBcD" from
  // sk_test_...aBcD) — lets the UI show "•••• aBcD" without a decrypt.
  testSecretKeyLastFour   String?   @map("test_secret_key_last_four")
  testSavedAt             DateTime? @map("test_saved_at")

  liveSecretKeyCiphertext Bytes?    @map("live_secret_key_ciphertext")
  liveSecretKeyIv         Bytes?    @map("live_secret_key_iv")
  liveSecretKeyTag        Bytes?    @map("live_secret_key_tag")
  liveSecretKeyLastFour   String?   @map("live_secret_key_last_four")
  liveSavedAt             DateTime? @map("live_saved_at")

  updatedAt DateTime @updatedAt @map("updated_at")
}

// Append-only audit trail for (a) saving/rotating a Stripe credential and
// (b) catalog price bootstrap/reprice events. Styled after
// OperatorSettingsAudit (before/after JSON snapshots, denormalized
// actor) rather than reusing that model directly — OperatorSettings
// assumes secrets live in 1Password/env vars (secretManagerRef), which
// doesn't apply to a key encrypted in this database. `before`/`after`
// must NEVER contain the plaintext key or ciphertext — only
// non-sensitive fields (mode, lastFour, priceCents, setupFeeCents,
// stripeProductId, stripe*PriceId).
model StripeCatalogAudit {
  id        String  @id @default(uuid()) @db.Uuid
  // NULL for credential-only events (save/rotate/active-mode-change),
  // set for catalog events (bootstrap/reprice/archive-failed).
  productId String? @map("product_id") @db.Uuid
  // 'credential_saved' | 'credential_rotated' | 'active_mode_changed'
  // | 'price_bootstrap_created' | 'price_repriced'
  // | 'price_archive_failed' | 'reconciled_after_partial_failure'
  action    String
  before    Json?
  after     Json?

  actorOperatorId String?  @map("actor_operator_id") @db.Uuid
  actorEmail      String?  @map("actor_email")
  // { ip, userAgent, totpVerifiedAt, ... } — free-form, non-sensitive.
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  operator Operator? @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// WP-XX — custom-quote billing for 'web'. Replaces the fixed-price
// (799€) self-serve purchase: the client requests 'web' for free
// (ClientProduct.status='quote_pending'), fills in WebBrief, an operator
// prices the project and sends a quote, the client accepts it, the
// operator confirms by generating a Stripe invoice, and the client pays
// — online, or the operator marks it paid manually (transfer/cash,
// channel+reference — see Invoice.paymentChannel above).
//
// 1:1 with ClientProduct (@unique clientProductId), same shape as
// Subscription — only one "live" quote per client at a time. Reusing
// the row across a cancel→retry cycle (rather than creating a new one)
// is intentional: the full history survives in WebQuoteAudit regardless.
//
// Status machine (enforced server-side in src/lib/web-quotes.ts, not a
// DB constraint — same convention as every other status column here):
//   draft → sent → accepted → invoiced → paid              (no deposit)
//   accepted → invoiced_deposit → deposit_paid →
//     invoiced_final → paid                                (with depositCents set)
//   draft/sent/accepted → cancelled                         (operator aborts, no Stripe)
//   invoiced/invoiced_deposit/invoiced_final → cancelled    (voidInvoice, see
//     canVoidInvoice in web-quotes.ts — only while the current invoice is
//     unpaid; once a deposit or the full amount is paid there is no
//     cancel path, a refund would be needed and is out of scope)
//   cancelled → draft                                       (reset, reuses the row)
// =============================================================================
model WebQuote {
  id              String  @id @default(uuid()) @db.Uuid
  clientId        String  @map("client_id")
  // 1:1 — mirrors Subscription.clientProductId. Only one live quote per
  // ClientProduct at a time.
  clientProductId String  @unique @map("client_product_id") @db.Uuid
  tenantId        String? @map("tenant_id") @db.Uuid

  status String @default("draft")

  amountCents  Int    @map("amount_cents")
  // Optional advance/deposit — when set, billing splits into a deposit
  // invoice (amountCents - depositCents left as the final balance) instead
  // of a single invoice for the full amount. Null preserves today's
  // single-payment behavior unchanged. Operator-entered free amount, not a
  // fixed percentage — every quote here is already custom-priced.
  depositCents Int?   @map("deposit_cents")
  currency     String @default("eur")
  // Free text the CLIENT sees verbatim — what this quote covers.
  description  String

  createdByOperatorId String?   @map("created_by_operator_id") @db.Uuid
  sentAt              DateTime? @map("sent_at")
  sentByOperatorId    String?   @map("sent_by_operator_id") @db.Uuid
  acceptedAt          DateTime? @map("accepted_at")
  cancelledAt         DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        ChatbotClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientProduct ClientProduct   @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy     Operator?       @relation("WebQuoteCreatedBy", fields: [createdByOperatorId], references: [id], onDelete: SetNull)
  sentBy        Operator?       @relation("WebQuoteSentBy", fields: [sentByOperatorId], references: [id], onDelete: SetNull)
  auditLogs     WebQuoteAudit[]

  @@index([clientId])
  @@index([status])
  @@index([tenantId])
}

// Append-only audit trail for WebQuote — before/after JSON because this
// tracks real money amounts, not just status strings (ClientProductAudit
// has no columns for that). Same style as StripeCatalogAudit.
model WebQuoteAudit {
  id         String @id @default(uuid()) @db.Uuid
  webQuoteId String @map("web_quote_id") @db.Uuid
  // 'created' | 'edited' | 'sent' | 'accepted' | 'cancelled' |
  // 'reset_to_draft' | 'invoiced' | 'invoiced_deposit' | 'deposit_paid' |
  // 'invoiced_final' | 'invoice_voided' | 'mark_paid_started' |
  // 'mark_paid_succeeded' | 'mark_paid_failed' | 'paid'
  action     String
  before     Json?
  after      Json?

  // 'operator' | 'client' | 'system'
  actorType       String   @default("operator") @map("actor_type")
  actorOperatorId String?  @map("actor_operator_id") @db.Uuid
  // operator email, 'client:<clientId>', or 'stripe:invoice.paid'.
  actorEmail      String?  @map("actor_email")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  webQuote WebQuote  @relation(fields: [webQuoteId], references: [id], onDelete: Cascade)
  operator Operator? @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([webQuoteId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// Canales del chatbot — instalación desde el wizard (WP: conexión de
// canales). Un modelo dedicado por tipo de conexión, mismo patrón que
// GoogleBusinessConnection (WP-21): no una tabla polimórfica genérica con
// discriminador, sino una tabla por clase de conexión, cada una con la
// forma que realmente necesita.
//
// Gating por tier: qué canales puede conectar un cliente depende de
// Product.features.channels (el tier de su ClientProduct 'chatbot'), leído
// por getAllowedChannelsForClient() en src/lib/channel-access.ts — no hay
// columna nueva para esto, se reutiliza la columna Product.features ya
// existente y sin usar.
// =============================================================================

// Canal Web — el widget embebible. publicToken NO se cifra: es un
// identificador público (se pega en HTML del cliente), no un secreto,
// igual que una clave pública de analytics.
model ChatWebEmbed {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id")
  tenantId     String?  @map("tenant_id") @db.Uuid
  publicToken  String   @unique @map("public_token")
  // 'active' | 'disabled'
  status       String   @default("disabled")
  // Apariencia del widget — configurable por el cliente, no un único
  // aspecto para todos. El copy (bienvenida/despedida/prompts) NO vive
  // acá: se lee directo de la config ya aprobada del Paso 9 del wizard,
  // para no duplicar el mismo dato en dos lugares.
  primaryColor String   @default("#0E6B5E") @map("primary_color")
  // 'bottom-right' | 'bottom-left'
  position     String   @default("bottom-right")
  createdAt    DateTime @default(now()) @map("created_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([tenantId])
}

// Canal Telegram — el cliente pega el token de un bot que él mismo creó
// vía @BotFather. Un bot por cliente en v1 (sin selector multi-cuenta).
model TelegramConnection {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String   @map("client_id")
  tenantId           String?  @map("tenant_id") @db.Uuid
  botTokenCiphertext Bytes    @map("bot_token_ciphertext")
  botTokenIv         Bytes    @map("bot_token_iv")
  botTokenTag        Bytes    @map("bot_token_tag")
  botUsername        String   @map("bot_username")
  // 'active' | 'needs_reconnect' | 'revoked'
  status             String   @default("active")
  connectedAt        DateTime @default(now()) @map("connected_at")
  lastSyncError      String?  @map("last_sync_error")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([clientId])
  @@index([tenantId])
  @@index([status])
}

// Canal Meta unificado — WhatsApp, Messenger e Instagram comparten una
// única conexión OAuth contra la cuenta de Meta Business, pero una sola
// autorización puede exponer varias superficies a la vez (varios números
// de WhatsApp, varias Páginas, varias cuentas de Instagram) — a
// diferencia de GoogleBusinessConnection, que asume una sola location.
// Por eso una fila por superficie, no una por cliente.
model MetaChannelConnection {
  id                    String   @id @default(uuid()) @db.Uuid
  clientId              String   @map("client_id")
  tenantId              String?  @map("tenant_id") @db.Uuid
  // 'whatsapp' | 'messenger' | 'instagram'
  channel               String
  // phone_number_id (whatsapp) | page_id (messenger) | ig_user_id (instagram)
  externalId            String   @map("external_id")
  accessTokenCiphertext Bytes    @map("access_token_ciphertext")
  accessTokenIv         Bytes    @map("access_token_iv")
  accessTokenTag        Bytes    @map("access_token_tag")
  // 'active' | 'needs_reconnect' | 'revoked'
  status                String   @default("active")
  connectedAt           DateTime @default(now()) @map("connected_at")
  lastSyncError         String?  @map("last_sync_error")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([clientId, channel, externalId])
  @@index([tenantId])
  @@index([status])
  @@index([channel])
}

// El puente hacia n8n — portal → n8n únicamente (no hay lectura directa
// de esta base desde el motor externo). connectionId es polimórfico
// (apunta a una fila de ChatWebEmbed/TelegramConnection/
// MetaChannelConnection según connectionType) — sin FK, mismo motivo por
// el que otras tablas de este schema tampoco declaran FK a filas
// polimórficas. Reintento con backoff vía el cron
// /api/cron/sync-channel-webhooks, mismo shape que review-overdue /
// wizard-abandoned (scan + fire).
model ChannelWebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  // 'web' | 'telegram' | 'meta'
  connectionType String    @map("connection_type")
  connectionId   String    @map("connection_id") @db.Uuid
  clientId       String    @map("client_id")
  payload        Json
  // 'pending' | 'delivered' | 'failed'
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastAttemptAt  DateTime? @map("last_attempt_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([connectionType, connectionId])
}
