// =============================================================================
// Kairikos — Chatbot AI end-client portal (KAIA-752)
// Prisma schema for the Prisma + PostgreSQL 16 + Docker on VPS stack
// (plan rev 3, KAIA-719).
//
// Per-row isolation: every portal API route resolves clientId from
//   ChatbotClientUser.nextAuthEmail = session.user.email
// before any other query. No raw SQL — all reads go through Prisma
// `where: { clientId }` clauses. See prisma/README.md for the rule.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per paying client. Source of truth for billing + onboarding state.
// Stripe remains the billing source of truth (stripeCustomerId is the link).
model ChatbotClient {
  id               String    @id @default(cuid())
  // NextAuth magic-link recipient. Unique — v1 has no shared inboxes.
  email            String    @unique
  name             String
  // Company name (free-form, may differ from the legal entity on Stripe).
  companyName      String?
  // Active subscription tier. Mirrors the value Stripe reports back via webhook.
  tier             String    @default("starter")
  // Stripe customer id (populated by the Stripe webhook handler in
  // kira-studio-billing-backend). NULL during the trial window.
  stripeCustomerId String?
  // Set when the CTO marks the chatbot live in the operator flow.
  goLiveAt         DateTime?
  // Supabase chatbot_clients.id (UUID). Populated by the backfill in KAIA-762
  // so the status-change watcher can resolve the Supabase UUID to the
  // portal's cuid without going through the email join path.
  supabaseClientId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities    ChatbotActivity[]
  conversations ChatbotConversation[]
  users         ChatbotClientUser[]

  @@index([stripeCustomerId])
  @@index([tier])
}

// Maps a NextAuth session email to a ChatbotClient row. v1 is 1:1 — one
// nextAuthEmail per client. (Multi-tenant org switching is a v2 backlog item.)
model ChatbotClientUser {
  id            String        @id @default(cuid())
  clientId      String
  // NextAuth session email (the JWT subject). Unique — magic-link recipient.
  nextAuthEmail String        @unique
  client        ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// One row per T+N event the n8n flow emits (T+0, T+3, T+7, T+14, …).
// Drives the portal onboarding timeline.
//
// Idempotency: the unique constraint on (clientId, milestone) makes the
// portal's POST /api/internal/activity endpoint a true upsert. n8n flows
// can re-run freely; the second write collapses to a no-op. The
// (clientId, milestone) pair is the natural business key — there is at
// most one row per T+N milestone per client.
model ChatbotActivity {
  id          String        @id @default(cuid())
  clientId    String
  // T+N milestone label — "T+0", "T+3", "T+7", "T+14" by convention; free-form
  // string so n8n can extend without a schema migration. Enforced allowlist
  // lives in the route handler at src/app/api/internal/activity/route.ts.
  milestone   String
  // NULL when the row is created up-front (e.g. the schedule); set when the
  // event actually fires.
  completedAt DateTime?
  notes       String?
  client      ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, milestone])
  @@index([clientId, completedAt])
}

// One row per chatbot conversation. Read-only on the portal in v1
// (writes come from the chatbot platform via n8n).
model ChatbotConversation {
  id         String        @id @default(cuid())
  clientId   String
  startedAt  DateTime
  // Duration in seconds. NULL while the conversation is still open.
  duration   Int?
  // Outcome / resolution status. Free-form string so the chatbot platform
  // can extend without a schema migration. Conventional values:
  //   resolved | escalated | abandoned | fallback | unknown
  outcome    String?
  // Full transcript as JSON — message list, metadata, tool calls, etc.
  transcript Json?
  client     ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt])
  @@index([clientId, outcome])
}

// =============================================================================
// NextAuth.js v5 (KAIA-753) — required by @auth/prisma-adapter.
// We run with JWT session strategy (no DB-backed sessions), so the Session
// model is unused at runtime, but the adapter still requires the model to
// exist in the schema. The VerificationToken model is the hot path for the
// Resend magic-link provider: one row per email send, deleted on click.
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
