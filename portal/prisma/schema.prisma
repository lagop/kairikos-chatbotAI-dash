// =============================================================================
// Kairikos — Chatbot AI end-client portal (KAIA-752)
// Prisma schema for the Prisma + PostgreSQL 16 + Docker on VPS stack
// (plan rev 3, KAIA-719).
//
// Per-row isolation: every portal API route resolves clientId from
//   ChatbotClientUser.nextAuthEmail = session.user.email
// before any other query. No raw SQL — all reads go through Prisma
// `where: { clientId }` clauses. See prisma/README.md for the rule.
//
// Multi-tenant: KAIA-4258 — tenant isolation via profiles.tenant_id FK.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // KAIA-2858 — Vercel runtime is Amazon Linux 2 (RHEL-derived, glibc, openssl
  // 3.0.x), but `prisma generate` on the build host (Debian) defaults to
  // `debian-openssl-3.0.x`. The mismatch means every route that transitively
  // imports `@/lib/prisma` (e.g. `/portal`, `/api/auth/*`) blows up at
  // module-load time on Vercel with "Failed to load query engine" → HTTP 500,
  // while routes that never import prisma (`/portal/login`, `/api/health`)
  // keep working. Emit both binaries so the same generated client works in
  // the Docker / VPS build (debian) AND in Vercel serverless (rhel).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // KAIA-14409 — `prisma migrate deploy` cannot run DDL through the
  // transaction-mode PgBouncer pool (port 6543). It needs a direct
  // connection (port 5432). Vercel project already exposes `DIRECT_URL`
  // for production + preview targets; the build script added on
  // commit 3453364 runs `prisma migrate deploy` and reads this
  // env var through the schema's directUrl. Do not remove without
  // first re-routing the build script to a direct URL.
  //
  // KAIA-14440 — DIRECT_URL must be the Supabase *session-mode pooler*
  // (aws-0-<region>.pooler.supabase.com:5432), NOT db.<project-ref>.supabase.co:5432.
  // The db.<ref> host is IPv6-only; Vercel and most CI build containers are
  // IPv4-only, so pointing DIRECT_URL there makes every build-time migration
  // fail with "Network is unreachable" while still looking correctly
  // configured. The pooler host resolves to IPv4 and speaks session mode, so
  // it can hold the advisory locks DDL requires.
  directUrl = env("DIRECT_URL")
}

// One row per paying client. Source of truth for billing + onboarding state.
// Stripe remains the billing source of truth (stripeCustomerId is the link).
model ChatbotClient {
  id               String    @id @default(cuid())
  // NextAuth magic-link recipient. Unique — v1 has no shared inboxes.
  email            String    @unique
  name             String
  // Company name (free-form, may differ from the legal entity on Stripe).
  companyName      String?
  // Active subscription tier. Mirrors the value Stripe reports back via webhook.
  tier             String    @default("starter")
  // Stripe customer id (populated by the Stripe webhook handler in
  // kira-studio-billing-backend). NULL during the trial window.
  stripeCustomerId String?
  // Explicit onboarding-state column. KAIA-1062 self-service UI sets
  // this to 'go-live-pending' when the client clicks "I'm ready for
  // go-live" on the portal. The CTO flips it to 'live' and sets
  // `goLiveAt` in the same transaction. KAIA-1261 (BE-1 v1) extends
  // the allowlist with 'ready' and 'updating' for the wizard state
  // machine. WP-23 — this comment previously listed only 5 values;
  // ALLOWED_STATES in api/admin/portal/clients/[id]/route.ts also lets
  // the operator PATCH the column to 'pending' / 'paused' / 'cancelled'
  // by hand (account-lifecycle overrides, not wizard transitions), so
  // the real allowlist is 8. src/types/portal.ts's OnboardingStatus is
  // the single canonical type for all 8 — keep it in sync with this list.
  //   * 'in-progress'    — default; wizard in progress, not yet live
  //   * 'go-live-pending'— client requested go-live approval
  //   * 'ready'          — wizard v1: every mandatory step reached
  //                        'approved' for the first time. n8n listens
  //                        for the config_complete trigger at this edge.
  //   * 'live'           — operator approved go-live (goLiveAt also set)
  //   * 'updating'       — wizard v1: a step moved to needs_revision
  //                        (or a new draft was created) while the client
  //                        was 'live'. The bot keeps running on the last
  //                        approved version per step until the operator
  //                        approves the new one.
  //   * 'pending'        — operator override; account-lifecycle state,
  //                        not written by the wizard/self-service flows.
  //   * 'paused'         — operator override; account-lifecycle state.
  //   * 'cancelled'      — operator override; account-lifecycle state.
  state            String    @default("in-progress")
  // Set when the CTO marks the chatbot live in the operator flow.
  goLiveAt         DateTime?
  // KAIA-13281 — Operator-editable free-form notes. Mutated via
  // PATCH /api/admin/portal/clients/[clientId] by an operator session;
  // every write produces an OperatorAction audit row in the same
  // transaction.
  notes            String?
  // Supabase chatbot_clients.id (UUID). Populated by the backfill in KAIA-762
  // so the status-change watcher can resolve the Supabase UUID to the
  // portal's cuid without going through the email join path.
  supabaseClientId String?   @unique
  // KAIA-4258: tenant isolation FK. All client data is scoped to this tenant.
  // NULL during the migration window; the data backfill migration sets it
  // to the default tenant for any row that pre-dates this column.
  tenantId         String?   @map("tenant_id") @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities                 ChatbotActivity[]
  conversations              ChatbotConversation[]
  users                      ChatbotClientUser[]
  operatorNotifications      OperatorNotification[]
  n8nExecutions              N8nExecution[]
  configSteps                ChatbotConfigStep[]
  intakeSubmissions          IntakeSubmission[]
  supportRequests            SupportRequest[]
  tenant                     Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  clientProducts             ClientProduct[]
  productAudits              ClientProductAudit[]
  subscriptions              Subscription[]
  invoices                   Invoice[]
  operatorActions            OperatorAction[]
  googleBusinessConnections  GoogleBusinessConnection[]
  googleSeoConnection        GoogleSeoConnection?
  googleReviews              GoogleReview[]
  reviewRequestCampaigns     ReviewRequestCampaign[]
  webBriefs                  WebBrief[]
  webQuotes                  WebQuote[]
  chatWebEmbeds              ChatWebEmbed[]
  telegramConnections        TelegramConnection[]
  metaChannelConnections     MetaChannelConnection[]
  channelWebhookDeliveries   ChannelWebhookDelivery[]
  conversationDigests        ConversationDigest[]
  conversationDigestSchedule ConversationDigestSchedule?
  leads                      Lead[]
  leadAudits                 LeadAudit[]
  recallSubscriptions        RecallSubscription[]
  recallSubscriptionAudits   RecallSubscriptionAudit[]
  callEvents                 CallEvent[]
  whatsappTemplates          WhatsappTemplate[]
  prospectingCampaigns       ProspectingCampaign[]
  prospectingCampaignAudits  ProspectingCampaignAudit[]
  seoProfiles                SeoProfile[]
  seoProfileAudits           SeoProfileAudit[]
  recallBlockedNumbers       RecallBlockedNumber[]
  recallDigests              RecallDigest[]
  recallUsageMonths          RecallUsageMonth[]

  @@index([stripeCustomerId])
  @@index([tier])
  @@index([state])
  @@index([tenantId])
}

// =============================================================================
// KAIA-2913 — In-house intake submission (replaces Tally webhook ingestion).
//
// One row per accepted POST /api/public/intake. The endpoint:
//   1. validates the payload with the Zod schema in src/lib/intake-schema.ts
//   2. upserts a ChatbotClient + ChatbotClientUser pair (idempotency on email)
//   3. writes the IntakeSubmission row with the resolved client_id
//   4. triggers Drive folder creation + CTO notify-operator + Paperclip Day-2
//
// Idempotency: client supplies X-Idempotency-Key (or the server mints a
// UUIDv4 fallback). The route resolves to the existing row on retries and
// returns the same response payload — never duplicates the side effects.
// =============================================================================

model IntakeSubmission {
  id                String   @id @default(cuid())
  // Client-supplied or server-generated idempotency token. UNIQUE.
  idempotencyKey    String   @unique @map("idempotency_key")
  // 'public_intake' | future sources (csv_import, partner_api, ...). Free-form.
  source            String
  // Vertical tag derived from the `sector` field in the payload.
  vertical          String
  // Slug of the form spec this submission belongs to. Keeps the table
  // multi-form-friendly in case more intake funnels land later.
  intakeSlug        String   @map("intake_slug")
  // Full payload as JSONB so the admin portal can re-render the submission.
  payload           Json
  // FK to ChatbotClient. NULL during the brief window between row insert
  // and the client upsert completing in the same transaction.
  clientId          String?  @map("client_id")
  // KAIA-4258: tenant isolation FK. NULL for pre-multi-tenant rows; the
  // backfill migration sets it to the default tenant.
  tenantId          String?  @map("tenant_id") @db.Uuid
  // Denormalized for list/search views so the admin query doesn't have to
  // extract from JSONB on every page load.
  businessName      String   @map("business_name")
  humanHandoffEmail String   @map("human_handoff_email")
  ipHash            String?  @map("ip_hash")
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  client ChatbotClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([vertical])
  @@index([source])
  @@index([intakeSlug])
  @@index([businessName])
  @@index([humanHandoffEmail])
  @@index([clientId])
  @@index([tenantId])
}

// One row per operator notification fired (KAIA-1061). Drives the
// dedup logic in POST /api/internal/notify-operator and the future
// operator inbox view.
//
// Idempotency: the unique constraint on (clientId, kind, day) — where
// `day` is a YYYY-MM-DD UTC date — makes the route a true upsert.
// Repeated calls within the same UTC day collapse to a no-op. `clientId`
// is nullable so non-client-scoped events (e.g. a global n8n failure)
// can still be logged without violating the constraint.
model OperatorNotification {
  id              String         @id @default(cuid())
  clientId        String?
  // KAIA-4258: tenant isolation FK. NULL for non-client-scoped events
  // (e.g. a global n8n failure) and for pre-multi-tenant rows; the
  // backfill migration sets it from ChatbotClient.tenantId where known.
  tenantId        String?        @map("tenant_id") @db.Uuid
  // 'stuck' | 'execution-failed' | 'escalation'
  // | 'review-overdue-warning' | 'review-overdue-escalation'. Enforced
  // server-side in the route handlers — Postgres does not need a CHECK
  // constraint because no production code writes an unknown value.
  kind            String
  // Date the notification fired (YYYY-MM-DD). For stuck / execution-failed
  // / escalation this is the UTC date (stable across timezones); for
  // review-overdue-* the route computes it in the operator's timezone
  // (see `operator_day_in_tz` SQL function) so a Friday-evening review
  // in Madrid and a Monday-morning re-fire land on distinct days.
  day             String
  // Wizard step id (KAIA-1163 cuid) for review-overdue kinds. NULL for
  // the other three kinds. Carries the per-step dedup key.
  stepId          String?
  subject         String
  // JSON-as-string with the request body that fired the notification.
  context         String?
  // Resend message id, populated after a successful send.
  resendMessageId String?
  sentAt          DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  client          ChatbotClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([clientId, kind, day])
  @@index([day])
  @@index([resendMessageId])
  // KAIA-1177: per-step dedup lookup for review-overdue kinds. The
  // partial UNIQUE on (stepId, kind, day) lives in
  // 20260613124100_operator_notification_step_dedup/migration.sql
  // because Prisma does not natively model partial indexes; the @@index
  // here gives the route a fast lookup so the dedup check is one round
  // trip.
  @@index([stepId, kind, day])
  @@index([stepId])
  @@index([tenantId])
}

// =============================================================================
// WP-11 — Client help requests, persisted and manageable in the admin panel.
//
// Before this table, "Necesito ayuda" (POST /api/portal/operator with
// kind: 'help-request') only wrote its subject/message into
// OperatorNotification.context — a JSON-as-string blob keyed by
// (clientId, kind, day). A second help request from the same client on
// the same UTC day silently overwrote the first one's context (the route
// dedupes the EMAIL per day, which is correct — the operator shouldn't
// get spammed — but that dedup was also erasing the client's own
// message history, and there was no admin view to read past requests at
// all). This table is the durable, queryable record: one row per
// request, independent of the email dedup window, with a status the
// operator can move from 'open' to 'resolved' from the admin panel.
// =============================================================================
model SupportRequest {
  id       String  @id @default(cuid())
  clientId String  @map("client_id")
  // KAIA-4258: tenant isolation FK. NULL for pre-multi-tenant rows.
  tenantId String? @map("tenant_id") @db.Uuid

  subject String
  message String

  // 'open' | 'resolved'. Enforced server-side (route allowlist), not a
  // DB CHECK constraint — same convention as OperatorNotification.kind.
  status               String    @default("open")
  // Operator email/id who marked it resolved — free-form string, same
  // convention as OperatorAction.actorId (not a FK to Operator; v1 auth
  // reads the identity from the admin session, not a DB-enforced actor).
  resolvedByOperatorId String?   @map("resolved_by_operator_id")
  resolvedAt           DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([tenantId])
}

// =============================================================================
// KAIA-1107 — Per-operator identity (email + password + TOTP MFA).
// One row per operator who can access the admin portal. The password hash
// is argon2id (OWASP 2026 recommendation). The TOTP secret is encrypted at
// rest with a server-side key so a DB dump alone does not compromise MFA
// enrollment. Soft-deletion via isActive preserves the audit trail.
// =============================================================================

model Operator {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String
  // Encrypted TOTP secret (AES-256-GCM with OPERATOR_TOTP_ENCRYPTION_KEY).
  // NULL until the operator initiates TOTP enrollment.
  totpSecret     String?
  // NULL until the operator completes TOTP enrollment (verified a valid code).
  totpEnrolledAt DateTime?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  lastTotpAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions                 OperatorSession[]
  recoveryCodes            OperatorRecoveryCode[]
  auditLogs                OperatorSettingsAudit[]
  approvedConfigSteps      ChatbotConfigStep[]
  stripeCatalogAudits      StripeCatalogAudit[]
  webQuotesCreated         WebQuote[]                @relation("WebQuoteCreatedBy")
  webQuotesSent            WebQuote[]                @relation("WebQuoteSentBy")
  webQuoteAudits           WebQuoteAudit[]
  invoicesMarkedPaid       Invoice[]
  recallSubscriptionAudits RecallSubscriptionAudit[]
  integrationCredentialAudits IntegrationCredentialAudit[]
  seoProfileAudits         SeoProfileAudit[]

  @@index([email])
  @@index([isActive])
}

// Server-side session store. The session `id` IS the opaque session token,
// returned to the operator as an httpOnly secure cookie. Sessions have a
// 7-day absolute lifetime. Revoked sessions cannot be reused.
model OperatorSession {
  id             String    @id @default(uuid()) @db.Uuid
  operatorId     String    @db.Uuid
  // Set when the operator passes TOTP step-up. Mutations check this.
  totpVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  ip             String?
  userAgent      String?
  // Soft-revoke. When non-null the session is dead even if not yet expired.
  revokedAt      DateTime?

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([expiresAt])
}

// One-time recovery codes generated at TOTP enrollment. Stored as argon2id
// hashes. Shown to the operator exactly once at enrollment time; never
// retrievable afterwards. Each code can be consumed at most once.
model OperatorRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  operatorId String    @db.Uuid
  // argon2id hash of the recovery code — never stored in plaintext.
  codeHash   String
  // NULL until consumed; set to the timestamp of use.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

// =============================================================================
// KAIA-1073 — n8n execution capture for the operator flow-health dashboard.
// Every T+N workflow run (success or failure) is upserted here by the
// POST /api/internal/n8n-execution endpoint so the dashboard can surface
// the last n8n status per client without querying n8n directly.
//
// Upsert key: `id` (n8n's own execution id — stable across retried calls).
// Indexes: (clientId, startedAt desc) for per-client history; (status,
// startedAt desc) for the failure-listing dashboard panel.
// =============================================================================
model N8nExecution {
  id           String    @id
  clientId     String?
  // KAIA-4258: tenant isolation FK. NULL for non-client-scoped flows
  // (e.g. a global n8n failure) and for pre-multi-tenant rows.
  tenantId     String?   @map("tenant_id") @db.Uuid
  clientName   String?
  workflow     String
  milestone    String?
  status       String
  startedAt    DateTime
  finishedAt   DateTime?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime  @default(now())

  client ChatbotClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([tenantId])
}

// Maps a NextAuth session email to a ChatbotClient row. v1 is 1:1 — one
// nextAuthEmail per client. (Multi-tenant org switching is a v2 backlog item.)
model ChatbotClientUser {
  id            String        @id @default(cuid())
  clientId      String
  // NextAuth session email (the JWT subject). Unique — credentials login email.
  nextAuthEmail String        @unique
  // FK to User — the canonical identity row that holds the credential hash.
  // NULL for users who have not yet been linked (backfill completes this).
  userId        String?       @unique
  // KAIA-4258: tenant isolation FK, resolved via the linked Profile on insert.
  // NULL for pre-multi-tenant rows; the backfill migration sets it from
  // ChatbotClient.tenantId.
  tenantId      String?       @map("tenant_id") @db.Uuid
  client        ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([tenantId])
}

// =============================================================================
// KAIA-2103 — Unified user identity for credential-based auth.
// Stores role (client | operator), email, and the password hash.
// Both ChatbotClientUser and Operator link to User via userId.
// =============================================================================
model User {
  id            String    @id @default(cuid())
  // 'client' | 'operator'. Determines which auth provider accepts this user.
  role          String    @default("client")
  email         String    @unique
  // argon2id hash of the password. NULL until the user sets a password via
  // the setup-password flow. '__must_reset__' is the backfill marker for
  // existing ChatbotClientUser rows that had NULL passwordHash — these users
  // cannot authenticate until they complete setup-password.
  passwordHash  String?
  passwordSetAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chatbotClientUsers ChatbotClientUser[]
  profile            Profile?

  @@index([email])
  @@index([role])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: Tenant organizations
//
// One row per tenant organization. The tenant owns all client data.
// Feature flags stored as JSONB for per-tenant rollout (mirrors the
// Supabase supabase/migrations/20260724_tenant_isolation_v1.up.sql
// shape so the two databases stay aligned for the same logical entity).
// =============================================================================
model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  // 'active' | 'suspended' | 'cancelled'. Enforced server-side.
  status           String   @default("active")
  features         Json     @default("{}")
  // KAIA-4262 — Stripe Customer link. NULL until the portal (or owner
  // operator flow) creates the Customer and the Stripe webhook stores
  // the id back. UNIQUE so the same Stripe customer can only be
  // linked to one tenant.
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  profiles                    Profile[]
  chatbotClients              ChatbotClient[]
  chatbotClientUsers          ChatbotClientUser[]
  chatbotActivities           ChatbotActivity[]
  chatbotConversations        ChatbotConversation[]
  chatbotConfigSteps          ChatbotConfigStep[]
  chatbotConfigStepAudits     ChatbotConfigStepAudit[]
  intakeSubmissions           IntakeSubmission[]
  operatorNotifications       OperatorNotification[]
  supportRequests             SupportRequest[]
  n8nExecutions               N8nExecution[]
  clientProducts              ClientProduct[]
  productAudits               ClientProductAudit[]
  subscriptions               Subscription[]
  invoices                    Invoice[]
  googleBusinessConnections   GoogleBusinessConnection[]
  googleSeoConnections        GoogleSeoConnection[]
  googleReviews               GoogleReview[]
  reviewRequestCampaigns      ReviewRequestCampaign[]
  webBriefs                   WebBrief[]
  webQuotes                   WebQuote[]
  chatWebEmbeds               ChatWebEmbed[]
  telegramConnections         TelegramConnection[]
  metaChannelConnections      MetaChannelConnection[]
  conversationDigests         ConversationDigest[]
  conversationDigestSchedules ConversationDigestSchedule[]
  leads                       Lead[]
  leadAudits                  LeadAudit[]
  recallSubscriptions         RecallSubscription[]
  callEvents                  CallEvent[]
  prospectingCampaigns        ProspectingCampaign[]
  prospectingCampaignAudits   ProspectingCampaignAudit[]
  seoProfiles                 SeoProfile[]
  seoProfileAudits            SeoProfileAudit[]

  @@index([slug])
  @@index([status])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: User profiles
//
// One row per linked User (1:1). Carries the tenant FK and the role that
// gates RLS-equivalent application-layer checks. The portal routes resolve
// `tenantId` from Profile via the session email; rows are created when a
// User is provisioned (the credentials signup flow creates User + Profile
// in the same transaction).
// =============================================================================
model Profile {
  id        String   @id @default(cuid())
  // FK to User — 1:1. UNIQUE so the canonical identity row is unambiguous.
  userId    String   @unique @map("user_id")
  tenantId  String   @map("tenant_id") @db.Uuid
  // 'owner' | 'admin' | 'viewer'. Enforced server-side. Owner sees all
  // tenant data; admin can mutate; viewer is read-only.
  role      String   @default("viewer")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([role])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: Service products (tiers)
//
// Kairikos service tiers. Source of truth is Stripe, but we store metadata
// here for portal display and feature-gating. Mirrors the shape of the
// Supabase products table so the same Stripe webhook can write both.
//
// WP-12 — this used to be "one row per chatbot tier" (`tier` was
// @unique). Kairikos sells five products (chatbot, web platform, AI lead
// capture, SEO, Google reviews), not one, so `tier` is now unique only
// WITHIN a product's `code` (@@unique([code, tier])) — two different
// products can each have their own 'standard'/'pro' tier without
// colliding. The price model also changed: `priceCents` is the monthly
// fee (0 for one-time-only products like the web platform) and
// `setupFeeCents` is the one-time onboarding fee. Billing type is
// derived from the two rather than stored as a third field: fee=0 +
// setup>0 is one-time, both>0 is setup-plus-subscription. See
// prisma/migrations/*_product_multi_service for the backfill.
// =============================================================================
model Product {
  id                     String   @id @default(uuid()) @db.Uuid
  // 'chatbot' | 'web' | 'captacion' | 'seo' | 'resenas'. Free-form so a
  // sixth product doesn't need a schema migration.
  code                   String
  // The Stripe Product these two Price ids below belong to. NULL until
  // an operator bootstraps this tier from /admin/portal/settings/billing
  // (src/lib/stripe-catalog.ts) — needed so a later reprice creates the
  // new Price under the SAME Stripe Product instead of a duplicate one.
  stripeProductId        String?  @map("stripe_product_id")
  // Stripe recurring-price id for the monthly fee (populated by the
  // Stripe webhook handler). NULL for unsynced/grandfathered rows or
  // products with no subscription component.
  stripeRecurringPriceId String?  @unique @map("stripe_recurring_price_id")
  // Stripe one-time-price id for the setup fee. NULL when setupFeeCents
  // is 0, or when the fee hasn't been provisioned on Stripe yet.
  stripeSetupPriceId     String?  @map("stripe_setup_price_id")
  // 'test' | 'live' | NULL — which Stripe mode stripeProductId/
  // stripeRecurringPriceId/stripeSetupPriceId were created under. There
  // is no reliable, documented way to infer test-vs-live from a Stripe
  // id's shape alone, so this is tracked explicitly at bootstrap/reprice
  // time. Used to warn an operator in the UI when this tier's Price
  // objects were created in a different mode than the one currently
  // active (see StripeOperatorCredential.activeMode) — a checkout
  // against a mismatched mode fails with a Stripe "resource_missing"
  // error, since Price ids are scoped to a single mode.
  stripePriceMode        String?  @map("stripe_price_mode")
  name                   String
  // 'starter' | 'pro' | 'premium' for chatbot; 'standard' for the
  // single-tier products. Unique per `code`, not globally.
  tier                   String
  priceCents             Int      @map("price_cents")
  setupFeeCents          Int      @default(0) @map("setup_fee_cents")
  currency               String   @default("EUR")
  features               Json     @default("{}")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")

  clientProducts ClientProduct[]
  auditLogs      ClientProductAudit[]
  catalogAudits  StripeCatalogAudit[]

  @@unique([code, tier])
  @@index([code])
  @@index([tier])
  @@index([isActive])
}

// Immutable audit trail for product assignment and lifecycle changes.
model ClientProductAudit {
  id              String   @id @default(uuid()) @db.Uuid
  clientProductId String   @map("client_product_id") @db.Uuid
  clientId        String   @map("client_id")
  productId       String   @map("product_id") @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  action          String
  statusBefore    String?  @map("status_before")
  statusAfter     String?  @map("status_after")
  actorId         String   @map("actor_id")
  changedAt       DateTime @default(now()) @map("changed_at")

  clientProduct ClientProduct @relation(fields: [clientProductId], references: [id], onDelete: Restrict)
  client        ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientProductId, changedAt])
  @@index([clientId, changedAt])
  @@index([tenantId])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: Client-Product many-to-many join

//
// Associates chatbot clients with their subscribed products. Stripe stores
// the subscription itself; this row is the portal/Supabase denormalization
// for owner views and feature gating.
//
// WP-XX — 'web' is deliberately EXEMPT from the one-row-per-client rule: a
// client can have multiple independent web projects (e.g. a main site + a
// separate landing page brand), each with its own WebQuote/WebBrief/
// Subscription/Invoice lifecycle. Every OTHER product code still gets a
// real DB-level uniqueness guarantee — reactivation goes through UPDATE on
// the existing row, not a fresh INSERT — but Prisma's schema DSL can't
// express a conditional/partial unique constraint, so that guarantee lives
// as a raw-SQL partial unique index in this migration's .sql file, NOT as
// an `@@unique` here. See prisma/migrations/<this migration>/migration.sql.
// =============================================================================
model ClientProduct {
  id              String    @id @default(uuid()) @db.Uuid
  clientId        String    @map("client_id")
  productId       String    @map("product_id") @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  // 'pending_payment' | 'active' | 'paused' | 'cancelled' | 'past_due' |
  // 'quote_pending'. The last one is 'web'-specific (WP-XX): covers the
  // ENTIRE pre-payment stretch of the custom-quote flow — from the
  // client's free request through the operator's quote, the client's
  // acceptance, and the resulting invoice — until it's paid, at which
  // point this flips straight to 'active' (see
  // activateClientProductFromWebQuotePayment in stripe-billing.ts).
  // WebQuote.status carries the fine-grained state within this one
  // coarse value, same relationship 'pending_payment' already has to
  // the plain self-serve Stripe Checkout flow.
  status          String    @default("active")
  subscribedAt    DateTime  @default(now()) @map("subscribed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdBy       String?   @map("created_by")
  changedBy       String?   @map("changed_by")
  changedAt       DateTime  @default(now()) @map("changed_at")
  // WP-14 — per-product onboarding lifecycle. `status` above is the
  // Stripe-mirroring billing state (active/cancelled/past_due);
  // `onboardingState` is a different axis entirely — where THIS
  // product's wizard/onboarding sits, using the same vocabulary as
  // ChatbotClient.state / types/portal.ts's OnboardingStatus. This
  // column is now the source of truth for onboarding lifecycle;
  // ChatbotClient.state is kept as a mirror of the chatbot product's
  // onboardingState (n8n still reads it — see the migration's COMPAT
  // note) rather than removed.
  onboardingState String    @default("in-progress") @map("onboarding_state")
  goLiveAt        DateTime? @map("go_live_at")

  client              ChatbotClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  auditLogs           ClientProductAudit[]
  subscription        Subscription?
  // WP-19 — one-time-purchase products (no recurring price) invoice
  // directly against the ClientProduct instead of through a Subscription
  // — see Invoice.clientProductId.
  invoices            Invoice[]
  webQuote            WebQuote?
  webBrief            WebBrief?
  recallSubscription  RecallSubscription?
  prospectingCampaign ProspectingCampaign?
  seoProfile          SeoProfile?

  // Real DB-level uniqueness for every code except 'web' lives in a raw-SQL
  // partial unique index (see this migration's .sql) — Prisma can't express
  // "unique except when product.code = 'web'" via @@unique.
  @@index([clientId, productId])
  @@index([clientId])
  @@index([productId])
  @@index([status])
  @@index([tenantId])
}

// =============================================================================
// KAIA-4262 — Stripe Subscription state mirror (per ClientProduct)
//
// One row per Stripe Subscription. Stripe is the source of truth — this
// row is the portal/Supabase denormalization for the owner billing UI,
// the client billing page, and the MRR aggregation.
//
// Idempotency: stripe_id is UNIQUE so the webhook upsert is naturally
// idempotent even if the StripeWebhookEvent idempotency row is missing.
// 1:1 with ClientProduct so each product-tier subscription per client
// maps to exactly one ClientProduct row.
// =============================================================================
model Subscription {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  clientId           String    @map("client_id")
  clientProductId    String    @unique @map("client_product_id") @db.Uuid
  // Stripe identifiers — stripe_id is the business key.
  stripeId           String    @unique @map("stripe_id")
  stripeCustomerId   String    @map("stripe_customer_id")
  stripePriceId      String?   @map("stripe_price_id")
  // 'incomplete' | 'trialing' | 'active' | 'past_due' | 'canceled' |
  // 'unpaid' | 'incomplete_expired' | 'paused'. Mirrors Stripe's enum.
  status             String    @default("incomplete")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")
  // Currency minor units (9900 = 99€).
  amountCents        Int?      @map("amount_cents")
  currency           String    @default("eur")
  // Latest Stripe subscription snapshot. NOT source of truth.
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client        ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientProduct ClientProduct @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([stripeCustomerId])
}

// =============================================================================
// KAIA-4262 — Stripe Invoice state mirror (per Subscription or, since
// WP-19, per one-time-purchase ClientProduct)
//
// One row per Stripe Invoice. Used by the client billing page (latest
// invoice + PDF link) and by the owner MRR aggregation. host_invoice_url
// is what the portal sends the user to for the Stripe-hosted view;
// invoice_pdf_url is the direct PDF download.
//
// WP-19 — subscriptionId is now nullable and clientProductId was added.
// A product with no recurring price (e.g. the one-time web platform
// purchase) never gets a Subscription row at all — its Invoice links
// straight to the ClientProduct instead. Exactly one of
// subscriptionId / clientProductId is set per row; which one tells you
// whether this invoice came from the recurring or the one-time path.
// Pre-WP-19 rows are all subscription-linked (clientProductId stays
// NULL for them — no backfill needed, the FK is purely additive).
//
// Idempotency: stripe_id is UNIQUE so webhook retries collapse to a
// no-op upsert.
// =============================================================================
model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  clientId        String    @map("client_id")
  subscriptionId  String?   @map("subscription_id") @db.Uuid
  clientProductId String?   @map("client_product_id") @db.Uuid
  stripeId        String    @unique @map("stripe_id")
  // 'draft' | 'open' | 'paid' | 'uncollectible' | 'void'. 'void' is set
  // via voidWebQuoteInvoice() (stripe.invoices.voidInvoice) — see
  // canVoidInvoice in web-quotes.ts for when that's allowed.
  status          String    @default("draft")
  number          String?
  // 'full' | 'deposit' | 'final' | null. Set from the Stripe invoice's
  // kairikos_invoice_role metadata by syncInvoiceFromStripe — denormalized
  // here so the UI never has to inspect Stripe metadata to know whether an
  // Invoice is a WebQuote's single full payment, its deposit, or its final
  // balance. Null for invoices unrelated to a WebQuote.
  invoiceRole     String?   @map("invoice_role")
  amountDueCents  Int       @default(0) @map("amount_due_cents")
  amountPaidCents Int       @default(0) @map("amount_paid_cents")
  currency        String    @default("eur")
  issuedAt        DateTime? @map("issued_at")
  dueAt           DateTime? @map("due_at")
  paidAt          DateTime? @map("paid_at")
  periodStart     DateTime? @map("period_start")
  periodEnd       DateTime? @map("period_end")
  hostInvoiceUrl  String?   @map("host_invoice_url")
  invoicePdfUrl   String?   @map("invoice_pdf_url")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // WP-XX — manual (offline) payment tracking for web-quote invoices.
  // CRITICAL: syncInvoiceFromStripe() must NEVER write to these 5
  // columns, in either its `create` or `update` — Stripe has no concept
  // of "channel", only the read-only `paid_out_of_band` boolean it
  // returns on the Invoice object, which we separately store here to
  // remember whether a payment was manual. If a future sync change ever
  // includes these fields, it silently erases the audit trail of who
  // marked a payment manually and how (transfer vs cash, reference
  // number) — there is deliberately only ONE code path that writes them:
  // markInvoicePaidManually() in stripe-billing.ts.
  paymentChannel         String?   @map("payment_channel")
  paymentReference       String?   @map("payment_reference")
  paidOutOfBand          Boolean   @default(false) @map("paid_out_of_band")
  markedPaidByOperatorId String?   @map("marked_paid_by_operator_id") @db.Uuid
  markedPaidAt           DateTime? @map("marked_paid_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client        ChatbotClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  clientProduct ClientProduct? @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  markedPaidBy  Operator?      @relation(fields: [markedPaidByOperatorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clientId])
  @@index([subscriptionId])
  @@index([clientProductId])
  @@index([status])
}

// =============================================================================
// KAIA-4262 — Stripe webhook event idempotency log
//
// Primary key = Stripe event id. Inserted before any state mutation so
// a redelivery of the same event id short-circuits. payload_hash guards
// against the (rare) case where Stripe re-delivers an event id with a
// mutated body — we still no-op on the second delivery.
// =============================================================================
model StripeWebhookEvent {
  eventId          String    @id @map("event_id")
  eventType        String    @map("event_type")
  payloadHash      String    @map("payload_hash")
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  // 'pending' | 'processed' | 'failed'. failed means the handler
  // threw; we keep the row so retry deliveries are still no-ops.
  status           String    @default("pending")
  errorMessage     String?   @map("error_message")
  // 'subscription' | 'invoice' | 'ignored' — what the event mutated.
  appliedTo        String?   @map("applied_to")
  stripeApiVersion String?   @map("stripe_api_version")

  @@index([status])
  @@index([receivedAt])
}

// =============================================================================
// KAIA-2103 — Password reset tokens for client portal users.
// Supports forgot-password + reset-password flow via time-limited tokens.
// Tokens are single-use; once consumed they cannot be reused.
// =============================================================================
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
}

// One row per T+N event the n8n flow emits (T+0, T+3, T+7, T+14, …).
// Drives the portal onboarding timeline.
//
// Idempotency: the unique constraint on (clientId, milestone) makes the
// portal's POST /api/internal/activity endpoint a true upsert. n8n flows
// can re-run freely; the second write collapses to a no-op. The
// (clientId, milestone) pair is the natural business key — there is at
// most one row per T+N milestone per client.
model ChatbotActivity {
  id          String        @id @default(cuid())
  clientId    String
  // KAIA-4258: tenant isolation FK (denormalized from ChatbotClient for query
  // plans that filter by tenant_id directly without a join). NULL for
  // pre-multi-tenant rows; the backfill migration sets it from
  // ChatbotClient.tenantId.
  tenantId    String?       @map("tenant_id") @db.Uuid
  // WP-14 — which product's onboarding this milestone belongs to. Was
  // implicitly "the chatbot's" (the unique key was (clientId, milestone),
  // so a client could only ever have one "T+0" total). Defaults to
  // 'chatbot' at the DB level for the same reason ChatbotConfigStep's
  // productCode does — see that column's comment.
  productCode String        @default("chatbot")
  // T+N milestone label — "T+0", "T+3", "T+7", "T+14" by convention; free-form
  // string so n8n can extend without a schema migration. Enforced allowlist
  // lives in the route handler at src/app/api/internal/activity/route.ts.
  milestone   String
  // NULL when the row is created up-front (e.g. the schedule); set when the
  // event actually fires.
  completedAt DateTime?
  notes       String?
  client      ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([clientId, productCode, milestone])
  @@index([clientId, completedAt])
  @@index([clientId, productCode])
  @@index([tenantId])
}

// One row per chatbot conversation. Read-only on the portal in v1
// (writes come from the chatbot platform via n8n).
model ChatbotConversation {
  id                String        @id @default(cuid())
  clientId          String
  // KAIA-4258: tenant isolation FK (denormalized from ChatbotClient for
  // query plans that filter by tenant_id directly). NULL for
  // pre-multi-tenant rows; the backfill migration sets it.
  tenantId          String?       @map("tenant_id") @db.Uuid
  startedAt         DateTime
  // Duration in seconds. NULL while the conversation is still open.
  duration          Int?
  // Outcome / resolution status. Free-form string so the chatbot platform
  // can extend without a schema migration. Conventional values:
  //   resolved | escalated | abandoned | fallback | unknown
  outcome           String?
  // Full transcript as JSON — message list, metadata, tool calls, etc.
  transcript        Json?
  // Canales Fase 4 — the widget/n8n side's own session identifier
  // (crypto-random, generated client-side per pageview). Lets
  // POST /api/internal/channels/web/message upsert one row per session
  // instead of creating a new row per turn — NULL for every
  // pre-Fase-4 row (Telegram/WhatsApp conversations, seed data), which
  // is fine since Postgres treats NULL as distinct in a unique index.
  externalSessionId String?       @map("external_session_id")
  client            ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant            Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  leads             Lead[]

  @@unique([clientId, externalSessionId])
  @@index([clientId, startedAt])
  @@index([clientId, outcome])
  @@index([tenantId])
}

// =============================================================================
// KAIA-1163 — Wizard configuration step. One row per (client, stepKey, version).
// The wizard creates version=1 on first save; subsequent edits increment version.
// The bot always reads the row where activeForBot=true for a given (clientId,
// stepKey). The operator approves a version, which sets activeForBot=true on the
// new version and false on the previous one.
//
// Status lifecycle (enforced server-side):
//   draft → submitted → approved  (forward)
//         → needs_revision ←       (operator can flip back)
//
// KAIA-1261 (BE-1 v1) extends this with:
//   * `revisionComment` — denormalized latest operator reason when the step
//     was sent to needs_revision. The audit table remains the source of
//     truth for history; this column makes the portal GET a single round
//     trip. Added in
//     20260615010000_chatbot_config_step_v1_addendum/migration.sql.
//   * A DB-level partial UNIQUE constraint on (clientId, stepKey) WHERE
//     activeForBot = true. Prisma cannot model partial uniques natively,
//     so the @@index below is a planning hint and the actual constraint
//     lives in raw SQL. The bot config loader relies on this invariant;
//     duplicate actives are a 23505 unique_violation in the API layer.
// =============================================================================

model ChatbotConfigStep {
  id                   String    @id @default(cuid())
  clientId             String
  // KAIA-4258: tenant isolation FK (denormalized from ChatbotClient for
  // query plans that filter by tenant_id directly). NULL for
  // pre-multi-tenant rows; the backfill migration sets it.
  tenantId             String?   @map("tenant_id") @db.Uuid
  // WP-13 — which Kairikos product this step belongs to: 'chatbot' |
  // 'web' | 'captacion' | 'seo' | 'resenas' (matches Product.code). The
  // DB keeps a DEFAULT so a write that forgets to pass it lands on the
  // right product instead of failing outright — but application code
  // never relies on that default: every wizard-client.ts /
  // wizard-tier-prisma.ts function takes productCode as a required
  // parameter (no default value), so the compiler flags every call
  // site. Today every real caller passes 'chatbot' — the wizard UI has
  // no multi-product routing yet (that's WP-16) — but the (clientId,
  // productCode, stepKey, version) key below is already correct for
  // when it does.
  productCode          String    @default("chatbot")
  // Step identifier: "1" through "12" (Steps 1-10 + 11 Pruebas + 12 Integraciones).
  // Enforced server-side via a per-step Zod schema registry.
  stepKey              String
  // Monotonically increasing per (clientId, stepKey). Starts at 1.
  version              Int       @default(1)
  // 'draft' | 'submitted' | 'approved' | 'needs_revision'. Enforced server-side.
  status               String    @default("draft")
  // Opaque JSON blob — the wizard stores the step's form fields here as a flat
  // JSON object. v1: plaintext values. v1.1: ciphertext + envelope metadata.
  // Prisma maps Json to PostgreSQL JSONB.
  payload              Json?
  // Set when the client clicks "Submit for review" on this step.
  submittedAt          DateTime?
  // Set when the operator approves this version.
  approvedAt           DateTime?
  // Operator who approved this version (FK to Operator, nullable until approved).
  approvedByOperatorId String?   @db.Uuid
  // Exactly one row per (clientId, productCode, stepKey) has
  // activeForBot=true at any time. The bot's config-loader reads the
  // active version when constructing prompts. The DB-level invariant is
  // enforced by a partial UNIQUE index — see
  // 20260615010000_chatbot_config_step_v1_addendum/migration.sql
  // (originally (clientId, stepKey); repointed to include productCode by
  // 20260814100000_config_step_product_scope/migration.sql). Prisma
  // cannot model partial uniques natively, so the @@index below is a
  // query planning hint and the actual constraint lives in raw SQL.
  activeForBot         Boolean   @default(false)
  // Latest operator reason when the step was sent to needs_revision
  // (KAIA-1261 / BE-1 v1). Denormalized from the most recent
  // ChatbotConfigStepAudit row with action=request_revision so the
  // portal GET can render the operator's note in a single round trip.
  // The audit table remains the source of truth for history.
  revisionComment      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client     ChatbotClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  approvedBy Operator?                @relation(fields: [approvedByOperatorId], references: [id], onDelete: SetNull)
  tenant     Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  auditLogs  ChatbotConfigStepAudit[]

  @@unique([clientId, productCode, stepKey, version])
  @@index([clientId, stepKey])
  @@index([clientId, stepKey, activeForBot])
  @@index([clientId, productCode, stepKey])
  @@index([clientId, status])
  @@index([tenantId])
}

// Immutable (append-only) audit log for ChatbotConfigStep changes.
// Enforced at the application layer: the wizard API only exposes create
// (insert-only via the PATCH route handler). One row per discrete event:
// edit, submit, approve, request_revision, activate, deactivate.
model ChatbotConfigStepAudit {
  id        String   @id @default(cuid())
  stepId    String
  // KAIA-4258: tenant isolation FK (denormalized from the parent
  // ChatbotConfigStep so audit-list queries can filter by tenant_id
  // without joining the config step). NULL for pre-multi-tenant rows;
  // the backfill migration sets it.
  tenantId  String?  @map("tenant_id") @db.Uuid
  // Denormalized version at the time of the event so the audit trail is
  // meaningful even if versions are later cleaned up.
  version   Int
  // 'client' | 'operator' | 'system'. Enforced server-side.
  actor     String
  // Email or operator UUID — whichever identifies the actor. Null for 'system' events.
  actorId   String?
  // 'edit' | 'submit' | 'approve' | 'request_revision' | 'activate' | 'deactivate'.
  // Enforced server-side.
  action    String
  // Optional free-text reason (operator's review note, system trigger name, etc.).
  comment   String?
  createdAt DateTime @default(now())

  step   ChatbotConfigStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  tenant Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([stepId])
  @@index([stepId, createdAt])
  @@index([actor])
  @@index([action])
  @@index([tenantId])
}

// =============================================================================
// KAIA-1106 — Tool-integration settings. One row per external tool/service
// that the Kairikos operator portal integrates with (Resend, n8n, Supabase,
// Stripe, etc.). Stores the *reference* to where the secret lives (1Password)
// and operational metadata (last rotation, health status) but NEVER the
// secret value itself — those live in 1Password (CEO decision, KAIA-1058).
//
// API read/write: KAIA-1084  |  Rotate worker: KAIA-1083
// Health probes:  KAIA-1085  |  Frontend:      KAIA-1086
// =============================================================================
model OperatorSettings {
  id                   String    @id @default(uuid()) @db.Uuid
  // Stable identifier used in code and API routes. Never changes after creation.
  // Known values: 'resend', 'n8n', 'supabase', 'portal_api_key', 'postgres_password'
  toolKey              String    @unique
  // Human label shown in the settings UI (e.g. "Resend", "n8n", "Supabase").
  displayName          String
  // Category for dashboard grouping: 'email' | 'workflow' | 'database' | 'auth' | 'billing' | 'other'
  category             String
  // The env var that holds the secret value (nullable — some tools don't use one).
  envVarName           String?
  // 1Password reference path: op://Vault/Item/Field. Never the actual secret value.
  secretManagerRef     String
  // Last successful rotation timestamp (set by the rotate worker, KAIA-1083).
  lastRotatedAt        DateTime?
  // Last health-check timestamp (set by the health probe worker, KAIA-1085).
  lastHealthCheckAt    DateTime?
  // Most recent health status: 'healthy' | 'degraded' | 'failed' | 'unknown'
  lastHealthStatus     String    @default("unknown")
  // Days after which a rotation reminder badge appears (default 90).
  rotationReminderDays Int       @default(90)
  // Free-text notes from the operator.
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  auditLogs OperatorSettingsAudit[]

  @@index([category])
  @@index([lastHealthStatus, lastHealthCheckAt])
}

// Immutable (append-only) audit log for OperatorSettings changes.
// Enforced at the application layer: the helper module in
// src/lib/operator-settings.ts only exposes create — never update or delete.
// One row per discrete event: creation, field update, rotation request,
// rotation result, health status change, or deletion.
model OperatorSettingsAudit {
  id              String   @id @default(uuid()) @db.Uuid
  settingsId      String   @db.Uuid
  // FK to the future Operator identity model (KAIA-1082).
  // Nullable until KAIA-1082 lands; after that, this becomes required.
  actorOperatorId String?  @db.Uuid
  // Denormalized at write-time so the audit trail is meaningful even if
  // the operator is later removed from the DB.
  actorEmail      String?
  // Event type: 'created' | 'updated' | 'rotation_requested' | 'rotation_succeeded'
  // | 'rotation_failed' | 'health_status_changed' | 'deleted'
  action          String
  // Row snapshot before the change (omit secret values — only schema refs).
  before          Json?
  // Row snapshot after the change.
  after           Json?
  // Free-form metadata: request_id, user_agent, IP, TOTP-verified flag, etc.
  metadata        Json?
  createdAt       DateTime @default(now())

  operatorSettings OperatorSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  operator         Operator?        @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([settingsId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// KAIA-13281 — Operator action audit log for the admin editor mode.
//
// One row per field-level change an operator makes to a ChatbotClient via
// PATCH /api/admin/portal/clients/[clientId]. The route handler writes
// the ChatbotClient update + one OperatorAction row per changed field in
// a single Prisma `$transaction` so the audit trail and the live data
// cannot drift.
//
// Append-only at the application layer: the route only ever issues
// INSERT against this table (same enforcement pattern as
// ChatbotConfigStepAudit and OperatorSettingsAudit).
//
// actorId is the operator's email (or user id when the future
// Operator identity model becomes required). actorType defaults to
// 'operator' so future non-operator actors (e.g. system reaper) can be
// tagged without a schema migration.
// =============================================================================

model OperatorAction {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  // 'operator' (default). Free-form so future actor kinds can land
  // without a migration; enforced at the route layer.
  actorType   String   @default("operator") @map("actor_type")
  // Operator email or user id. Free-form string — v1 reads from the
  // NextAuth session; once Operator identity is required (KAIA-1082),
  // this should switch to a FK to Operator.id.
  actorId     String   @map("actor_id")
  // Field name that changed (one of the route allowlist). Enforced
  // server-side; not DB-constrained so future field names can land
  // without a migration.
  field       String
  beforeValue String?  @map("before_value")
  afterValue  String?  @map("after_value")
  createdAt   DateTime @default(now()) @map("created_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([field])
}

// =============================================================================
// NextAuth.js v5 (KAIA-753) — required by @auth/prisma-adapter.
// We run with JWT session strategy (no DB-backed sessions), so the Session
// model is unused at runtime, but the adapter still requires the model to
// exist in the schema. The VerificationToken model is the hot path for the
// Resend magic-link provider: one row per email send, deleted on click.
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// WP-21 — a client's own Google Business Profile, connected via OAuth so
// WP-22 can sync/reply to reviews on their behalf. Deliberately separate
// from the GOOGLE_OAUTH_CLIENT_ID/SECRET used by lib/google-drive.ts
// (KAIA-2913): that integration authorizes Kairikos's OWN Google account
// for internal Drive provisioning with one static refresh token; this one
// authorizes each CLIENT's Google account, one row per connected
// location, via its own OAuth client (scope: business.manage) so the two
// consent screens and credential sets never mix.
//
// The refresh token is the highest-value secret this schema stores after
// Stripe's own credentials — it grants ongoing API access to the client's
// real Google Business listing. It is never stored as plaintext or as a
// single opaque string: ciphertext/iv/tag are separate Bytes columns,
// encrypted with AES-256-GCM via the generic encryptBuffer/decryptBuffer
// primitives in lib/operator-crypto.ts (a DIFFERENT key,
// GOOGLE_TOKEN_ENCRYPTION_KEY, from the one guarding operator TOTP
// secrets — different secret classes should never share key material).
//
// `status`: 'active' | 'needs_reconnect' (refresh failed — Google
// revoked/expired it; surfaced in the portal as a degraded state with a
// reconnect prompt) | 'revoked' (the client disconnected from Kairikos's
// side; the row is kept, not hard-deleted, so sync history and the
// disconnect itself stay auditable).
model GoogleBusinessConnection {
  id                          String    @id @default(uuid()) @db.Uuid
  clientId                    String    @map("client_id")
  tenantId                    String    @map("tenant_id") @db.Uuid
  googleAccountId             String    @map("google_account_id")
  locationId                  String    @map("location_id")
  locationName                String    @map("location_name")
  refreshTokenCiphertext      Bytes     @map("refresh_token_ciphertext")
  refreshTokenIv              Bytes     @map("refresh_token_iv")
  refreshTokenTag             Bytes     @map("refresh_token_tag")
  scopes                      String[]
  status                      String    @default("active")
  connectedAt                 DateTime  @default(now()) @map("connected_at")
  lastSyncAt                  DateTime? @map("last_sync_at")
  lastSyncError               String?   @map("last_sync_error")
  // WP-22b — Google's own "leave a review" link for this location
  // (Business Information API's Location.metadata.newReviewUri).
  // Fetched lazily on first campaign creation and cached here — it does
  // not change for a given location, so there is no reason to re-fetch
  // it on every campaign.
  reviewUrl                   String?   @map("review_url")
  // WP-22c — when true, google-review-sync.ts publishes an AI-drafted
  // reply to a newly-synced review with no reply yet, with no human
  // approval step. Off by default (the AC's "salvo que el cliente
  // active lo contrario") — this pair of columns IS the audit trail the
  // AC requires ("queda auditado con quién y cuándo lo cambió"): who
  // last flipped the setting and when, not a full change history table,
  // which is more than a single boolean toggle needs.
  autoPublishReplies          Boolean   @default(false) @map("auto_publish_replies")
  autoPublishRepliesChangedBy String?   @map("auto_publish_replies_changed_by")
  autoPublishRepliesChangedAt DateTime? @map("auto_publish_replies_changed_at")

  client              ChatbotClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reviews             GoogleReview[]
  campaigns           ReviewRequestCampaign[]
  recallSubscriptions RecallSubscription[]

  @@unique([clientId, locationId])
  @@index([tenantId])
  @@index([status])
}

// =============================================================================
// SEO con IA, Fase B — a client's own Google account, connected via OAuth
// so the portal can read Search Console data (rankings, impressions,
// clicks, indexing status) for their site. Deliberately a SEPARATE OAuth
// client (GOOGLE_SEO_OAUTH_CLIENT_ID/SECRET) from GoogleBusinessConnection's
// business.manage scope above — different consent purpose, different
// scope class, same "one OAuth client per integration purpose"
// convention already established for every Google integration in this
// schema (see that model's own comment for why).
//
// One row per client (@@unique([clientId])) — unlike
// GoogleBusinessConnection's per-location cardinality, a client has one
// website, not several locations to pick from.
//
// v1 covers Search Console only. searchConsoleSiteUrl is the matched
// VERIFIED property from the connected account — 'https://example.com/'
// (URL-prefix) or 'sc-domain:example.com' (Domain) format, whichever
// Search Console returned as the match against SeoProfile.siteUrl; the
// OAuth callback route redirects with an error rather than guessing when
// no verified property matches. Analytics (GA4) needs its own
// property-picker UI — a GA4 property is a numeric id with a display
// name, not reliably URL-matchable the way a Search Console property is
// — deferred to a later piece, not this one.
//
// Same encryption posture as GoogleBusinessConnection: AES-256-GCM,
// ciphertext/iv/tag as separate Bytes columns, its own dedicated key
// (GOOGLE_SEO_TOKEN_ENCRYPTION_KEY — never shared with
// GOOGLE_TOKEN_ENCRYPTION_KEY, different secret classes).
//
// `status`: 'active' | 'needs_reconnect' | 'revoked' — same three-value
// vocabulary and meaning as GoogleBusinessConnection's.
// =============================================================================
model GoogleSeoConnection {
  id                     String    @id @default(uuid()) @db.Uuid
  clientId               String    @unique @map("client_id")
  tenantId               String    @map("tenant_id") @db.Uuid
  googleAccountEmail     String?   @map("google_account_email")
  searchConsoleSiteUrl   String    @map("search_console_site_url")
  refreshTokenCiphertext Bytes     @map("refresh_token_ciphertext")
  refreshTokenIv         Bytes     @map("refresh_token_iv")
  refreshTokenTag        Bytes     @map("refresh_token_tag")
  scopes                 String[]
  status                 String    @default("active")
  connectedAt            DateTime  @default(now()) @map("connected_at")
  lastSyncAt             DateTime? @map("last_sync_at")
  lastSyncError          String?   @map("last_sync_error")

  client  ChatbotClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  metrics SeoSearchConsoleMetric[]

  @@index([tenantId])
  @@index([status])
}

// =============================================================================
// SEO con IA, Fase B — one row per DAY of site-wide Search Console
// performance for a connected property, synced by
// lib/seo-search-console-sync.ts. Unlike GoogleBusinessConnection's
// "current state only" fields, the client report page needs an actual
// trend (clicks/impressions over time — see GoogleSeoConnection's own
// schema comment on why this product's report is a chart, not a list),
// so this is genuinely a time-series table, not a latest-snapshot
// column.
//
// `date` + `connectionId` is the idempotency key: a re-sync of an
// already-synced day always upserts the same row rather than
// duplicating it — necessary because Search Console data for a given
// day keeps getting revised for a few days after it first appears
// (documented ~2-3 day processing lag), so every sync re-fetches a
// rolling window and overwrites, rather than only fetching "new" days.
model SeoSearchConsoleMetric {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  clientId     String   @map("client_id")
  date         DateTime @db.Date
  clicks       Int
  impressions  Int
  ctr          Float
  position     Float
  syncedAt     DateTime @default(now()) @map("synced_at")

  connection GoogleSeoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, date])
  @@index([clientId])
}

// =============================================================================
// WP-22a — one row per review synced from a client's connected Google
// Business Profile location (GoogleBusinessConnection, WP-21).
//
// `googleReviewId` stores the review's full Google resource name
// ("accounts/.../locations/.../reviews/...") rather than the bare
// reviewId — the resource name is guaranteed globally unique the same
// way GoogleBusinessConnection's locationId already is, whereas a bare
// reviewId's uniqueness scope is not documented by Google. It is the
// idempotency key: syncReviewsForConnection always upserts on it, so a
// retried or overlapping sync run can never create a duplicate row.
model GoogleReview {
  id             String    @id @default(uuid()) @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  clientId       String    @map("client_id")
  tenantId       String    @map("tenant_id") @db.Uuid
  googleReviewId String    @unique @map("google_review_id")
  reviewerName   String?   @map("reviewer_name")
  // 1-5. Google's API returns an enum string (ONE..FIVE) — mapped to an
  // int at the sync boundary (see google-review-sync.ts) so every
  // consumer downstream (sorting, averages) works with a plain number.
  starRating     Int       @map("star_rating")
  comment        String?
  createTime     DateTime  @map("create_time")
  updateTime     DateTime  @map("update_time")
  // The PUBLISHED reply, as last synced FROM Google — read-only,
  // written only by google-review-sync.ts.
  replyComment   String?   @map("reply_comment")
  replyUpdatedAt DateTime? @map("reply_updated_at")
  syncedAt       DateTime  @default(now()) @map("synced_at")

  // WP-22c — an AI-generated reply the client hasn't published yet.
  // Deliberately separate from replyComment/replyUpdatedAt above: those
  // two only ever reflect what Google reports as actually live. A draft
  // here is not published anywhere until the publish route sends it and
  // stamps replyPublishedAt.
  aiDraftReply       String?   @map("ai_draft_reply")
  aiDraftGeneratedAt DateTime? @map("ai_draft_generated_at")
  // 'client:<clientId>' for a human approval, 'auto' when
  // autoPublishReplies published it without a human in the loop — the
  // AC's "si fue auto-publicada" audit trail.
  replyApprovedBy    String?   @map("reply_approved_by")
  replyApprovedAt    DateTime? @map("reply_approved_at")
  replyPublishedAt   DateTime? @map("reply_published_at")

  connection GoogleBusinessConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  client     ChatbotClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([connectionId])
  @@index([clientId])
  @@index([starRating])
}

// =============================================================================
// WP-22b — a batch of review-request invitations for one connected
// location. AC: "la misma invitación se envía a todos los clientes por
// igual" — there is deliberately no field anywhere on these two models
// for a customer's satisfaction/experience rating. Review gating (asking
// first, routing only happy customers to the public review link)
// violates Google's policies; nothing in this schema makes it
// expressible.
model ReviewRequestCampaign {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  clientId     String   @map("client_id")
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  // 'active' | 'paused'.
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  connection GoogleBusinessConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  client     ChatbotClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requests   ReviewRequest[]

  @@index([clientId])
  @@index([connectionId])
}

// One row per invited recipient. `channel` is a free string so a future
// 'sms' implementation needs no schema change — WP-22b only implements
// 'email' (this codebase has no SMS provider integrated anywhere yet).
model ReviewRequest {
  id              String    @id @default(uuid()) @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  channel         String    @default("email")
  recipient       String
  recipientName   String?   @map("recipient_name")
  // Legal basis for contacting this recipient — set once per campaign,
  // applied uniformly to every request in it (same "no per-recipient
  // discrimination" principle as the review-gating constraint above).
  consentBasis    String    @map("consent_basis")
  // 'pending' | 'sent' | 'failed'. A retry (see
  // review-request-campaign.ts's retryFailedRequests) only ever touches
  // 'failed' rows — an already-'sent' request is never re-sent.
  status          String    @default("pending")
  resendMessageId String?   @map("resend_message_id")
  sendError       String?   @map("send_error")
  sentAt          DateTime? @map("sent_at")
  // Set the first time GET /r/[requestId] is visited — the AC's
  // "conversion rate" measure. Never records anything about the review
  // itself, only that the link was opened.
  clickedAt       DateTime? @map("clicked_at")
  // WP-XX (Fase 10) — the ONE follow-up a recipient ever gets, four days
  // later, and only if they never opened the link. Its presence is what
  // makes a second reminder impossible to send: there is nowhere to
  // record one, so no code path can invent it.
  remindedAt      DateTime? @map("reminded_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  campaign ReviewRequestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipient])
  @@index([campaignId])
  @@index([status])
}

// =============================================================================
// Web brief — the 'web' product's own, standalone intake form. Deliberately
// NOT built on the chatbot's wizard engine (ChatbotConfigStep +
// wizard-visibility.ts's tier-aware step catalog): that machinery is
// hardcoded to chatbot in ~22 call sites across API routes and lib
// functions, and generalizing it for every product is its own large,
// higher-risk refactor of a system already in production. Web is also a
// fundamentally different shape of product — a one-time delivery (799€
// setup fee, no recurring price — see the 'web' Product row), not an
// ongoing service the client reconfigures — so a single-shot brief fits
// better than a multi-step, tier-aware, per-step-audited wizard anyway.
//
// WP-XX — one brief per PROJECT (ClientProduct row), not per client: a
// client can have multiple independent 'web' engagements (see
// ClientProduct's comment), each with its own brief. `clientId` stays as a
// denormalized, non-unique column for convenient client-scoped queries;
// `clientProductId` is the real 1:1 key.
// =============================================================================
model WebBrief {
  id              String  @id @default(cuid())
  clientId        String  @map("client_id")
  clientProductId String  @unique @map("client_product_id") @db.Uuid
  tenantId        String? @map("tenant_id") @db.Uuid

  // 'draft' | 'submitted'. Resubmitting after 'submitted' is allowed
  // (upsert, no hard server-side lock) — the client can always send
  // Kairikos their latest answers; the portal UI just shows a read-only
  // summary instead of the form once submitted, with an explicit
  // "editar respuestas" action to reopen it.
  status String @default("draft")

  businessName   String? @map("business_name")
  vertical       String?
  // Objetivo principal del sitio: 'vender' | 'leads' | 'informar' |
  // 'reservas' | 'otro'. Free-form string, not an enum — same
  // convention as the rest of this schema's status/state columns
  // (enforced server-side via Zod, not the DB).
  goal           String?
  targetAudience String? @map("target_audience")

  hasExistingBrand Boolean? @map("has_existing_brand")
  brandAssetsNote  String?  @map("brand_assets_note")

  // string[] — which pages the client wants (Inicio, Servicios, etc.)
  pagesNeeded    Json?   @map("pages_needed")
  otherPagesNote String? @map("other_pages_note")

  // 'cliente' | 'kairikos' | 'mixto' — who writes the page copy.
  contentProvidedBy String? @map("content_provided_by")

  desiredDomain     String? @map("desired_domain")
  referenceWebsites String? @map("reference_websites")

  // string[] — WhatsApp, Calendario de citas, CRM, Formulario, Pagos, etc.
  integrationsNeeded    Json?   @map("integrations_needed")
  otherIntegrationsNote String? @map("other_integrations_note")

  additionalNotes String?   @map("additional_notes")
  submittedAt     DateTime? @map("submitted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  client        ChatbotClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientProduct ClientProduct   @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  auditLogs     WebBriefAudit[]

  @@index([clientId])
  @@index([tenantId])
}

// Append-only audit trail for WebBrief edits — mirrors WebQuoteAudit
// exactly (before/after JSON, write-only, no UI viewer — see that model's
// comment). Exists so an operator can show a client exactly what a brief
// said on a given date if they later dispute work done against an
// earlier version (the brief route itself never locks or blocks edits).
model WebBriefAudit {
  id         String @id @default(uuid()) @db.Uuid
  // WebBrief.id is a cuid (String), not a uuid — no @db.Uuid here.
  webBriefId String @map("web_brief_id")
  clientId   String @map("client_id")
  // 'draft_saved' | 'submitted'
  action     String
  before     Json?
  after      Json?

  // 'client' | 'operator' | 'system' — always 'client' today, the brief
  // has no operator-edit path, but this mirrors WebQuoteAudit's shape in
  // case that ever changes.
  actorType  String  @default("client") @map("actor_type")
  actorEmail String? @map("actor_email")

  createdAt DateTime @default(now()) @map("created_at")

  webBrief WebBrief @relation(fields: [webBriefId], references: [id], onDelete: Cascade)

  @@index([webBriefId])
  @@index([createdAt])
}

// =============================================================================
// Stripe operator credentials — the Secret Key an operator pastes into
// /admin/portal/settings/billing so the app can create/reprice Stripe
// Products and Prices on their behalf, instead of doing it by hand in
// the Stripe Dashboard. Encrypted at rest (AES-256-GCM, same pattern as
// GoogleBusinessConnection.refreshToken* — see src/lib/operator-crypto.ts's
// encryptBuffer/decryptBuffer), with a DEDICATED encryption key
// (STRIPE_CREDENTIAL_ENCRYPTION_KEY) — never shared with the key used
// for TOTP secrets or Google refresh tokens.
//
// Singleton row (see STRIPE_CREDENTIAL_SINGLETON_ID in
// stripe-credentials.ts) rather than one row per mode: there is only
// ever one "which mode is active" concept in the whole app, so it lives
// as a single column here instead of needing a second table (or a
// unique-partial-index trick) just to enforce "at most one row per
// mode, exactly one active". Test and live keys are stored side by
// side so switching activeMode back and forth never requires
// re-pasting a key.
model StripeOperatorCredential {
  id         String  @id @default(uuid()) @db.Uuid
  // 'test' | 'live' | NULL — NULL means a key may already be saved
  // below but no mode has been explicitly activated yet, so
  // resolveActiveStripeSecret() falls back to STRIPE_SECRET_KEY (env).
  activeMode String? @map("active_mode")

  testSecretKeyCiphertext Bytes?    @map("test_secret_key_ciphertext")
  testSecretKeyIv         Bytes?    @map("test_secret_key_iv")
  testSecretKeyTag        Bytes?    @map("test_secret_key_tag")
  // Last 4 chars of the key in cleartext (e.g. "aBcD" from
  // sk_test_...aBcD) — lets the UI show "•••• aBcD" without a decrypt.
  testSecretKeyLastFour   String?   @map("test_secret_key_last_four")
  testSavedAt             DateTime? @map("test_saved_at")

  liveSecretKeyCiphertext Bytes?    @map("live_secret_key_ciphertext")
  liveSecretKeyIv         Bytes?    @map("live_secret_key_iv")
  liveSecretKeyTag        Bytes?    @map("live_secret_key_tag")
  liveSecretKeyLastFour   String?   @map("live_secret_key_last_four")
  liveSavedAt             DateTime? @map("live_saved_at")

  updatedAt DateTime @updatedAt @map("updated_at")
}

// Append-only audit trail for (a) saving/rotating a Stripe credential and
// (b) catalog price bootstrap/reprice events. Styled after
// OperatorSettingsAudit (before/after JSON snapshots, denormalized
// actor) rather than reusing that model directly — OperatorSettings
// assumes secrets live in 1Password/env vars (secretManagerRef), which
// doesn't apply to a key encrypted in this database. `before`/`after`
// must NEVER contain the plaintext key or ciphertext — only
// non-sensitive fields (mode, lastFour, priceCents, setupFeeCents,
// stripeProductId, stripe*PriceId).
model StripeCatalogAudit {
  id        String  @id @default(uuid()) @db.Uuid
  // NULL for credential-only events (save/rotate/active-mode-change),
  // set for catalog events (bootstrap/reprice/archive-failed).
  productId String? @map("product_id") @db.Uuid
  // 'credential_saved' | 'credential_rotated' | 'active_mode_changed'
  // | 'price_bootstrap_created' | 'price_repriced'
  // | 'price_archive_failed' | 'reconciled_after_partial_failure'
  action    String
  before    Json?
  after     Json?

  actorOperatorId String?  @map("actor_operator_id") @db.Uuid
  actorEmail      String?  @map("actor_email")
  // { ip, userAgent, totpVerifiedAt, ... } — free-form, non-sensitive.
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  operator Operator? @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// Generic encrypted credential storage for the operator's own third-party
// API keys, shown at /admin/portal/settings/integrations — first user is
// GOOGLE_PLACES_API_KEY ('prospecting'). Same encrypted-in-DB pattern as
// StripeOperatorCredential above (AES-256-GCM, src/lib/operator-crypto.ts),
// with its OWN dedicated encryption key (INTEGRATION_CREDENTIAL_ENCRYPTION_KEY)
// — never shared with Stripe's or any other *_ENCRYPTION_KEY.
//
// Deliberately NOT the same model as OperatorSettings (KAIA-1106): that one
// assumes secrets live in 1Password/env vars and stores only a reference —
// it was built but never wired to a route or UI, and repurposing it to hold
// an actual secret value would contradict its own documented design. One
// row per `toolKey` ('google_places', and whatever integration comes next)
// rather than one dedicated model per integration — a single simple API
// key doesn't need Stripe's test/live-mode duality, so a generic row is
// enough; a future integration with more structure can still get its own
// dedicated model rather than being forced into this shape.
model IntegrationCredential {
  id          String @id @default(uuid()) @db.Uuid
  // Stable key used in code and API routes, e.g. 'google_places'. Never
  // changes after creation.
  toolKey     String @unique @map("tool_key")
  // Human label for the settings UI, e.g. "Google Places".
  displayName String @map("display_name")

  secretCiphertext Bytes @map("secret_ciphertext")
  secretIv         Bytes @map("secret_iv")
  secretTag        Bytes @map("secret_tag")
  // Last 4 chars in cleartext — lets the UI show "•••• aBcD" without a
  // decrypt, same as StripeOperatorCredential.testSecretKeyLastFour.
  secretLastFour   String @map("secret_last_four")

  savedAt   DateTime @map("saved_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  auditLogs IntegrationCredentialAudit[]
}

// Append-only. before/after must NEVER contain the plaintext key or
// ciphertext — only non-sensitive fields (toolKey, lastFour, configured).
model IntegrationCredentialAudit {
  id           String @id @default(uuid()) @db.Uuid
  credentialId String @map("credential_id") @db.Uuid
  toolKey      String @map("tool_key")
  // 'credential_saved' | 'credential_rotated'
  action       String
  before       Json?
  after        Json?

  actorOperatorId String?  @map("actor_operator_id") @db.Uuid
  actorEmail      String?  @map("actor_email")
  createdAt       DateTime @default(now()) @map("created_at")

  credential IntegrationCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  operator   Operator?             @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([credentialId])
  @@index([toolKey])
  @@index([createdAt])
}

// =============================================================================
// WP-XX — custom-quote billing for 'web'. Replaces the fixed-price
// (799€) self-serve purchase: the client requests 'web' for free
// (ClientProduct.status='quote_pending'), fills in WebBrief, an operator
// prices the project and sends a quote, the client accepts it, the
// operator confirms by generating a Stripe invoice, and the client pays
// — online, or the operator marks it paid manually (transfer/cash,
// channel+reference — see Invoice.paymentChannel above).
//
// 1:1 with ClientProduct (@unique clientProductId), same shape as
// Subscription — only one "live" quote per client at a time. Reusing
// the row across a cancel→retry cycle (rather than creating a new one)
// is intentional: the full history survives in WebQuoteAudit regardless.
//
// Status machine (enforced server-side in src/lib/web-quotes.ts, not a
// DB constraint — same convention as every other status column here):
//   draft → sent → accepted → invoiced → paid              (no deposit)
//   accepted → invoiced_deposit → deposit_paid →
//     invoiced_final → paid                                (with depositCents set)
//   draft/sent/accepted → cancelled                         (operator aborts, no Stripe)
//   invoiced/invoiced_deposit/invoiced_final → cancelled    (voidInvoice, see
//     canVoidInvoice in web-quotes.ts — only while the current invoice is
//     unpaid; once a deposit or the full amount is paid there is no
//     cancel path, a refund would be needed and is out of scope)
//   cancelled → draft                                       (reset, reuses the row)
// =============================================================================
model WebQuote {
  id              String  @id @default(uuid()) @db.Uuid
  clientId        String  @map("client_id")
  // 1:1 — mirrors Subscription.clientProductId. Only one live quote per
  // ClientProduct at a time.
  clientProductId String  @unique @map("client_product_id") @db.Uuid
  tenantId        String? @map("tenant_id") @db.Uuid

  status String @default("draft")

  amountCents  Int    @map("amount_cents")
  // Optional advance/deposit — when set, billing splits into a deposit
  // invoice (amountCents - depositCents left as the final balance) instead
  // of a single invoice for the full amount. Null preserves today's
  // single-payment behavior unchanged. Operator-entered free amount, not a
  // fixed percentage — every quote here is already custom-priced.
  depositCents Int?   @map("deposit_cents")
  currency     String @default("eur")
  // Free text the CLIENT sees verbatim — what this quote covers.
  description  String

  createdByOperatorId String?   @map("created_by_operator_id") @db.Uuid
  sentAt              DateTime? @map("sent_at")
  sentByOperatorId    String?   @map("sent_by_operator_id") @db.Uuid
  acceptedAt          DateTime? @map("accepted_at")
  cancelledAt         DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        ChatbotClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientProduct ClientProduct   @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy     Operator?       @relation("WebQuoteCreatedBy", fields: [createdByOperatorId], references: [id], onDelete: SetNull)
  sentBy        Operator?       @relation("WebQuoteSentBy", fields: [sentByOperatorId], references: [id], onDelete: SetNull)
  auditLogs     WebQuoteAudit[]

  @@index([clientId])
  @@index([status])
  @@index([tenantId])
}

// Append-only audit trail for WebQuote — before/after JSON because this
// tracks real money amounts, not just status strings (ClientProductAudit
// has no columns for that). Same style as StripeCatalogAudit.
model WebQuoteAudit {
  id         String @id @default(uuid()) @db.Uuid
  webQuoteId String @map("web_quote_id") @db.Uuid
  // 'created' | 'edited' | 'sent' | 'accepted' | 'cancelled' |
  // 'reset_to_draft' | 'invoiced' | 'invoiced_deposit' | 'deposit_paid' |
  // 'invoiced_final' | 'invoice_voided' | 'mark_paid_started' |
  // 'mark_paid_succeeded' | 'mark_paid_failed' | 'paid'
  action     String
  before     Json?
  after      Json?

  // 'operator' | 'client' | 'system'
  actorType       String   @default("operator") @map("actor_type")
  actorOperatorId String?  @map("actor_operator_id") @db.Uuid
  // operator email, 'client:<clientId>', or 'stripe:invoice.paid'.
  actorEmail      String?  @map("actor_email")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  webQuote WebQuote  @relation(fields: [webQuoteId], references: [id], onDelete: Cascade)
  operator Operator? @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([webQuoteId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// Canales del chatbot — instalación desde el wizard (WP: conexión de
// canales). Un modelo dedicado por tipo de conexión, mismo patrón que
// GoogleBusinessConnection (WP-21): no una tabla polimórfica genérica con
// discriminador, sino una tabla por clase de conexión, cada una con la
// forma que realmente necesita.
//
// Gating por tier: qué canales puede conectar un cliente depende de
// Product.features.channels (el tier de su ClientProduct 'chatbot'), leído
// por getAllowedChannelsForClient() en src/lib/channel-access.ts — no hay
// columna nueva para esto, se reutiliza la columna Product.features ya
// existente y sin usar.
// =============================================================================

// Canal Web — el widget embebible. publicToken NO se cifra: es un
// identificador público (se pega en HTML del cliente), no un secreto,
// igual que una clave pública de analytics.
model ChatWebEmbed {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id")
  tenantId     String?  @map("tenant_id") @db.Uuid
  publicToken  String   @unique @map("public_token")
  // 'active' | 'disabled'
  status       String   @default("disabled")
  // Apariencia del widget — configurable por el cliente, no un único
  // aspecto para todos. El copy (bienvenida/despedida/prompts) NO vive
  // acá: se lee directo de la config ya aprobada del Paso 9 del wizard,
  // para no duplicar el mismo dato en dos lugares.
  primaryColor String   @default("#0E6B5E") @map("primary_color")
  // 'bottom-right' | 'bottom-left'
  position     String   @default("bottom-right")
  createdAt    DateTime @default(now()) @map("created_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([tenantId])
}

// Canal Telegram — el cliente pega el token de un bot que él mismo creó
// vía @BotFather. Un bot por cliente en v1 (sin selector multi-cuenta).
model TelegramConnection {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String   @map("client_id")
  tenantId           String?  @map("tenant_id") @db.Uuid
  botTokenCiphertext Bytes    @map("bot_token_ciphertext")
  botTokenIv         Bytes    @map("bot_token_iv")
  botTokenTag        Bytes    @map("bot_token_tag")
  botUsername        String   @map("bot_username")
  // 'active' | 'needs_reconnect' | 'revoked'
  status             String   @default("active")
  connectedAt        DateTime @default(now()) @map("connected_at")
  lastSyncError      String?  @map("last_sync_error")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([clientId])
  @@index([tenantId])
  @@index([status])
}

// Canal Meta unificado — WhatsApp, Messenger e Instagram comparten una
// única conexión OAuth contra la cuenta de Meta Business, pero una sola
// autorización puede exponer varias superficies a la vez (varios números
// de WhatsApp, varias Páginas, varias cuentas de Instagram) — a
// diferencia de GoogleBusinessConnection, que asume una sola location.
// Por eso una fila por superficie, no una por cliente.
model MetaChannelConnection {
  id                    String   @id @default(uuid()) @db.Uuid
  clientId              String   @map("client_id")
  tenantId              String?  @map("tenant_id") @db.Uuid
  // 'whatsapp' | 'messenger' | 'instagram'
  channel               String
  // phone_number_id (whatsapp) | page_id (messenger) | ig_user_id (instagram)
  externalId            String   @map("external_id")
  // Human-readable name discovered at connect time (Page name / WABA
  // label) — externalId alone is a raw Meta id, not fit to show a client.
  label                 String?
  // whatsapp only — the WABA id. Meta's app-webhook subscription
  // (subscribed_apps) is called at the WABA level, not the phone number
  // level, so this needs its own column rather than being parsed back
  // out of `label` (which only ever held it for display). NULL for
  // messenger/instagram rows, which don't have this concept.
  wabaId                String?  @map("waba_id")
  accessTokenCiphertext Bytes    @map("access_token_ciphertext")
  accessTokenIv         Bytes    @map("access_token_iv")
  accessTokenTag        Bytes    @map("access_token_tag")
  // 'active' | 'needs_reconnect' | 'revoked'
  status                String   @default("active")
  connectedAt           DateTime @default(now()) @map("connected_at")
  lastSyncError         String?  @map("last_sync_error")

  // WP-XX — token lifecycle. Meta's long-lived tokens expire in ~60 days
  // and the exchange has always RETURNED `expires_in`, but the portal
  // discarded it: there was no column to put it in, and nothing anywhere
  // ever wrote status='needs_reconnect'. For a chatbot answering inbound
  // messages that degrades quietly; for a product that sends scheduled
  // outbound messages it is a guaranteed silent death two months after
  // every connection. NULL means "unknown" — rows connected before this
  // column existed, which are treated as needing a re-check rather than
  // assumed fine.
  tokenExpiresAt DateTime? @map("token_expires_at")
  // Set when the operator has already been told this connection is about
  // to die, so the warning is not repeated on every scheduler tick.
  expiryWarnedAt DateTime? @map("expiry_warned_at")

  // WP-XX — the business's REAL number in E.164, from
  // GET /{phone_number_id}. Previously the portal only stored
  // phone_number_id and a label of 'WhatsApp (<wabaId>)', so nobody could
  // answer "which number does this client send from". WhatsApp only.
  displayPhoneNumber String? @map("display_phone_number")
  verifiedName       String? @map("verified_name")
  // Meta's own rating of the number ('GREEN' | 'YELLOW' | 'RED'). It
  // degrades when recipients report or block the business, and a RED
  // number gets restricted — which for this product means the client
  // loses the WhatsApp they work with every day, so it is worth watching.
  qualityRating      String? @map("quality_rating")

  // Fase 8 ('recall') — Coexistence: the number was already live on the
  // client's own phone in the WhatsApp Business app, and Embedded Signup
  // linked the Cloud API alongside it instead of migrating it away. This
  // is what tells the rest of the system (n8n's activation workflow, in
  // particular) to SKIP POST /{phone_number_id}/register — Meta's docs
  // are explicit that registering an already-coexisting number is wrong,
  // not just redundant. WhatsApp only; always false for messenger/
  // instagram rows.
  isCoexistence Boolean @default(false) @map("is_coexistence")
  // Raw value of GET /{phone_number_id}?fields=platform_type
  // ('CLOUD_API' | 'ON_PREMISE' | 'NOT_APPLICABLE', per Meta). A
  // coexistence connection that comes back CLOUD_API instead of the
  // expected on-app value means the client's app-side link never
  // actually took — worth surfacing rather than assuming the popup
  // finishing was the whole story.
  platformType  String? @map("platform_type")

  client              ChatbotClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  recallSubscriptions RecallSubscription[]
  whatsappTemplates   WhatsappTemplate[]

  @@unique([clientId, channel, externalId])
  @@index([tenantId])
  @@index([status])
  @@index([channel])
  // Drives the expiry sweep: find connections due to be warned about.
  @@index([tokenExpiresAt])
}

// =============================================================================
// WP-XX — per-client registry of the WhatsApp message templates Meta has
// approved (or rejected, or paused) for a connection.
//
// PER CLIENT, not global, and that is the operationally significant part:
// with Coexistence every client keeps their own WABA, so templates are
// registered and reviewed per business. N clients means N sets of Meta
// approvals, each 1-2 days, each sitting squarely in the critical path of
// that client's alta. Modelling it makes the wait visible in the operator
// queue instead of being discovered by a send that fails.
//
// The row is a MIRROR of Meta's state, refreshed by polling
// listMessageTemplates — never the source of truth. Meta can pause a
// template for quality at any moment without telling us, which is why
// `status` here is re-synced rather than only written when we create one.
// =============================================================================
model WhatsappTemplate {
  id           String @id @default(uuid()) @db.Uuid
  clientId     String @map("client_id")
  connectionId String @map("connection_id") @db.Uuid

  // Meta's template name, e.g. 'recall_missed_call'. Unique per
  // (connection, name, language) the same way Meta scopes it.
  name         String
  languageCode String @map("language_code")

  // Meta's own id for the template, once it exists there.
  metaTemplateId String? @map("meta_template_id")

  // 'PENDING' | 'APPROVED' | 'REJECTED' | 'PAUSED' | 'DISABLED' —
  // Meta's vocabulary, uppercased as Meta returns it, so a value we do
  // not recognise still round-trips honestly instead of being coerced.
  status         String  @default("PENDING")
  category       String?
  // Meta's reason when it rejects. This is what an operator needs to fix
  // the copy and resubmit, and it is not derivable from anything else.
  rejectedReason String? @map("rejected_reason")

  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  client     ChatbotClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  connection MetaChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, name, languageCode])
  @@index([clientId])
  @@index([status])
}

// El puente hacia n8n — portal → n8n únicamente (no hay lectura directa
// de esta base desde el motor externo). connectionId es polimórfico
// (apunta a una fila de ChatWebEmbed/TelegramConnection/
// MetaChannelConnection según connectionType) — sin FK, mismo motivo por
// el que otras tablas de este schema tampoco declaran FK a filas
// polimórficas. Reintento con backoff vía el cron
// /api/cron/sync-channel-webhooks, mismo shape que review-overdue /
// wizard-abandoned (scan + fire).
model ChannelWebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  // 'web' | 'telegram' | 'meta' | 'prospecting' (Fase B — connectionId is
  // the Lead.id being enriched, not a channel connection; deliverChannelEvent
  // doesn't care which, it's the same delivery+retry plumbing either way)
  connectionType String    @map("connection_type")
  connectionId   String    @map("connection_id") @db.Uuid
  clientId       String    @map("client_id")
  payload        Json
  // 'pending' | 'delivered' | 'failed'
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastAttemptAt  DateTime? @map("last_attempt_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([connectionType, connectionId])
}

// =============================================================================
// Canales Fase 7 — resúmenes periódicos de conversaciones. A diferencia de
// los modelos de arriba (credenciales de canal), esto no depende de n8n
// construir nada nuevo: se apoya en ChatbotConversation.transcript, que el
// portal ya lee hoy (ver /api/portal/conversations). Nombrado
// "ConversationDigest", no "ConversationSummary" — ese nombre ya lo usa
// src/types/portal.ts para el tipo de una fila del listado de
// conversaciones; reutilizarlo aquí habría creado dos tipos homónimos con
// forma completamente distinta en el mismo codebase.
//
// totalConversations/escalatedCount/fallbackCount son agregados baratos y
// deterministas sobre `outcome` (sin IA) — solo summaryText/highlights
// vienen de conversation-summary-ai.ts, y solo cuando hay al menos una
// conversación en la ventana (ver isDigestDue/generateDueDigests en
// conversation-digest.ts).
// =============================================================================
model ConversationDigest {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String   @map("client_id")
  tenantId           String?  @map("tenant_id") @db.Uuid
  windowStart        DateTime @map("window_start")
  windowEnd          DateTime @map("window_end")
  generatedAt        DateTime @default(now()) @map("generated_at")
  totalConversations Int      @map("total_conversations")
  escalatedCount     Int      @map("escalated_count")
  fallbackCount      Int      @map("fallback_count")
  summaryText        String   @map("summary_text")
  // Lista de solicitudes concretas que habría que atender — generada por
  // IA a partir de los transcripts de la ventana. String[] serializado
  // como Json (no String[] nativo) porque conversation-summary-ai.ts
  // degrada con gracia devolviendo [] sin IA configurada, y Json admite
  // ese mismo shape sin una migración aparte si el formato crece
  // (ej. agregar una referencia a la conversación de origen).
  highlights         Json     @default("[]")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId, windowEnd])
  @@index([tenantId])
}

// Un schedule por cliente (no uno por fase del día) — enabled + preset
// alcanzan para "activar/desactivar" y "mañana/mediodía/tarde vs. cada X
// horas" sin necesitar N filas por cliente. lastGeneratedAt es lo único
// que isDigestDue() necesita para decidir si ya tocaba generar el
// próximo — mismo principio de una-sola-fuente-de-verdad que isSyncDue()
// en google-review-sync.ts.
model ConversationDigestSchedule {
  id              String    @id @default(uuid()) @db.Uuid
  clientId        String    @unique @map("client_id")
  tenantId        String?   @map("tenant_id") @db.Uuid
  enabled         Boolean   @default(false)
  // 'morning_noon_evening' | 'custom_interval'
  preset          String    @default("morning_noon_evening")
  // Solo aplica cuando preset = 'custom_interval'.
  intervalHours   Int?      @map("interval_hours")
  timezone        String    @default("Europe/Madrid")
  lastGeneratedAt DateTime? @map("last_generated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// =============================================================================
// WP-XX — Leads ("Captación con IA" / 'leads' product). Structured record
// for a prospective customer a channel conversation produced. Status
// lifecycle is enforced in src/lib/leads.ts, not a DB constraint — same
// convention as every other status column in this schema (WebQuote.status,
// ReviewRequestCampaign.status, etc.). Audit trail mirrors
// ClientProductAudit's shape (plain before/after status strings, a single
// actorId string) rather than WebQuoteAudit's JSON blobs — a lead has no
// money to track.
// =============================================================================
model Lead {
  id             String  @id @default(uuid()) @db.Uuid
  clientId       String  @map("client_id")
  // KAIA-4258: tenant isolation FK, same convention as every other model.
  tenantId       String? @map("tenant_id") @db.Uuid
  // Nullable, SetNull — deleting the source conversation must not delete
  // the lead it produced. Also leaves room for a future non-conversation
  // capture path (e.g. a form) without a migration.
  conversationId String? @map("conversation_id")

  // All three nullable — the AI classifier doesn't always extract all of
  // them from a single turn.
  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")
  // LLM-extracted summary of what the prospect asked for.
  summary      String?
  // 0-100, set by the n8n classifier. Nullable — no scoring pipeline is
  // guaranteed to run for every lead.
  score        Int?
  // Leads Fase 9 — the classifier's OWN short justification for that
  // number ("pregunta precio y quiere cita esta semana"), not a second
  // score. A bare 0-100 with no reasoning is a number the client either
  // has to trust blindly or ignore; the whole product's credibility
  // rests on this being visible next to the score, not just computed
  // behind it. Nullable for the same reason `score` is: not every run of
  // the classifier is guaranteed to produce one.
  scoreReason  String? @map("score_reason")

  // 'nuevo' | 'contactado' | 'convertido' | 'descartado'. See
  // src/lib/leads.ts for the transition predicates.
  status  String  @default("nuevo")
  // 'telegram' | 'whatsapp' | 'messenger' | 'instagram' | 'web' | 'phone' |
  // 'places'. Free string, same convention as
  // ChannelWebhookDelivery.connectionType. 'phone' is the 'recall'
  // product: a missed call whose caller left a message IS a lead, so it
  // reuses this model rather than duplicating it — see CallEvent.leadId
  // and src/lib/recall-transcription.ts. 'places' is 'prospecting'
  // Fase A: a business discovered via Google Places, never a
  // conversation — see conversationId/source below.
  channel String?

  // Prospección con IA, Fase A — 'inbound' (default: someone wrote in,
  // captured via conversationId) | 'outbound' (we found them via
  // src/lib/prospecting.ts, no conversation exists). Distinguishing this
  // matters because the two are very different trust levels for the
  // client's sales team — the badge in /portal/leads reads this.
  source          String  @default("inbound")
  // Google Place id, when source='outbound'. Scoped per-client (not
  // globally unique) — two different clients legitimately prospecting
  // the same area can both discover the same real business, and that is
  // not a duplicate. Prevents re-creating the same Lead when a later
  // campaign run re-discovers a business already found for this client.
  externalPlaceId String? @map("external_place_id")

  // Prospección con IA, Fase B — the business's own website, from Place
  // Details (google-places.ts's websiteUri). Google Places already
  // returns this during Fase A but it was discarded until now; Fase B
  // is the reason to keep it: it's the crawl target for
  // src/lib/prospecting-enrichment.ts. Null for any inbound lead, and
  // for an outbound one Google had no website on file for.
  website String?

  // Prospección con IA, Fase B — stamped once src/lib/prospecting-
  // enrichment.ts has attempted this lead (crawled + handed to n8n, or
  // the crawl itself failed and was logged) — single-attempt-per-lead,
  // same "once" posture as ProspectingCampaign.alertedAt, not a status
  // machine. Null is exactly "eligible for the next enrichment sweep".
  enrichmentRequestedAt DateTime? @map("enrichment_requested_at")

  // Prospección con IA, Fase C — give-up budget for automatic first
  // contact, same shape as CallEvent.callerNotifyAttempts/
  // callerNotifyError in recall-messaging.ts. A permanently-failing
  // number (bad format, no WhatsApp) must stop being retried every tick
  // forever, but status stays 'nuevo' regardless — a send failure is
  // never claimed as a client decision the way marked_discarded is.
  autoContactAttempts Int     @default(0) @map("auto_contact_attempts")
  autoContactError    String? @map("auto_contact_error")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  contactedAt DateTime? @map("contacted_at")
  convertedAt DateTime? @map("converted_at")
  discardedAt DateTime? @map("discarded_at")

  client       ChatbotClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant       Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  conversation ChatbotConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  auditLogs    LeadAudit[]
  callEvents   CallEvent[]

  @@unique([clientId, externalPlaceId])
  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@index([tenantId])
  @@index([conversationId])
}

model LeadAudit {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  clientId     String   @map("client_id")
  tenantId     String?  @map("tenant_id") @db.Uuid
  // 'created' | 'refreshed' | 'marked_contacted' | 'marked_converted' |
  // 'marked_discarded' | 'enriched' (Fase B — n8n's website-enrichment
  // callback via PATCH /api/internal/leads/[id]/enrich) | 'contacted_auto'
  // (Fase C — automatic first WhatsApp contact, actorId 'system:prospecting')
  action       String
  statusBefore String?  @map("status_before")
  statusAfter  String?  @map("status_after")
  // Operator UUID, 'client:<clientId>' (client-initiated status change),
  // 'system:n8n' (ingestion route), or 'system:prospecting'
  // (src/lib/prospecting.ts, Fase A) — same actorId string convention as
  // ClientProductAudit.
  actorId      String   @map("actor_id")
  changedAt    DateTime @default(now()) @map("changed_at")

  lead   Lead          @relation(fields: [leadId], references: [id], onDelete: Restrict)
  client ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([leadId, changedAt])
  @@index([clientId, changedAt])
  @@index([tenantId])
}

// =============================================================================
// Prospección con IA, Fase A (product code 'prospecting') — active lead
// discovery via Google Places, feeding into the SAME Lead model above
// (source='outbound', channel='places'). Satellite model, same shape as
// RecallSubscription below: 1:1 with ClientProduct via
// clientProductId @unique, fine-grained operational state here while
// ClientProduct.status stays exactly what billing dictates.
//
// The target profile (category + zone) is owned by the CLIENT, not the
// operator — a plain settings form in /portal/leads, same self-serve
// spirit as the rest of 'leads'. See leads-fase-a plan for why: unlike
// Meta Coexistence, there is no technical complexity here that would
// justify operator hand-holding, and interposing one would work against
// the whole point of this product line — scaling without a human in the
// loop per client.
// =============================================================================

model ProspectingCampaign {
  id              String  @id @default(uuid()) @db.Uuid
  clientId        String  @map("client_id")
  clientProductId String  @unique @map("client_product_id") @db.Uuid
  tenantId        String? @map("tenant_id") @db.Uuid

  // What the client is looking for. `category` maps loosely to Google
  // Places `type` values (e.g. 'hair_care', 'restaurant') — validated at
  // the lib layer, not the DB, same posture as every other free-string
  // status column in this schema.
  category      String?
  locationQuery String? @map("location_query")
  radiusMeters  Int?    @default(10000) @map("radius_meters")

  // 'active' | 'paused'. No onboarding state machine like
  // RecallSubscription's — there is no external system to wait on here,
  // just a profile and a schedule.
  status String @default("active")

  lastRunAt DateTime? @map("last_run_at")

  // Usage/cost control. leadsFoundThisMonth is what actually costs
  // money (1 Place Details call per unique lead) — NOT raw search call
  // count, which is cheap and incidental. monthlyLeadCap is set from the
  // client's tier at Bootstrap time (100/300/800 — see the product
  // catalog). alertedAt follows RecallUsageMonth's pattern: warn once
  // per cap breach, not once per tick.
  leadsFoundThisMonth Int       @default(0) @map("leads_found_this_month")
  monthlyLeadCap      Int       @map("monthly_lead_cap")
  usageResetAt        DateTime  @default(now()) @map("usage_reset_at")
  alertedAt           DateTime? @map("alerted_at")

  // Prospección con IA, Fase C — first automatic WhatsApp contact stays
  // off until the client explicitly opts in here; nothing sends without
  // both set. consentVersion is checked against PROSPECTING_CONSENT_VERSION
  // (src/lib/prospecting-contact.ts) at send time, not just at consent
  // time — a future change to the consent copy makes old consent stop
  // counting automatically instead of silently grandfathering it in.
  consentAcknowledgedAt DateTime? @map("consent_acknowledged_at")
  consentVersion        String?   @map("consent_version")
  // Stamped once, automatically, the moment a live quality-rating check
  // (not the possibly-stale MetaChannelConnection.qualityRating mirror)
  // comes back YELLOW/RED right before a send batch — see
  // runProspectingContact. Does NOT clear itself when quality recovers:
  // re-consenting (PATCH .../consent) is what clears it, deliberately,
  // so a degraded number gets a human look before contact resumes rather
  // than silently starting back up on its own.
  autoContactPausedAt DateTime? @map("auto_contact_paused_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        ChatbotClient              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientProduct ClientProduct              @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  tenant        Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  auditLogs     ProspectingCampaignAudit[]

  @@index([clientId])
  @@index([tenantId])
  @@index([status])
}

model ProspectingCampaignAudit {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  clientId   String   @map("client_id")
  tenantId   String?  @map("tenant_id") @db.Uuid
  // 'created' | 'profile_updated' | 'paused' | 'resumed' | 'cap_reached' |
  // 'consent_given' | 'consent_revoked' (Fase C)
  action     String
  before     Json?
  after      Json?
  // 'client:<clientId>' (self-serve profile edit) or 'system:prospecting'
  // (the cron run that hit the cap) — same convention as LeadAudit.
  actorId    String   @map("actor_id")
  changedAt  DateTime @default(now()) @map("changed_at")

  campaign ProspectingCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  client   ChatbotClient       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tenant   Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([campaignId, changedAt])
  @@index([clientId, changedAt])
  @@index([tenantId])
}

// =============================================================================
// SEO con IA (product code 'seo'). Satellite model, 1:1 with ClientProduct,
// same shape as ProspectingCampaign/RecallSubscription. Onboarding is a
// plain form, deliberately NOT the ChatbotConfigStep wizard engine — that
// engine's block/tier types are hardcoded to the chatbot's own vocabulary
// (WizardBlockProgress.tsx's own duplicated WizardBlock type + fixed
// step-number ranges; the wizard routes' explicit `product !== 'chatbot'`
// gate) — generalizing it is separate work this product doesn't need: a
// handful of fields doesn't warrant the 12-step versioned/approved engine
// built for the chatbot's much larger onboarding.
//
// Client and operator write DIFFERENT fields on the SAME row — same
// column-segmentation precedent as RecallSubscription (client connects
// WhatsApp, operator assigns the number): the client fills in what they
// know about their own business and site; the operator fills in the
// technical publish access (a WordPress Application Password) once it's
// set up, since a non-technical client can't do that step alone. Neither
// side ever overwrites the other's fields.
// =============================================================================
model SeoProfile {
  id              String  @id @default(uuid()) @db.Uuid
  clientId        String  @map("client_id")
  clientProductId String  @unique @map("client_product_id") @db.Uuid
  tenantId        String? @map("tenant_id") @db.Uuid

  // Client-filled — business context the content-generation pipeline
  // (Fase C) reads from. Free text, not a wizard step.
  businessDescription String? @map("business_description")
  targetAudience      String? @map("target_audience")
  toneOfVoice         String? @map("tone_of_voice")

  // Client-filled — which site, and what it runs on. cmsType is a free
  // string ('wordpress' | 'wix' | 'squarespace' | 'other' | 'no_se') —
  // validated at the lib layer, same posture as every other free-string
  // status column in this schema. Only 'wordpress' is actually
  // publishable as of Fase A/B — Fase C decides the real publish scope.
  siteUrl String? @map("site_url")
  cmsType String? @map("cms_type")

  // Operator-filled — the technical publish access a non-technical
  // client can't set up alone. Encrypted at rest (AES-256-GCM,
  // SEO_CMS_CREDENTIAL_ENCRYPTION_KEY — its own dedicated key, never
  // shared with any other *_ENCRYPTION_KEY, same convention as every
  // other credential in this schema). Null until the operator has done
  // this — Fase C's publish step is gated on these being present.
  wordpressUrl                   String?   @map("wordpress_url")
  wordpressUsername              String?   @map("wordpress_username")
  wordpressAppPasswordCiphertext Bytes?    @map("wordpress_app_password_ciphertext")
  wordpressAppPasswordIv         Bytes?    @map("wordpress_app_password_iv")
  wordpressAppPasswordTag        Bytes?    @map("wordpress_app_password_tag")
  technicalSetupNotes            String?   @map("technical_setup_notes")
  technicalSetupCompletedAt      DateTime? @map("technical_setup_completed_at")

  // Operator-triggered technical audit (src/lib/seo-audit.ts) — the
  // LATEST result only, not a history table: same posture as
  // MetaChannelConnection.qualityRating/lastSyncAt, "what does it look
  // like now" rather than "every run ever". lastAuditResult holds
  // SeoAuditResult as JSON (title, meta description, heading/image/link
  // signals — never anything from wordpressAppPassword). lastAuditError
  // is the most recent FAILED attempt's error, cleared on the next
  // success — lastAuditResult keeps the last successful audit visible
  // even while a later attempt is failing.
  lastAuditAt     DateTime? @map("last_audit_at")
  lastAuditResult Json?     @map("last_audit_result")
  lastAuditError  String?   @map("last_audit_error")

  // 'onboarding' | 'active' | 'paused'. Free string, same convention as
  // every other status column in this schema.
  status String @default("onboarding")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        ChatbotClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientProduct ClientProduct     @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  tenant        Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  auditLogs     SeoProfileAudit[]

  @@index([clientId])
  @@index([tenantId])
  @@index([status])
}

// Append-only. Dual-actor (client and operator both legitimately write
// this row) — same actorType/actorOperatorId shape as
// RecallSubscriptionAudit, not ProspectingCampaignAudit's single actorId
// string, because here BOTH sides are real writers, not just the client.
// before/after must NEVER contain the WordPress Application Password
// (plaintext or ciphertext) — only non-sensitive metadata (e.g.
// { wordpressUrl, wordpressUsername, hasAppPassword: true }).
model SeoProfileAudit {
  id        String  @id @default(uuid()) @db.Uuid
  profileId String  @map("profile_id") @db.Uuid
  clientId  String  @map("client_id")
  tenantId  String? @map("tenant_id") @db.Uuid

  // 'created' | 'business_info_updated' | 'technical_setup_updated' | 'audit_run'
  action String
  before Json?
  after  Json?

  // 'operator' | 'client'
  actorType       String   @default("client") @map("actor_type")
  actorOperatorId String?  @map("actor_operator_id") @db.Uuid
  // Operator email, or 'client:<clientId>'.
  actorEmail      String?  @map("actor_email")
  changedAt       DateTime @default(now()) @map("changed_at")

  profile  SeoProfile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  client   ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tenant   Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  operator Operator?     @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([profileId, changedAt])
  @@index([clientId, changedAt])
  @@index([tenantId])
}

// =============================================================================
// WP-XX — Recuperación de llamadas perdidas + reseñas (product code 'recall').
//
// Satellite model, 1:1 with ClientProduct — the same shape WebQuote uses
// (clientProductId @unique, fine-grained state here while
// ClientProduct.status stays coarse). The difference from WebQuote: 'web'
// needed a coarse 'quote_pending' value on ClientProduct because payment
// came AFTER the quote. Here payment comes FIRST, so ClientProduct.status
// is left exactly as billing dictates ('active' = paying) and ALL
// operational readiness lives on this row's `status`. isProductContracted()
// returning true means "he pays", which is correct; whether the service is
// actually live is `RecallSubscription.status === 'active'`.
//
// Deliberately NOT modelled on ChatbotConfigStep/the wizard engine: this
// onboarding is gated on external systems (Meta's review queue, number
// provisioning, template approval, and the client dialling MMI forwarding
// codes on his own handset), which draft→submitted→approved cannot express.
// See src/lib/recall.ts for the transition predicates.
// =============================================================================
model RecallSubscription {
  id              String  @id @default(uuid()) @db.Uuid
  clientId        String  @map("client_id")
  clientProductId String  @unique @map("client_product_id") @db.Uuid
  tenantId        String? @map("tenant_id") @db.Uuid

  // 'paid' | 'contract_signed' | 'meta_connected' | 'number_assigned' |
  // 'templates_approved' | 'forwarding_pending' | 'forwarding_verified' |
  // 'active', plus 'paused' | 'cancelled' as side exits. Free string, same
  // convention as every other status column here — enforced by the pure
  // predicates in src/lib/recall.ts, not by the DB.
  status String @default("paid")

  // One timestamp sealed per transition. These are what the operator's
  // stuck-detection queue reads: "client 14 has been in forwarding_pending
  // for four days" is only answerable because the transition is dated.
  contractSignedAt     DateTime? @map("contract_signed_at")
  metaConnectedAt      DateTime? @map("meta_connected_at")
  numberAssignedAt     DateTime? @map("number_assigned_at")
  templatesApprovedAt  DateTime? @map("templates_approved_at")
  forwardingVerifiedAt DateTime? @map("forwarding_verified_at")
  activatedAt          DateTime? @map("activated_at")
  pausedAt             DateTime? @map("paused_at")
  cancelledAt          DateTime? @map("cancelled_at")

  // Where the owner receives his own notifications (daily digest, the
  // transcribed message, the monthly report). Deliberately NOT derived
  // from MetaChannelConnection.externalId: that is the BUSINESS's public
  // WhatsApp number, which may be a shared line or a landline-backed
  // number, while this is the phone in the owner's pocket. E.164.
  ownerWhatsapp String? @map("owner_whatsapp")

  // Which WhatsApp number sends on this client's behalf (Coexistence).
  // Nullable until META_CONNECTED.
  metaConnectionId String? @map("meta_connection_id") @db.Uuid

  // Which Google Business location the review half asks against. The
  // review requests reuse ReviewRequestCampaign/ReviewRequest with a
  // 'whatsapp' channel — see src/lib/review-request-campaign.ts.
  googleConnectionId String? @map("google_connection_id") @db.Uuid

  // The owner's own recorded greeting, 20s or so, recorded on his phone
  // and sent in over WhatsApp at onboarding. Stored inline rather than in
  // object storage: ~200KB each, ~10MB for a 50-client book — not worth
  // introducing a storage dependency the portal doesn't otherwise have.
  // NOTE: call recordings are NOT stored here; those stay on Twilio and
  // are deleted via their API at 30 days (see CallEvent, Fase 3).
  greetingAudio      Bytes?    @map("greeting_audio")
  greetingMimeType   String?   @map("greeting_mime_type")
  greetingRecordedAt DateTime? @map("greeting_recorded_at")

  // Scheduling. `timezone` drives the digest slot boundary the same way
  // ConversationDigestSchedule.timezone does; `digestHour` is 19 by
  // default (end of the working day). The two cursors let the scheduler
  // be coarser than the target cadence — see isDigestDue's pattern in
  // src/lib/conversation-digest.ts.
  timezone      String    @default("Europe/Madrid")
  digestHour    Int       @default(19) @map("digest_hour")
  businessHours Json?     @map("business_hours")
  lastDigestAt  DateTime? @map("last_digest_at")
  lastReportAt  DateTime? @map("last_report_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client           ChatbotClient             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientProduct    ClientProduct             @relation(fields: [clientProductId], references: [id], onDelete: Cascade)
  tenant           Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  metaConnection   MetaChannelConnection?    @relation(fields: [metaConnectionId], references: [id], onDelete: SetNull)
  googleConnection GoogleBusinessConnection? @relation(fields: [googleConnectionId], references: [id], onDelete: SetNull)
  auditLogs        RecallSubscriptionAudit[]
  // The FK lives on VirtualNumber, not here — the number is the pooled
  // resource and it is the pool row that records who currently holds it,
  // so claiming and releasing are each a single write on one row.
  virtualNumber    VirtualNumber?
  callEvents       CallEvent[]
  blockedNumbers   RecallBlockedNumber[]
  digests          RecallDigest[]
  usageMonths      RecallUsageMonth[]

  @@index([clientId])
  @@index([status])
  @@index([tenantId])
  @@index([metaConnectionId])
  @@index([googleConnectionId])
}

// Append-only audit trail for RecallSubscription transitions — mirrors
// WebQuoteAudit. before/after are JSON blobs rather than plain status
// strings because a transition often seals a timestamp and binds a
// resource (number, Meta connection) at the same time, and reconstructing
// "what did this row look like on the day the client complained" is the
// whole point.
model RecallSubscriptionAudit {
  id             String @id @default(uuid()) @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  clientId       String @map("client_id")
  // 'created' | 'contract_signed' | 'meta_connected' | 'number_assigned' |
  // 'templates_approved' | 'forwarding_pending' | 'forwarding_verified' |
  // 'activated' | 'paused' | 'resumed' | 'cancelled'
  action         String
  before         Json?
  after          Json?

  // 'operator' | 'client' | 'system'
  actorType       String  @default("operator") @map("actor_type")
  actorOperatorId String? @map("actor_operator_id") @db.Uuid
  // operator email, 'client:<clientId>', or 'system:<source>'.
  actorEmail      String? @map("actor_email")

  createdAt DateTime @default(now()) @map("created_at")

  subscription RecallSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  client       ChatbotClient      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  operator     Operator?          @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@index([clientId, createdAt])
  @@index([action])
}

// =============================================================================
// WP-XX — Virtual numbers for the 'recall' product, managed as a POOL.
//
// Why a pool and not provision-on-demand: buying Spanish numbering is not
// instant (it needs a regulatory bundle, and the provider call can fail or
// rate-limit), and the one thing this product's onboarding cannot afford
// is a step that blocks on a third party while the client is on the phone
// with us. So numbers are bought in batches ahead of time, sit here as
// `available`, and assignment at alta is a local UPDATE that always
// succeeds in milliseconds.
//
// The regulatory bundle is registered ONCE, by us, as the service
// provider — never per client. Doing it per client would recreate exactly
// the manual bottleneck the pool exists to remove.
//
// One number per client is deliberate and not a cost decision (~1-2 €/mo
// against a 149-399 € subscription). A shared number would have to
// identify the client from Twilio's `ForwardedFrom`, which Twilio's own
// docs say "depends on the caller's carrier... Not all carriers support
// passing this information" — and we need the identity BEFORE answering,
// to play that owner's own recorded greeting. A shared number would also
// make one flagged number take the whole book down at once.
// =============================================================================
model VirtualNumber {
  id          String @id @default(uuid()) @db.Uuid
  // 'twilio' today. Free string rather than an enum so a second provider
  // needs no migration — see src/lib/telephony/.
  provider    String @default("twilio")
  // The provider's own identifier for this number (Twilio: the PN… SID).
  // Unique so a double-provision cannot create two rows for one number.
  providerSid String @unique @map("provider_sid")
  e164        String @unique
  countryCode String @map("country_code")

  // 'available' | 'assigned' | 'released'. `released` rows are kept
  // rather than deleted: knowing which number a client used to have is
  // exactly what you need six months later when a caller says they rang
  // and nobody answered.
  status String @default("available")

  // Nullable = sitting in the pool. @unique enforces one number per
  // subscription at the database level, not just in application code.
  subscriptionId String? @unique @map("subscription_id") @db.Uuid

  provisionedAt DateTime  @default(now()) @map("provisioned_at")
  assignedAt    DateTime? @map("assigned_at")
  releasedAt    DateTime? @map("released_at")

  // Last provider-side failure (e.g. a release that the provider
  // rejected), same convention as MetaChannelConnection.lastSyncError.
  // A row can be locally `released` while the provider still bills us
  // for it; this is where that shows up.
  lastError String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscription RecallSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  callEvents   CallEvent[]

  @@index([status])
  @@index([provider])
  @@index([countryCode, status])
}

// =============================================================================
// WP-XX — One row per call that reached a client's virtual number, i.e.
// per call the client did NOT answer (conditional forwarding only sends
// us the ones they missed — we never intercept a call they took).
//
// `twilioCallSid` is @unique and is the idempotency key: Twilio retries
// webhooks on any non-2xx, and a retried voice webhook must find the
// existing row rather than create a second one.
//
// RECORDINGS ARE NOT STORED HERE. Twilio hosts the audio; we keep the SID
// and URL and delete it at Twilio at 30 days (RGPD — we are the processor,
// the client is the controller). `recordingDeletedAt` is what the purge
// job stamps. Storing third-party voice recordings in our own database
// would turn a 30-day retention promise into a backup-retention problem.
// =============================================================================
model CallEvent {
  id             String  @id @default(uuid()) @db.Uuid
  clientId       String  @map("client_id")
  subscriptionId String  @map("subscription_id") @db.Uuid
  tenantId       String? @map("tenant_id") @db.Uuid

  twilioCallSid String @unique @map("twilio_call_sid")

  // Null/withheld when the caller hid their number. Kept as a distinct
  // flag rather than inferred from a null, because "we don't know who
  // called" and "we haven't parsed it yet" are different states and only
  // the first is un-recoverable — a withheld call can never be called
  // back, so it must not be counted as a recoverable missed call.
  fromNumber String? @map("from_number")
  withheld   Boolean @default(false)
  // The virtual number that was dialled, denormalised as text so the
  // history survives that number later being released and reassigned.
  toNumber   String  @map("to_number")

  virtualNumberId String? @map("virtual_number_id") @db.Uuid

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  // @unique so a retried recording callback updates rather than
  // duplicates. Twilio delivers these at-least-once.
  recordingSid             String?   @unique @map("recording_sid")
  recordingUrl             String?   @map("recording_url")
  recordingDurationSeconds Int?      @map("recording_duration_seconds")
  recordingDeletedAt       DateTime? @map("recording_deleted_at")

  // Filled by the transcription step (Fase 4).
  transcript         String?   @db.Text
  transcribedAt      DateTime? @map("transcribed_at")
  transcriptionError String?   @map("transcription_error")

  // 'pending'    — call in progress, no outcome yet
  // 'recorded'   — the caller left a message
  // 'no_message' — they hung up during the greeting or left silence
  // 'withheld'   — number hidden; nothing to call back, not recoverable
  // 'blocked'    — a number on the client's blocklist (Fase 9)
  outcome String @default("pending")

  // The Lead this call produced, if any (Fase 4). A missed call with a
  // message IS a lead — the existing model already fits, so it is reused
  // rather than duplicated.
  leadId String? @map("lead_id") @db.Uuid

  // Stamped by the messaging engine (Fase 9). Also the throttle source:
  // "one message per number per 24h" is derived from the most recent
  // notifiedCallerAt for a given (clientId, fromNumber), which is why
  // this needs no separate table.
  notifiedOwnerAt  DateTime? @map("notified_owner_at")
  notifiedCallerAt DateTime? @map("notified_caller_at")

  // WP-XX (Fase 9) — per-direction delivery state. Columns rather than a
  // RecallMessage table because the relationship really is one message per
  // direction per call, and it is the same treatment transcriptionError
  // already gets: the error belongs to the row it happened to.
  //
  // callerNotifyChannel records how the caller-notification RESOLVED,
  // and NULL is the only "not decided yet" value — it is what the
  // sweep filters on. 'whatsapp' | 'sms' mean a message went out
  // (~10-15% of callers are on landlines with no WhatsApp, and that
  // fallback is invisible otherwise); 'blocked' | 'throttled' |
  // 'unreachable' are terminal decisions NOT to send.
  //
  // Recording the skips here rather than faking notifiedCallerAt is the
  // point: that column feeds the 24h throttle, so a call we chose to
  // stay silent about must not also silence the next one.
  callerNotifyChannel  String? @map("caller_notify_channel")
  callerNotifyError    String? @map("caller_notify_error")
  // Bounded, so a permanently-failing send cannot be retried forever by a
  // sweep that runs every five minutes.
  callerNotifyAttempts Int     @default(0) @map("caller_notify_attempts")
  ownerNotifyError     String? @map("owner_notify_error")
  ownerNotifyAttempts  Int     @default(0) @map("owner_notify_attempts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        ChatbotClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription  RecallSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant        Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  virtualNumber VirtualNumber?     @relation(fields: [virtualNumberId], references: [id], onDelete: SetNull)
  lead          Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([clientId, startedAt])
  @@index([subscriptionId, startedAt])
  @@index([outcome])
  @@index([tenantId])
  // Drives the 30-day purge sweep: find recordings still present past
  // their retention window.
  @@index([recordingDeletedAt, startedAt])
  // Drives the Fase 9 notification sweep — "which calls still owe someone
  // a message". The null-able stamp leads because that is the selective
  // part: almost every historical row is already notified.
  @@index([notifiedCallerAt, startedAt])
  @@index([notifiedOwnerAt, startedAt])
  // The 24h caller throttle: the most recent message this client sent to
  // this number.
  @@index([clientId, fromNumber, notifiedCallerAt])
}

// WP-XX (Fase 9) — numbers this client never wants messaged back.
//
// The population is specific and predictable: cold-call sales, robocalls,
// and the odd wrong number that keeps ringing. Without this the product
// answers a sales robot with a warm "how can we help you" from the
// business's own WhatsApp, which is worse than doing nothing at all —
// it burns the number's quality rating on traffic that will never convert.
//
// Scoped to the subscription rather than the client because the number is
// the thing being protected and the subscription is what owns it; the
// clientId column is denormalised alongside for the operator's own
// cross-client lookups.
model RecallBlockedNumber {
  id             String @id @default(uuid()) @db.Uuid
  clientId       String @map("client_id")
  subscriptionId String @map("subscription_id") @db.Uuid

  // E.164, normalised on the way in. A blocklist that stores what the
  // operator typed would silently never match what Twilio sends.
  e164 String

  // Free text — 'spam', 'comercial', or whatever the operator wrote. It
  // exists so a block can be explained months later, not to be branched on.
  reason String?

  // operator email, or 'client:<clientId>' when the owner asked for it.
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  client       ChatbotClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription RecallSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, e164])
  @@index([clientId])
}

// WP-XX (Fase 10) — the 19:00 message that closes the owner's day.
//
// It lists the calls we recovered today, numbered, and asks which of them
// turned into an actual job. He replies "1 y 3" and those two callers get
// a review request.
//
// THE SELECTION IS 'WHO DID I SERVE', NEVER 'WHO WAS HAPPY'. That
// distinction is the whole legal and ethical footing of the review half:
// you may only ask someone you actually did work for, and you may not
// filter by expected sentiment. This model makes gating INEXPRESSIBLE —
// there is no satisfaction, rating, or sentiment column anywhere for a
// future well-meaning change to start branching on, which is the same
// property ReviewRequest was built with.
//
// rawResponse keeps what the owner actually typed, verbatim. If he later
// says "yo nunca dije que le escribierais al 3", that string is the
// answer — the same reason WebBriefAudit exists.
model RecallDigest {
  id             String @id @default(uuid()) @db.Uuid
  clientId       String @map("client_id")
  subscriptionId String @map("subscription_id") @db.Uuid

  // The local day covered, 'YYYY-MM-DD' in the subscription's own
  // timezone. A DATE column would be the obvious choice and the wrong
  // one: 'the owner's Tuesday' is a wall-clock concept, and storing it as
  // an instant would shift the day boundary twice a year.
  localDate String @map("local_date")

  // Ordered. The number the owner sees IS the index plus one, which is
  // why the order has to be persisted rather than recomputed — a later
  // query returning a different order would silently remap his reply.
  callEventIds Json @map("call_event_ids")

  sentAt    DateTime? @map("sent_at")
  sendError String?   @map("send_error")
  attempts  Int       @default(0)

  rawResponse          String?   @map("raw_response")
  selectedCallEventIds Json?     @map("selected_call_event_ids")
  respondedAt          DateTime? @map("responded_at")
  // Set when we asked once for a clarification. We never ask twice: a
  // second nag for a message he chose to ignore is how a client starts
  // muting the number he is paying us for.
  clarifiedAt          DateTime? @map("clarified_at")

  // The review campaign this digest's reply produced, if any.
  campaignId String? @map("campaign_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client       ChatbotClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription RecallSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // One digest per owner per day. This is the idempotency key: the tick
  // runs every five minutes and must never send the same summary twice.
  @@unique([subscriptionId, localDate])
  @@index([clientId])
  // Drives the reply router: 'is there a digest this owner could be
  // answering right now?'
  @@index([subscriptionId, sentAt])
}

// WP-XX (Fase 11) — what each client actually consumes, per month.
//
// The pack is sold flat rate, so this is not billing. It is how we
// notice the one client whose usage stops resembling the others before
// the provider invoice does. Modo Recado runs at roughly 25-30 minutes a
// month; the risk only becomes real if Modo Recepción (out of scope for
// v1) is ever sold, and by then the measurement has to already exist.
//
// A rollup rather than a live aggregation: the operator queue asks "who
// is over budget this month" across every client at once, and answering
// that with one indexed read beats N aggregations that get slower every
// month the product succeeds.
//
// Every figure here is derived from rows that already exist (CallEvent,
// ReviewRequest), so a rollup can always be recomputed and nothing new
// has to be written on the hot path.
model RecallUsageMonth {
  id             String @id @default(uuid()) @db.Uuid
  clientId       String @map("client_id")
  subscriptionId String @map("subscription_id") @db.Uuid

  // 'YYYY-MM' in the subscription's own timezone, for the same reason
  // RecallDigest.localDate is wall-clock: a month boundary is a calendar
  // fact, not an interval of UTC.
  localMonth String @map("local_month")

  calls         Int @default(0)
  recordedCalls Int @default(0) @map("recorded_calls")
  // Sum of recorded seconds. Survives the 30-day purge, which deletes
  // the audio at Twilio and leaves the duration behind — so history
  // stays measurable without keeping a single third-party voice.
  callSeconds   Int @default(0) @map("call_seconds")

  whatsappMessages Int @default(0) @map("whatsapp_messages")
  smsMessages      Int @default(0) @map("sms_messages")
  reviewRequests   Int @default(0) @map("review_requests")

  // Set when an operator has been told this month looks abnormal, so
  // the alert fires once rather than on every tick for the rest of the
  // month.
  alertedAt  DateTime? @map("alerted_at")
  computedAt DateTime  @map("computed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client       ChatbotClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription RecallSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, localMonth])
  @@index([clientId])
  // "Who is over budget this month" — the whole reason this is a rollup.
  @@index([localMonth, callSeconds])
}
