// =============================================================================
// Kairikos — Chatbot AI end-client portal (KAIA-752)
// Prisma schema for the Prisma + PostgreSQL 16 + Docker on VPS stack
// (plan rev 3, KAIA-719).
//
// Per-row isolation: every portal API route resolves clientId from
//   ChatbotClientUser.nextAuthEmail = session.user.email
// before any other query. No raw SQL — all reads go through Prisma
// `where: { clientId }` clauses. See prisma/README.md for the rule.
//
// Multi-tenant: KAIA-4258 — tenant isolation via profiles.tenant_id FK.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // KAIA-2858 — Vercel runtime is Amazon Linux 2 (RHEL-derived, glibc, openssl
  // 3.0.x), but `prisma generate` on the build host (Debian) defaults to
  // `debian-openssl-3.0.x`. The mismatch means every route that transitively
  // imports `@/lib/prisma` (e.g. `/portal`, `/api/auth/*`) blows up at
  // module-load time on Vercel with "Failed to load query engine" → HTTP 500,
  // while routes that never import prisma (`/portal/login`, `/api/health`)
  // keep working. Emit both binaries so the same generated client works in
  // the Docker / VPS build (debian) AND in Vercel serverless (rhel).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per paying client. Source of truth for billing + onboarding state.
// Stripe remains the billing source of truth (stripeCustomerId is the link).
model ChatbotClient {
  id               String    @id @default(cuid())
  // NextAuth magic-link recipient. Unique — v1 has no shared inboxes.
  email            String    @unique
  name             String
  // Company name (free-form, may differ from the legal entity on Stripe).
  companyName      String?
  // Active subscription tier. Mirrors the value Stripe reports back via webhook.
  tier             String    @default("starter")
  // Stripe customer id (populated by the Stripe webhook handler in
  // kira-studio-billing-backend). NULL during the trial window.
  stripeCustomerId String?
  // Explicit onboarding-state column. KAIA-1062 self-service UI sets
  // this to 'go-live-pending' when the client clicks "I'm ready for
  // go-live" on the portal. The CTO flips it to 'live' and sets
  // `goLiveAt` in the same transaction. KAIA-1261 (BE-1 v1) extends
  // the allowlist with 'ready' and 'updating' for the wizard state
  // machine. Allowed values (server-enforced in the route handler):
  //   * 'in-progress'    — default; default applied at column add
  //   * 'go-live-pending'— client requested go-live approval
  //   * 'live'           — operator approved go-live (goLiveAt also set)
  //   * 'ready'          — wizard v1: every mandatory step reached
  //                        'approved' for the first time. n8n listens
  //                        for the config_complete trigger at this edge.
  //   * 'updating'       — wizard v1: a step moved to needs_revision
  //                        (or a new draft was created) while the client
  //                        was 'live'. The bot keeps running on the last
  //                        approved version per step until the operator
  //                        approves the new one.
  state            String    @default("in-progress")
  // Set when the CTO marks the chatbot live in the operator flow.
  goLiveAt         DateTime?
  // Supabase chatbot_clients.id (UUID). Populated by the backfill in KAIA-762
  // so the status-change watcher can resolve the Supabase UUID to the
  // portal's cuid without going through the email join path.
  supabaseClientId String?   @unique
  // KAIA-4258: tenant isolation FK. All client data is scoped to this tenant.
  // NULL during the migration window; the data backfill migration sets it
  // to the default tenant for any row that pre-dates this column.
  tenantId         String?   @map("tenant_id") @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities            ChatbotActivity[]
  conversations         ChatbotConversation[]
  users                 ChatbotClientUser[]
  operatorNotifications OperatorNotification[]
  n8nExecutions         N8nExecution[]
  configSteps           ChatbotConfigStep[]
  intakeSubmissions     IntakeSubmission[]
  tenant                Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  clientProducts        ClientProduct[]
  productAudits         ClientProductAudit[]

  @@index([stripeCustomerId])
  @@index([tier])
  @@index([state])
  @@index([tenantId])
}

// =============================================================================
// KAIA-2913 — In-house intake submission (replaces Tally webhook ingestion).
//
// One row per accepted POST /api/public/intake. The endpoint:
//   1. validates the payload with the Zod schema in src/lib/intake-schema.ts
//   2. upserts a ChatbotClient + ChatbotClientUser pair (idempotency on email)
//   3. writes the IntakeSubmission row with the resolved client_id
//   4. triggers Drive folder creation + CTO notify-operator + Paperclip Day-2
//
// Idempotency: client supplies X-Idempotency-Key (or the server mints a
// UUIDv4 fallback). The route resolves to the existing row on retries and
// returns the same response payload — never duplicates the side effects.
// =============================================================================

model IntakeSubmission {
  id                String   @id @default(cuid())
  // Client-supplied or server-generated idempotency token. UNIQUE.
  idempotencyKey    String   @unique @map("idempotency_key")
  // 'public_intake' | future sources (csv_import, partner_api, ...). Free-form.
  source            String
  // Vertical tag derived from the `sector` field in the payload.
  vertical          String
  // Slug of the form spec this submission belongs to. Keeps the table
  // multi-form-friendly in case more intake funnels land later.
  intakeSlug        String   @map("intake_slug")
  // Full payload as JSONB so the admin portal can re-render the submission.
  payload           Json
  // FK to ChatbotClient. NULL during the brief window between row insert
  // and the client upsert completing in the same transaction.
  clientId          String?  @map("client_id")
  // KAIA-4258: tenant isolation FK. NULL for pre-multi-tenant rows; the
  // backfill migration sets it to the default tenant.
  tenantId          String?  @map("tenant_id") @db.Uuid
  // Denormalized for list/search views so the admin query doesn't have to
  // extract from JSONB on every page load.
  businessName      String   @map("business_name")
  humanHandoffEmail String   @map("human_handoff_email")
  ipHash            String?  @map("ip_hash")
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  client ChatbotClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([vertical])
  @@index([source])
  @@index([intakeSlug])
  @@index([businessName])
  @@index([humanHandoffEmail])
  @@index([clientId])
  @@index([tenantId])
}

// One row per operator notification fired (KAIA-1061). Drives the
// dedup logic in POST /api/internal/notify-operator and the future
// operator inbox view.
//
// Idempotency: the unique constraint on (clientId, kind, day) — where
// `day` is a YYYY-MM-DD UTC date — makes the route a true upsert.
// Repeated calls within the same UTC day collapse to a no-op. `clientId`
// is nullable so non-client-scoped events (e.g. a global n8n failure)
// can still be logged without violating the constraint.
model OperatorNotification {
  id              String         @id @default(cuid())
  clientId        String?
  // KAIA-4258: tenant isolation FK. NULL for non-client-scoped events
  // (e.g. a global n8n failure) and for pre-multi-tenant rows; the
  // backfill migration sets it from ChatbotClient.tenantId where known.
  tenantId        String?        @map("tenant_id") @db.Uuid
  // 'stuck' | 'execution-failed' | 'escalation'
  // | 'review-overdue-warning' | 'review-overdue-escalation'. Enforced
  // server-side in the route handlers — Postgres does not need a CHECK
  // constraint because no production code writes an unknown value.
  kind            String
  // Date the notification fired (YYYY-MM-DD). For stuck / execution-failed
  // / escalation this is the UTC date (stable across timezones); for
  // review-overdue-* the route computes it in the operator's timezone
  // (see `operator_day_in_tz` SQL function) so a Friday-evening review
  // in Madrid and a Monday-morning re-fire land on distinct days.
  day             String
  // Wizard step id (KAIA-1163 cuid) for review-overdue kinds. NULL for
  // the other three kinds. Carries the per-step dedup key.
  stepId          String?
  subject         String
  // JSON-as-string with the request body that fired the notification.
  context         String?
  // Resend message id, populated after a successful send.
  resendMessageId String?
  sentAt          DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  client          ChatbotClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([clientId, kind, day])
  @@index([day])
  @@index([resendMessageId])
  // KAIA-1177: per-step dedup lookup for review-overdue kinds. The
  // partial UNIQUE on (stepId, kind, day) lives in
  // 20260613124100_operator_notification_step_dedup/migration.sql
  // because Prisma does not natively model partial indexes; the @@index
  // here gives the route a fast lookup so the dedup check is one round
  // trip.
  @@index([stepId, kind, day])
  @@index([stepId])
  @@index([tenantId])
}

// =============================================================================
// KAIA-1107 — Per-operator identity (email + password + TOTP MFA).
// One row per operator who can access the admin portal. The password hash
// is argon2id (OWASP 2026 recommendation). The TOTP secret is encrypted at
// rest with a server-side key so a DB dump alone does not compromise MFA
// enrollment. Soft-deletion via isActive preserves the audit trail.
// =============================================================================

model Operator {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String
  // Encrypted TOTP secret (AES-256-GCM with OPERATOR_TOTP_ENCRYPTION_KEY).
  // NULL until the operator initiates TOTP enrollment.
  totpSecret     String?
  // NULL until the operator completes TOTP enrollment (verified a valid code).
  totpEnrolledAt DateTime?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  lastTotpAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions            OperatorSession[]
  recoveryCodes       OperatorRecoveryCode[]
  auditLogs           OperatorSettingsAudit[]
  approvedConfigSteps ChatbotConfigStep[]

  @@index([email])
  @@index([isActive])
}

// Server-side session store. The session `id` IS the opaque session token,
// returned to the operator as an httpOnly secure cookie. Sessions have a
// 7-day absolute lifetime. Revoked sessions cannot be reused.
model OperatorSession {
  id             String    @id @default(uuid()) @db.Uuid
  operatorId     String    @db.Uuid
  // Set when the operator passes TOTP step-up. Mutations check this.
  totpVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  ip             String?
  userAgent      String?
  // Soft-revoke. When non-null the session is dead even if not yet expired.
  revokedAt      DateTime?

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([expiresAt])
}

// One-time recovery codes generated at TOTP enrollment. Stored as argon2id
// hashes. Shown to the operator exactly once at enrollment time; never
// retrievable afterwards. Each code can be consumed at most once.
model OperatorRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  operatorId String    @db.Uuid
  // argon2id hash of the recovery code — never stored in plaintext.
  codeHash   String
  // NULL until consumed; set to the timestamp of use.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

// =============================================================================
// KAIA-1073 — n8n execution capture for the operator flow-health dashboard.
// Every T+N workflow run (success or failure) is upserted here by the
// POST /api/internal/n8n-execution endpoint so the dashboard can surface
// the last n8n status per client without querying n8n directly.
//
// Upsert key: `id` (n8n's own execution id — stable across retried calls).
// Indexes: (clientId, startedAt desc) for per-client history; (status,
// startedAt desc) for the failure-listing dashboard panel.
// =============================================================================
model N8nExecution {
  id           String    @id
  clientId     String?
  // KAIA-4258: tenant isolation FK. NULL for non-client-scoped flows
  // (e.g. a global n8n failure) and for pre-multi-tenant rows.
  tenantId     String?   @map("tenant_id") @db.Uuid
  clientName   String?
  workflow     String
  milestone    String?
  status       String
  startedAt    DateTime
  finishedAt   DateTime?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime  @default(now())

  client ChatbotClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([tenantId])
}

// Maps a NextAuth session email to a ChatbotClient row. v1 is 1:1 — one
// nextAuthEmail per client. (Multi-tenant org switching is a v2 backlog item.)
model ChatbotClientUser {
  id            String        @id @default(cuid())
  clientId      String
  // NextAuth session email (the JWT subject). Unique — credentials login email.
  nextAuthEmail String        @unique
  // FK to User — the canonical identity row that holds the credential hash.
  // NULL for users who have not yet been linked (backfill completes this).
  userId        String?       @unique
  // KAIA-4258: tenant isolation FK, resolved via the linked Profile on insert.
  // NULL for pre-multi-tenant rows; the backfill migration sets it from
  // ChatbotClient.tenantId.
  tenantId      String?       @map("tenant_id") @db.Uuid
  client        ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([tenantId])
}

// =============================================================================
// KAIA-2103 — Unified user identity for credential-based auth.
// Stores role (client | operator), email, and the password hash.
// Both ChatbotClientUser and Operator link to User via userId.
// =============================================================================
model User {
  id            String    @id @default(cuid())
  // 'client' | 'operator'. Determines which auth provider accepts this user.
  role          String    @default("client")
  email         String    @unique
  // argon2id hash of the password. NULL until the user sets a password via
  // the setup-password flow. '__must_reset__' is the backfill marker for
  // existing ChatbotClientUser rows that had NULL passwordHash — these users
  // cannot authenticate until they complete setup-password.
  passwordHash  String?
  passwordSetAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chatbotClientUsers ChatbotClientUser[]
  profile            Profile?

  @@index([email])
  @@index([role])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: Tenant organizations
//
// One row per tenant organization. The tenant owns all client data.
// Feature flags stored as JSONB for per-tenant rollout (mirrors the
// Supabase supabase/migrations/20260724_tenant_isolation_v1.up.sql
// shape so the two databases stay aligned for the same logical entity).
// =============================================================================
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  // 'active' | 'suspended' | 'cancelled'. Enforced server-side.
  status    String   @default("active")
  features  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profiles                Profile[]
  chatbotClients          ChatbotClient[]
  chatbotClientUsers      ChatbotClientUser[]
  chatbotActivities       ChatbotActivity[]
  chatbotConversations    ChatbotConversation[]
  chatbotConfigSteps      ChatbotConfigStep[]
  chatbotConfigStepAudits ChatbotConfigStepAudit[]
  intakeSubmissions       IntakeSubmission[]
  operatorNotifications   OperatorNotification[]
  n8nExecutions           N8nExecution[]
  clientProducts          ClientProduct[]
  productAudits           ClientProductAudit[]

  @@index([slug])
  @@index([status])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: User profiles
//
// One row per linked User (1:1). Carries the tenant FK and the role that
// gates RLS-equivalent application-layer checks. The portal routes resolve
// `tenantId` from Profile via the session email; rows are created when a
// User is provisioned (the credentials signup flow creates User + Profile
// in the same transaction).
// =============================================================================
model Profile {
  id        String   @id @default(cuid())
  // FK to User — 1:1. UNIQUE so the canonical identity row is unambiguous.
  userId    String   @unique @map("user_id")
  tenantId  String   @map("tenant_id") @db.Uuid
  // 'owner' | 'admin' | 'viewer'. Enforced server-side. Owner sees all
  // tenant data; admin can mutate; viewer is read-only.
  role      String   @default("viewer")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([role])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: Service products (tiers)
//
// Kairikos service tiers. Source of truth is Stripe, but we store metadata
// here for portal display and feature-gating. Mirrors the shape of the
// Supabase products table so the same Stripe webhook can write both.
// =============================================================================
model Product {
  id            String   @id @default(uuid()) @db.Uuid
  // Stripe price id (populated by the Stripe webhook handler in
  // kira-studio-billing-backend). NULL for unsynced or grandfathered rows.
  stripePriceId String?  @unique @map("stripe_price_id")
  name          String
  // 'starter' | 'pro' | 'premium'. UNIQUE — one row per tier.
  tier          String   @unique
  priceCents    Int      @map("price_cents")
  currency      String   @default("EUR")
  features      Json     @default("{}")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  clientProducts ClientProduct[]
  auditLogs      ClientProductAudit[]
  @@index([tier])
  @@index([isActive])
}

// Immutable audit trail for product assignment and lifecycle changes.
model ClientProductAudit {
  id              String    @id @default(uuid()) @db.Uuid
  clientProductId  String    @map("client_product_id") @db.Uuid
  clientId         String    @map("client_id")
  productId        String    @map("product_id") @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  action           String
  statusBefore     String?   @map("status_before")
  statusAfter      String?   @map("status_after")
  actorId          String    @map("actor_id")
  changedAt        DateTime  @default(now()) @map("changed_at")

  clientProduct ClientProduct @relation(fields: [clientProductId], references: [id], onDelete: Restrict)
  client        ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientProductId, changedAt])
  @@index([clientId, changedAt])
  @@index([tenantId])
}

// =============================================================================
// KAIA-4258 — Multi-tenant: Client-Product many-to-many join

//
// Associates chatbot clients with their subscribed products. Stripe stores
// the subscription itself; this row is the portal/Supabase denormalization
// for owner views and feature gating. UNIQUE (clientId, productId) so a
// client cannot have two rows for the same tier — reactivation goes
// through UPDATE on the existing row, not a fresh INSERT.
// =============================================================================
model ClientProduct {
  id           String    @id @default(uuid()) @db.Uuid
  clientId     String    @map("client_id")
  productId    String    @map("product_id") @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  status       String    @default("active")
  subscribedAt DateTime  @default(now()) @map("subscribed_at")
  cancelledAt  DateTime? @map("cancelled_at")
  createdBy    String?   @map("created_by")
  changedBy    String?   @map("changed_by")
  changedAt    DateTime  @default(now()) @map("changed_at")

  client  ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  tenant  Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  auditLogs ClientProductAudit[]

  @@unique([clientId, productId])
  @@index([clientId])
  @@index([productId])
  @@index([status])
  @@index([tenantId])
}

// =============================================================================
// KAIA-2103 — Password reset tokens for client portal users.
// Supports forgot-password + reset-password flow via time-limited tokens.
// Tokens are single-use; once consumed they cannot be reused.
// =============================================================================
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
}

// One row per T+N event the n8n flow emits (T+0, T+3, T+7, T+14, …).
// Drives the portal onboarding timeline.
//
// Idempotency: the unique constraint on (clientId, milestone) makes the
// portal's POST /api/internal/activity endpoint a true upsert. n8n flows
// can re-run freely; the second write collapses to a no-op. The
// (clientId, milestone) pair is the natural business key — there is at
// most one row per T+N milestone per client.
model ChatbotActivity {
  id          String        @id @default(cuid())
  clientId    String
  // KAIA-4258: tenant isolation FK (denormalized from ChatbotClient for query
  // plans that filter by tenant_id directly without a join). NULL for
  // pre-multi-tenant rows; the backfill migration sets it from
  // ChatbotClient.tenantId.
  tenantId    String?       @map("tenant_id") @db.Uuid
  // T+N milestone label — "T+0", "T+3", "T+7", "T+14" by convention; free-form
  // string so n8n can extend without a schema migration. Enforced allowlist
  // lives in the route handler at src/app/api/internal/activity/route.ts.
  milestone   String
  // NULL when the row is created up-front (e.g. the schedule); set when the
  // event actually fires.
  completedAt DateTime?
  notes       String?
  client      ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([clientId, milestone])
  @@index([clientId, completedAt])
  @@index([tenantId])
}

// One row per chatbot conversation. Read-only on the portal in v1
// (writes come from the chatbot platform via n8n).
model ChatbotConversation {
  id         String        @id @default(cuid())
  clientId   String
  // KAIA-4258: tenant isolation FK (denormalized from ChatbotClient for
  // query plans that filter by tenant_id directly). NULL for
  // pre-multi-tenant rows; the backfill migration sets it.
  tenantId   String?       @map("tenant_id") @db.Uuid
  startedAt  DateTime
  // Duration in seconds. NULL while the conversation is still open.
  duration   Int?
  // Outcome / resolution status. Free-form string so the chatbot platform
  // can extend without a schema migration. Conventional values:
  //   resolved | escalated | abandoned | fallback | unknown
  outcome    String?
  // Full transcript as JSON — message list, metadata, tool calls, etc.
  transcript Json?
  client     ChatbotClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([clientId, startedAt])
  @@index([clientId, outcome])
  @@index([tenantId])
}

// =============================================================================
// KAIA-1163 — Wizard configuration step. One row per (client, stepKey, version).
// The wizard creates version=1 on first save; subsequent edits increment version.
// The bot always reads the row where activeForBot=true for a given (clientId,
// stepKey). The operator approves a version, which sets activeForBot=true on the
// new version and false on the previous one.
//
// Status lifecycle (enforced server-side):
//   draft → submitted → approved  (forward)
//         → needs_revision ←       (operator can flip back)
//
// KAIA-1261 (BE-1 v1) extends this with:
//   * `revisionComment` — denormalized latest operator reason when the step
//     was sent to needs_revision. The audit table remains the source of
//     truth for history; this column makes the portal GET a single round
//     trip. Added in
//     20260615010000_chatbot_config_step_v1_addendum/migration.sql.
//   * A DB-level partial UNIQUE constraint on (clientId, stepKey) WHERE
//     activeForBot = true. Prisma cannot model partial uniques natively,
//     so the @@index below is a planning hint and the actual constraint
//     lives in raw SQL. The bot config loader relies on this invariant;
//     duplicate actives are a 23505 unique_violation in the API layer.
// =============================================================================

model ChatbotConfigStep {
  id                   String    @id @default(cuid())
  clientId             String
  // KAIA-4258: tenant isolation FK (denormalized from ChatbotClient for
  // query plans that filter by tenant_id directly). NULL for
  // pre-multi-tenant rows; the backfill migration sets it.
  tenantId             String?   @map("tenant_id") @db.Uuid
  // Step identifier: "1" through "12" (Steps 1-10 + 11 Pruebas + 12 Integraciones).
  // Enforced server-side via a per-step Zod schema registry.
  stepKey              String
  // Monotonically increasing per (clientId, stepKey). Starts at 1.
  version              Int       @default(1)
  // 'draft' | 'submitted' | 'approved' | 'needs_revision'. Enforced server-side.
  status               String    @default("draft")
  // Opaque JSON blob — the wizard stores the step's form fields here as a flat
  // JSON object. v1: plaintext values. v1.1: ciphertext + envelope metadata.
  // Prisma maps Json to PostgreSQL JSONB.
  payload              Json?
  // Set when the client clicks "Submit for review" on this step.
  submittedAt          DateTime?
  // Set when the operator approves this version.
  approvedAt           DateTime?
  // Operator who approved this version (FK to Operator, nullable until approved).
  approvedByOperatorId String?   @db.Uuid
  // Exactly one row per (clientId, stepKey) has activeForBot=true at any time.
  // The bot's config-loader reads the active version when constructing prompts.
  // The DB-level invariant is enforced by a partial UNIQUE index — see
  // 20260615010000_chatbot_config_step_v1_addendum/migration.sql. Prisma
  // cannot model partial uniques natively, so the @@index below is a query
  // planning hint and the actual constraint lives in raw SQL.
  activeForBot         Boolean   @default(false)
  // Latest operator reason when the step was sent to needs_revision
  // (KAIA-1261 / BE-1 v1). Denormalized from the most recent
  // ChatbotConfigStepAudit row with action=request_revision so the
  // portal GET can render the operator's note in a single round trip.
  // The audit table remains the source of truth for history.
  revisionComment      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client     ChatbotClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  approvedBy Operator?                @relation(fields: [approvedByOperatorId], references: [id], onDelete: SetNull)
  tenant     Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  auditLogs  ChatbotConfigStepAudit[]

  @@unique([clientId, stepKey, version])
  @@index([clientId, stepKey])
  @@index([clientId, stepKey, activeForBot])
  @@index([clientId, status])
  @@index([tenantId])
}

// Immutable (append-only) audit log for ChatbotConfigStep changes.
// Enforced at the application layer: the wizard API only exposes create
// (insert-only via the PATCH route handler). One row per discrete event:
// edit, submit, approve, request_revision, activate, deactivate.
model ChatbotConfigStepAudit {
  id        String   @id @default(cuid())
  stepId    String
  // KAIA-4258: tenant isolation FK (denormalized from the parent
  // ChatbotConfigStep so audit-list queries can filter by tenant_id
  // without joining the config step). NULL for pre-multi-tenant rows;
  // the backfill migration sets it.
  tenantId  String?  @map("tenant_id") @db.Uuid
  // Denormalized version at the time of the event so the audit trail is
  // meaningful even if versions are later cleaned up.
  version   Int
  // 'client' | 'operator' | 'system'. Enforced server-side.
  actor     String
  // Email or operator UUID — whichever identifies the actor. Null for 'system' events.
  actorId   String?
  // 'edit' | 'submit' | 'approve' | 'request_revision' | 'activate' | 'deactivate'.
  // Enforced server-side.
  action    String
  // Optional free-text reason (operator's review note, system trigger name, etc.).
  comment   String?
  createdAt DateTime @default(now())

  step   ChatbotConfigStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  tenant Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([stepId])
  @@index([stepId, createdAt])
  @@index([actor])
  @@index([action])
  @@index([tenantId])
}

// =============================================================================
// KAIA-1106 — Tool-integration settings. One row per external tool/service
// that the Kairikos operator portal integrates with (Resend, n8n, Supabase,
// Stripe, etc.). Stores the *reference* to where the secret lives (1Password)
// and operational metadata (last rotation, health status) but NEVER the
// secret value itself — those live in 1Password (CEO decision, KAIA-1058).
//
// API read/write: KAIA-1084  |  Rotate worker: KAIA-1083
// Health probes:  KAIA-1085  |  Frontend:      KAIA-1086
// =============================================================================
model OperatorSettings {
  id                   String    @id @default(uuid()) @db.Uuid
  // Stable identifier used in code and API routes. Never changes after creation.
  // Known values: 'resend', 'n8n', 'supabase', 'portal_api_key', 'postgres_password'
  toolKey              String    @unique
  // Human label shown in the settings UI (e.g. "Resend", "n8n", "Supabase").
  displayName          String
  // Category for dashboard grouping: 'email' | 'workflow' | 'database' | 'auth' | 'billing' | 'other'
  category             String
  // The env var that holds the secret value (nullable — some tools don't use one).
  envVarName           String?
  // 1Password reference path: op://Vault/Item/Field. Never the actual secret value.
  secretManagerRef     String
  // Last successful rotation timestamp (set by the rotate worker, KAIA-1083).
  lastRotatedAt        DateTime?
  // Last health-check timestamp (set by the health probe worker, KAIA-1085).
  lastHealthCheckAt    DateTime?
  // Most recent health status: 'healthy' | 'degraded' | 'failed' | 'unknown'
  lastHealthStatus     String    @default("unknown")
  // Days after which a rotation reminder badge appears (default 90).
  rotationReminderDays Int       @default(90)
  // Free-text notes from the operator.
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  auditLogs OperatorSettingsAudit[]

  @@index([category])
  @@index([lastHealthStatus, lastHealthCheckAt])
}

// Immutable (append-only) audit log for OperatorSettings changes.
// Enforced at the application layer: the helper module in
// src/lib/operator-settings.ts only exposes create — never update or delete.
// One row per discrete event: creation, field update, rotation request,
// rotation result, health status change, or deletion.
model OperatorSettingsAudit {
  id              String   @id @default(uuid()) @db.Uuid
  settingsId      String   @db.Uuid
  // FK to the future Operator identity model (KAIA-1082).
  // Nullable until KAIA-1082 lands; after that, this becomes required.
  actorOperatorId String?  @db.Uuid
  // Denormalized at write-time so the audit trail is meaningful even if
  // the operator is later removed from the DB.
  actorEmail      String?
  // Event type: 'created' | 'updated' | 'rotation_requested' | 'rotation_succeeded'
  // | 'rotation_failed' | 'health_status_changed' | 'deleted'
  action          String
  // Row snapshot before the change (omit secret values — only schema refs).
  before          Json?
  // Row snapshot after the change.
  after           Json?
  // Free-form metadata: request_id, user_agent, IP, TOTP-verified flag, etc.
  metadata        Json?
  createdAt       DateTime @default(now())

  operatorSettings OperatorSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  operator         Operator?        @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([settingsId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// NextAuth.js v5 (KAIA-753) — required by @auth/prisma-adapter.
// We run with JWT session strategy (no DB-backed sessions), so the Session
// model is unused at runtime, but the adapter still requires the model to
// exist in the schema. The VerificationToken model is the hot path for the
// Resend magic-link provider: one row per email send, deleted on click.
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
