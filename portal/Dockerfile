# =============================================================================
# Kairikos portal — Next.js production image (KAIA-754 / CTO follow-up)
#
# Multi-stage build to keep the runtime image small:
#   deps    — installs only production deps
#   builder — installs all deps, runs prisma generate, builds Next.js
#   runner  — minimal Node 20-bookworm-slim (Debian 12), non-root user, runs `next start`
#
# Base: node:20-bookworm-slim (glibc). Rejected: alpine (musl), bullseye-slim (older).
# bookworm-slim ships ~150MB vs alpine's ~120MB, but has a better security-patch
# surface and standard glibc (no musl compatibility issues with Node.js native modules).
#
# Health check is wired to /api/health (a small endpoint that returns 200
# with {"status":"ok"} — see src/app/api/health/route.ts).
# =============================================================================

# ---------- deps ----------
FROM node:20-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY portal/package.json portal/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# ---------- builder ----------
FROM node:20-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY portal/package.json portal/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY portal/ ./
# Prisma needs DATABASE_URL at generate time; a placeholder is fine because
# the schema doesn't introspect the database — it just generates the client.
ENV DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
ENV NEXT_TELEMETRY_DISABLED=1
# Ensure /app/public exists in the builder stage. The Next.js app
# doesn't ship a public/ dir today, but the runner stage's COPY of
# /app/public requires the source to exist. An empty dir is fine —
# Next.js handles the empty-public case.
RUN mkdir -p /app/public
RUN npx prisma generate
RUN npm run build

# ---------- runner ----------
FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates curl dumb-init && rm -rf /var/lib/apt/lists/* \
    && addgroup --system --gid 1001 nodejs \
    && adduser  --system --uid 1001 nextjs \
    # Ensure ./public exists in the runner stage before the COPY below.
    # If the builder didn't produce /app/public (no public/ dir in the
    # Next.js app), the destination is still there as an empty dir, and
    # Next.js handles the empty-public case fine.
    && mkdir -p ./public

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static    ./.next/static
# NOTE: no `2>/dev/null || true` on COPY — Docker interprets shell
# redirects in COPY source paths as literal filenames ("/2>/dev/null:
# not found"). If the source doesn't exist, COPY errors and the build
# fails. The mkdir above guarantees the destination exists; if the
# Next.js app adds a public/ dir later, the COPY will pick it up.
COPY --from=builder --chown=nextjs:nodejs /app/public          ./public
COPY --from=builder --chown=nextjs:nodejs /app/node_modules    ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/prisma         ./prisma
# NOTE: the runtime image does NOT include the prisma CLI. The prisma
# client (generated by `npx prisma generate` in the builder stage) is
# already at /app/prisma above. If we ever need to run migrations at
# runtime (not just at deploy time), we should `npm install --prefix
# /usr/local prisma` in the runner stage instead of trying to COPY from
# a path that doesn't exist.

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
