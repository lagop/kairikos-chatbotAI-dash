# =============================================================================
# Kairikos — VPS production .env (KAIA-754 follow-up)
# =============================================================================
# This file is the env that the Hostinger Docker Manager / `docker compose`
# reads on the VPS. Copy to `.env.production` (gitignored) and fill in real
# values. The CEO is the only one who can populate the secrets below.
#
# Quick start (dev-ip-port mode — recommended for the first deploy):
#   1. Copy this file:  cp .env.production.example .env.production
#   2. Fill in the "Core" section below AND the "Required for Canales /
#      cron / 2FA" section — the app boots without the "Optional" sections,
#      but those features stay dark until you fill them in later.
#   3. In the Hostinger Docker Manager, point at:
#      https://raw.githubusercontent.com/lagop/kairikos-chatbotAI-dash/kaia-743-staging-runner/docker-compose.yml
#      (kaia-743-staging-runner is the repo's real default branch — NOT
#      main, which sat 225 commits behind as of 2026-08-20)
#      ...or `git pull` on the VPS and `docker compose up -d`.
#
# Before the FIRST deploy: run `npm run prisma:migrate:deploy` against
# this env's DATABASE_URL/DIRECT_URL — the image does not run migrations
# itself (see portal/README.md § "Migrations are a separate, explicit
# step"). This VPS's Postgres is a brand-new, empty database — this is a
# from-scratch migration, not a catch-up.
#
# Generate secrets:
#   POSTGRES_PASSWORD  — any random string, e.g.  openssl rand -hex 24
#   AUTH_SECRET        — openssl rand -base64 32
#   RESEND_API_KEY     — from https://resend.com/api-keys
#   PORTAL_API_KEY     — openssl rand -hex 32  (shared with the n8n flows)
# =============================================================================

# --- Deploy mode ---------------------------------------------------------------
# dev-ip-port (default): app exposed on APP_PORT, no nginx, no certbot.
#                        Use this until portal.kairikos.com DNS is set up.
# prod-dns-tls:          full stack with nginx + certbot on 80/443.
#                        Use once portal.kairikos.com points at the VPS.
DEPLOY_MODE=dev-ip-port

# --- Host port (dev-ip-port mode only) ----------------------------------------
# The app container listens on 3000 internally; this maps it to a host port.
# Default 3001 (matches the local dev port for consistency).
APP_PORT=3001

# --- PostgreSQL (the postgres service in docker-compose.yml) ------------------
POSTGRES_USER=kairikos
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=kairikos_portal

# --- Backups (the backup service in docker-compose.yml) ------------------------
# Daily pg_dump into the `backups` volume by default — both have sane
# defaults, uncomment only to change them. See scripts/backup-postgres.sh
# and scripts/restore-postgres.sh (run the restore drill once after the
# first real deploy — an untested backup is not a backup).
# BACKUP_RETENTION_DAYS=14
# BACKUP_INTERVAL_SECONDS=86400

# --- NextAuth (portal frontend) ------------------------------------------------
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_EMAIL_FROM=Kairikos Portal <hola@kairikos.com>
AUTH_SUPPORT_EMAIL=hola@kairikos.com
AUTH_SUPPORT_WHATSAPP=https://wa.me/34624514425

# --- Resend (magic-link SMTP) --------------------------------------------------
RESEND_API_KEY=CHANGE_ME_from_resend_com_api_keys

# --- NEXTAUTH_URL --------------------------------------------------------------
# Must match how the user reaches the portal:
#   dev-ip-port mode:  http://<VPS_IP>:3001
#   prod-dns-tls mode: https://portal.kairikos.com
NEXTAUTH_URL=http://CHANGE_ME_VPS_IP:3001

# --- Internal API (n8n → portal) -----------------------------------------------
# Shared secret used by the n8n T+0/3/7/14 flows to authenticate against
# /api/internal/*. Generate with: openssl rand -hex 32
PORTAL_API_KEY=CHANGE_ME_openssl_rand_hex_32

# =============================================================================
# REQUIRED — without these, the app boots but Canales (chatbot channel
# activation: Web/Telegram/WhatsApp/Messenger/Instagram), the 3 cron
# routes (webhook retry, conversation digests, review sync), operator
# 2FA, and the operator QA bypass are all dead.
# =============================================================================

# 256-bit hex key (32 bytes = 64 hex chars), AES-256-GCM. Encrypts
# Telegram bot tokens / Meta access tokens at rest. Deliberately a
# DIFFERENT key from every other *_ENCRYPTION_KEY below — different
# secret classes should never share key material.
# Generate with: openssl rand -hex 32
CHANNEL_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# 256-bit hex key encrypting operator TOTP secrets at rest.
# Generate with: openssl rand -hex 32
OPERATOR_TOTP_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# Shared secret the scheduler sends back as `Authorization: Bearer
# <CRON_SECRET>` on every invocation of /api/cron/*. On the VPS there is
# no Vercel Cron — wire this to whatever hits those routes on a
# schedule (a host crontab calling curl, systemd timers, etc.).
# Generate with: openssl rand -hex 32
CRON_SECRET=CHANGE_ME_openssl_rand_hex_32

# QA/operator-key bypass: a request carrying header
# `x-kaia-operator-key` matching this value gets an operator session
# without going through TOTP login. Keep this tightly held.
# Generate with: openssl rand -hex 32
KAIA_OPERATOR_API_KEY=CHANGE_ME_openssl_rand_hex_32

# Portal → n8n push (channel connect/disconnect events). The n8n side
# must expose a webhook at this URL and validate the same secret.
N8N_CHANNEL_WEBHOOK_URL=
# Generate with: openssl rand -hex 32
N8N_CHANNEL_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32

# Base URL of the n8n webhook that receives incoming Telegram messages
# (the portal appends `?connectionId=<uuid>` per connection). Not a
# secret — Telegram itself must be able to reach it.
N8N_TELEGRAM_WEBHOOK_BASE_URL=

# n8n's webhook for the web chat widget — the widget calls this
# directly from the visitor's browser, the portal only relays it.
N8N_WEBCHAT_URL=

# Meta (WhatsApp/Messenger/Instagram) app credentials — from the Meta
# App Dashboard. META_APP_ID and META_CONFIG_ID are not secrets (Meta's
# own JS SDK expects them visible in the browser); only
# META_APP_SECRET is sensitive.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=

# =============================================================================
# OPTIONAL — leave blank until you activate the matching product. The
# app degrades gracefully (that one feature shows as "not configured")
# when any of these are unset; none of them block the first deploy.
# =============================================================================

# --- Reseñas (Google Business) --------------------------------------------
GOOGLE_BUSINESS_OAUTH_CLIENT_ID=
GOOGLE_BUSINESS_OAUTH_CLIENT_SECRET=
GOOGLE_BUSINESS_OAUTH_REDIRECT_URI=
# Generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- IA (respuestas de reseñas + resúmenes de conversación) ---------------
ANTHROPIC_API_KEY=

# --- Facturación (Stripe) ---------------------------------------------------
# An operator can already paste a Stripe secret key at
# /admin/portal/settings/billing (encrypted at rest with
# STRIPE_CREDENTIAL_ENCRYPTION_KEY, stored in Postgres) — these env vars
# are only the pre-UI fallback, not required to boot billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Generate with: openssl rand -hex 32
STRIPE_CREDENTIAL_ENCRYPTION_KEY=

# --- Alta de clientes (Drive + Paperclip) -----------------------------------
DRIVE_PARENT_FOLDER_ID=
PAPERCLIP_API_KEY=
PAPERCLIP_API_URL=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_DAY2_AGENT_ID=

# --- Notificaciones internas -------------------------------------------------
KAIRIKOS_CEO_EMAIL=
KAIRIKOS_OPERATOR_EMAILS=
KAIRIKOS_NOTIFY_KINDS=
OPERATOR_NOTIFY_FROM=

# --- Analítica + URL canónica -------------------------------------------------
PORTAL_ANALYTICS_ENDPOINT=
PORTAL_ANALYTICS_SITE_ID=
NEXT_PUBLIC_PORTAL_URL=

# --- Panel de salud de flujos (lee ejecuciones de n8n) -----------------------
# N8N_BASE_URL defaults to https://n8n.kairikos.com in code if unset.
N8N_API_KEY=
N8N_BASE_URL=
