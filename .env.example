# =============================================================================
# Kairikos — environment variables reference
# =============================================================================
# This file lists the environment variables consumed by the Kairikos stack.
# It is a TEMPLATE — copy to `.env` and fill in real values locally.
# NEVER commit a real `.env` to git.
# =============================================================================

# --- Supabase (production) ----------------------------------------------------
# URL of the Supabase project. The portal frontend uses the anon key to call
# PostgREST with the CLIENT'S JWT (RLS scopes row access per tenant).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — restricted to:
#   * n8n webhook writers (chatbot_activity, chatbot_conversations)
#   * NestJS /admin/portal/* support view backend
#   * Stripe webhook handler (chatbot_clients.subscription state)
# The portal frontend must NEVER see this key.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection strings. The first is the standard project connection
# (used by migrations and the smoke). The second is the service-role DB URL,
# which bypasses RLS — used for the seed script and the migration runner.
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_DB_URL=

# --- Stripe (production) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The portal frontend uses the publishable key only.
STRIPE_PUBLISHABLE_KEY=

# --- Application (NestJS) -----------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated allowlist for the CORS layer. Add portal.kairikos.com in prod.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Portal frontend (Vercel, namespaced per CTO decision KAIA-735) ----------
# These vars live in the *same* Vercel project as the marketing site
# (project: kairikos). The PORTAL_ prefix distinguishes them from
# marketing-site vars. The Next.js app reads the NEXT_PUBLIC_* aliases
# at build time; Vercel maps the PORTAL_* values into them.
#
#   PORTAL_SUPABASE_URL              -> NEXT_PUBLIC_SUPABASE_URL
#   PORTAL_SUPABASE_ANON_KEY         -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   PORTAL_API_BASE_URL              -> NEXT_PUBLIC_PORTAL_API_BASE_URL
#   PORTAL_SITE_URL                  -> NEXT_PUBLIC_PORTAL_URL
#
# SUPABASE_SERVICE_ROLE_KEY stays un-prefixed and is server-only.
PORTAL_SUPABASE_URL=
PORTAL_SUPABASE_ANON_KEY=
PORTAL_SUPABASE_SERVICE_ROLE_KEY=
PORTAL_API_BASE_URL=http://localhost:3000
PORTAL_SITE_URL=http://localhost:3001
# Comma-separated; in prod must include https://portal.kairikos.com
# and https://portal.kairikos.com/api/auth/callback (Supabase
# Authentication -> URL Configuration -> Additional Redirect URLs).
PORTAL_REDIRECT_ALLOWLIST=http://localhost:3001/api/auth/callback

# --- Observability ------------------------------------------------------------
LOG_LEVEL=info
# Sentry / OTEL endpoints go here when the observability stack is wired.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
