# =============================================================================
# Kairikos — environment variables reference
# =============================================================================
# This file lists the environment variables consumed by the Kairikos stack.
# It is a TEMPLATE — copy to `.env` and fill in real values locally.
# NEVER commit a real `.env` to git.
# =============================================================================

# --- Supabase (production) ----------------------------------------------------
# URL of the Supabase project. The portal frontend uses the anon key to call
# PostgREST with the CLIENT'S JWT (RLS scopes row access per tenant).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — restricted to:
#   * n8n webhook writers (chatbot_activity, chatbot_conversations)
#   * NestJS /admin/portal/* support view backend
#   * Stripe webhook handler (chatbot_clients.subscription state)
# The portal frontend must NEVER see this key.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection strings. The first is the standard project connection
# (used by migrations and the smoke). The second is the service-role DB URL,
# which bypasses RLS — used for the seed script and the migration runner.
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_DB_URL=

# --- PostgreSQL (Prisma + Docker, KAIA-752) ----------------------------------
# Consumed by docker-compose.yml (postgres service) and portal/.env.example
# (DATABASE_URL). The defaults below match the dev setup: docker compose up -d
# postgres on the host loopback, prisma migrate dev against that database.
# In the VPS production deploy these are overridden by the secret store.
POSTGRES_USER=kairikos
POSTGRES_PASSWORD=kairikos_dev_password
POSTGRES_DB=kairikos_portal

# --- Stripe (production) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The portal frontend uses the publishable key only.
STRIPE_PUBLISHABLE_KEY=

# --- Application (NestJS) -----------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated allowlist for the CORS layer. Add portal.kairikos.com in prod.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Portal frontend (VPS deploy, KAIA-754 + KAIA-755) ------------------------
# The portal frontend no longer lives on Vercel (that rev 2 plan was
# cancelled — see the SUPERSEDED notice in docs/runbook-KAIA-735.md).
# The full frontend env list is in portal/.env.example (DATABASE_URL,
# AUTH_SECRET, RESEND_API_KEY, NEXTAUTH_URL, PORTAL_API_KEY, etc.).
# This file only keeps the deploy-wide values (Postgres credentials,
# Stripe, NestJS server vars) that the VPS compose stack reads.

# --- Auth (KAIA-753, NextAuth.js v5 + Resend magic-link) ------------------
# The NextAuth Email provider on the portal frontend reads these at request
# time. The portal frontend runs on the Kairikos VPS (KAIA-754) — not
# Vercel. Server-only vars (no NEXT_PUBLIC_ prefix) are not exposed to
# the browser; only the Email provider's sendVerificationRequest
# (server-side) reads RESEND_API_KEY.
#
#   AUTH_SECRET       — HMAC key for the JWT session cookie.
#                       Generate: openssl rand -base64 32
#   RESEND_API_KEY    — Resend API token (server-only).
#   AUTH_URL          — canonical origin NextAuth uses for callback URLs.
#                       Must match the deployed origin exactly.
#   AUTH_EMAIL_FROM   — From: address. Must be on a verified Resend domain.
#   AUTH_SUPPORT_EMAIL / AUTH_SUPPORT_WHATSAPP — surfaced in the magic-link
#                       email template and the unknown-email error.
AUTH_SECRET=
RESEND_API_KEY=
AUTH_URL=http://localhost:3001
AUTH_EMAIL_FROM=Kairikos Portal <hola@kairikos.com>
AUTH_SUPPORT_EMAIL=hola@kairikos.com
AUTH_SUPPORT_WHATSAPP=https://wa.me/34600000000

# --- Observability ------------------------------------------------------------
LOG_LEVEL=info
# Sentry / OTEL endpoints go here when the observability stack is wired.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- KAIA-740 staging-apply runbook (supabase/scripts/run-staging-e2e.sh) ----
# These are the runtime values read by the apply-to-staging.sh + run-staging-e2e.sh
# scripts when applying the KAIA-731 schema to a real Supabase project and
# running the per-tenant magic-link e2e check. They live in the project-root
# `.env` (gitignored) only — they are NEVER committed.
#
#   * STAGING_PROJECT_REF  is a hard guard: the orchestrator parses the
#     ref out of SUPABASE_URL and refuses to run if they do not match.
#     This is the defence against accidentally pointing at production.
#   * PORTAL_URL  is the staging frontend URL (NOT the Supabase URL).
#     The orchestrator rejects localhost / 127.0.0.1 so the e2e cannot
#     accidentally run against a dev mock. The value typically matches
#     PORTAL_SITE_URL above for the staging deployment.
#   * STAGING_TEST_USER_*_EMAIL override the defaults baked into the
#     seed (onboarding-test1/2@kairikos.dev, staff-test@kairikos.dev).
#     Only set these if the operator pre-created auth.users with
#     different emails via Supabase Studio.
STAGING_PROJECT_REF=
PORTAL_URL=
STAGING_TEST_USER_A_EMAIL=
STAGING_TEST_USER_B_EMAIL=
STAGING_TEST_USER_STAFF_EMAIL=
