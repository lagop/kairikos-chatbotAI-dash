        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ connectionId: $('Extract Input').first().json.connectionId, chatId: $('Extract Input').first().json.chatId, text: $json.reply }) }}",
        "options": {
