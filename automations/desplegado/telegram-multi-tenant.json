    {
      "id": "extract-input",
      "name": "Extract Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body || {};\nconst query = item.query || {};\nconst connectionId = (query.connectionId || '').toString().trim();\nconst message = body.message || body.edited_message || null;\nconst text = message && typeof message.text === 'string' ? message.text.trim() : '';\nconst chatId = message && message.chat ? message.chat.id : null;\nconst errorCode = !connectionId ? 'missing_connection_id' : (!text || chatId === null ? 'not_a_text_message' : '');\nreturn [{ json: { _error: errorCode, connectionId, chatId, text } }];"
      }
    },
    {
      "id": "has-input?",
      "name": "Has Valid Input?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json._error === '' }}",
              "value2": true
            }
          ]
        }
      }
    },
