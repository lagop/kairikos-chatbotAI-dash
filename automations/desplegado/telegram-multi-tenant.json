            }
          }
        }
      }
    },
    {
      "id": "has-contact-intent",
      "name": "Has Contact Intent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1320,
        -80
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ /(cita|presupuesto|contacto|llamar|llamame|reuni[oó]n|hablar|contratar|me interesa|quiero|necesito|reservar|agendar|disponibilidad|horario|email|correo|tel[eé]fono|whatsapp)/i.test($('Extract Input').first().json.text || '') }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "classify-lead",
      "name": "Classify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0.1, max_tokens: 200, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: \"Analiza el mensaje de un posible cliente que le escribio a un chatbot de atencion al cliente. Decide si muestra intencion comercial real (pedir presupuesto, reservar, comprar, contratar, pedir cita) y extrae los datos de contacto que haya dado, si los hay. Responde UNICAMENTE con un objeto JSON, sin texto adicional, con esta forma exacta: {\\\"isLead\\\": boolean, \\\"score\\\": numero entre 0 y 100 (que tan probable es que se convierta en cliente), \\\"contactName\\\": string o null, \\\"contactPhone\\\": string o null, \\\"contactEmail\\\": string o null, \\\"summary\\\": resumen breve (menos de 20 palabras) de que pidio, o null}. Si no hay intencion comercial clara, isLead debe ser false.\" }, { role: 'user', content: $('Extract Input').first().json.text } ] }) }}",
        "options": {
          "timeout": 15000,
          "retry": {
            "maxTries": 1
          },
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "continueOnFail": true
    },
    {
      "id": "parse-lead-classification",
      "name": "Parse Lead Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -80
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst content = raw && raw.choices && raw.choices[0] && raw.choices[0].message && raw.choices[0].message.content;\nlet parsed = null;\ntry { parsed = content ? JSON.parse(content) : null; } catch (e) { parsed = null; }\nconst isLead = Boolean(parsed && parsed.isLead === true);\nconst score = parsed && typeof parsed.score === 'number' ? Math.max(0, Math.min(100, Math.round(parsed.score))) : null;\nreturn [{ json: {\n  isLead,\n  score,\n  contactName: (parsed && parsed.contactName) || null,\n  contactPhone: (parsed && parsed.contactPhone) || null,\n  contactEmail: (parsed && parsed.contactEmail) || null,\n  summary: (parsed && parsed.summary) || null,\n} }];"
      },
      "continueOnFail": true
    },
    {
      "id": "is-lead-detected",
      "name": "Is Lead Detected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1980,
        -80
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isLead === true && Number($json.score || 0) >= 40 }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "post-lead",
      "name": "POST Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
