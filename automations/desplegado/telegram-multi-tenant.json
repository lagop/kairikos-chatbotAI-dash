        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversationId: $('Log Bot Message').first().json.conversationId, contactName: $json.contactName || undefined, contactPhone: $json.contactPhone || undefined, contactEmail: $json.contactEmail || undefined, summary: $json.summary || undefined, score: $json.score, channel: 'telegram' }) }}",
        "options": {
          "timeout": 8000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "continueOnFail": true
    }
