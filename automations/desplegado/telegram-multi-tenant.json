    {
      "id": "build-system-prompt",
      "name": "Build System Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -160
      ],
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst businessName = ctx.businessName || 'nuestro negocio';\nconst prompts = Array.isArray(ctx.suggestedPrompts) ? ctx.suggestedPrompts : [];\nconst systemPrompt = [\n  `Eres el asistente virtual de \"${businessName}\", respondiendo por Telegram.`,\n  'Tu objetivo:',\n  '1. Responder dudas del usuario con tono cercano y profesional, en espanol, de forma breve (maximo 60 palabras salvo que pidan mas detalle).',\n  '2. Si detectas intencion de contacto (pedir cita, presupuesto, hablar con alguien, reservar), pide amablemente nombre y datos de contacto, y confirma que el equipo respondera pronto.',\n  '3. NUNCA inventes precios, horarios, servicios ni datos concretos que no te hayan dado explicitamente -- si no lo sabes, dilo con honestidad y ofrece derivar a un humano.',\n  prompts.length ? ('Temas frecuentes que este negocio espera que puedas ayudar a resolver: ' + prompts.join(', ') + '.') : '',\n].filter(Boolean).join('\\n');\nreturn [{ json: { systemPrompt, businessName } }];"
      }
    },
    {
      "id": "call-llm",
      "name": "Call LLM (OpenAI via HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -160
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0.4, max_tokens: 350, messages: [ { role: 'system', content: $json.systemPrompt }, { role: 'user', content: $('Extract Input').first().json.text } ] }) }}",
        "options": {
          "timeout": 20000,
          "retry": {
            "maxTries": 2,
            "waitBetween": 1500
          },
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -160
      ],
      "parameters": {
        "jsCode": "const llm = $input.first().json;\nconst ctx = $('Build System Prompt').first().json;\nconst input = $('Extract Input').first().json;\nconst msgLower = (input.text || '').toLowerCase();\nconst contactIntent = /(cita|presupuesto|contacto|llamar|llamame|reuni[oó]n|hablar|contratar|me interesa|quiero|necesito|reservar|agendar|disponibilidad|horario|email|correo|tel[eé]fono|whatsapp)/i.test(msgLower);\nlet reply = '';\nlet mode = 'llm';\nlet errorDetail = null;\nif (llm && llm.choices && Array.isArray(llm.choices) && llm.choices[0] && llm.choices[0].message && llm.choices[0].message.content) {\n  reply = llm.choices[0].message.content.toString().trim();\n} else {\n  mode = 'fallback';\n  errorDetail = (llm && llm.error && llm.error.message) || 'unknown';\n  reply = contactIntent\n    ? ('Gracias por escribir. Para ayudarte mejor, cuentame tu nombre y un email o telefono de contacto -- alguien de ' + ctx.businessName + ' te respondera en breve.')\n    : ('Gracias por tu mensaje. Ahora mismo no puedo darte una respuesta detallada, pero el equipo de ' + ctx.businessName + ' lo revisara. Si quieres, dejame tus datos de contacto.');\n}\nreturn [{ json: { connectionId: input.connectionId, chatId: input.chatId, text: input.text, reply, mode, contactIntent, error: errorDetail } }];"
      }
    },
