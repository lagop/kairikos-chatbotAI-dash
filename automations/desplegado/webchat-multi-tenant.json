      "name": "Webhook: Widget Message",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "kairikos-webchat-multitenant",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "f5386b96-4998-4d6a-95fc-fb2695deef4c"
    },
    {
      "id": "extract-input",
      "name": "Extract Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Expected body: { action:'kairikos_chatbot', publicToken, sessionId, message, timestamp }\nconst body = $input.first().json.body || $input.first().json || {};\nconst message = (body.message || '').toString().trim();\nconst publicToken = (body.publicToken || '').toString().trim();\nconst sessionId = (body.sessionId || ('web-' + Date.now())).toString();\nconst errorCode = !publicToken ? 'missing_public_token' : (!message ? 'empty_message' : '');\nreturn [{ json: { _error: errorCode, message, publicToken, sessionId } }];"
      }
    },
    {
      "id": "has-input?",
      "name": "Has Valid Input?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json._error === '' }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "portal-reply",
      "name": "POST /api/internal/channels/web/reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PORTAL_API_URL }}/api/internal/channels/web/reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Kairikos-Internal-Key",
              "value": "={{ $env.PORTAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ publicToken: $json.publicToken, sessionId: $json.sessionId, text: $json.message }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "widget-desconocido",
      "name": "Widget Desconocido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        880,
        -80
      ],
      "parameters": {
        "conditions": {
          "boolean": [
