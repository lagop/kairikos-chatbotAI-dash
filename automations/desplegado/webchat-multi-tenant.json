              "value1": "={{ $json.error === 'not_found' || $json.error === 'disabled' }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -80
      ],
      "parameters": {
        "jsCode": "// Traduce la respuesta del portal al contrato que espera el widget.\n// El portal ya genero la respuesta con la configuracion aprobada, el\n// historial y la base de conocimiento, y ya guardo los dos turnos: aqui\n// solo se le da forma. Ver docs/plan-motor-chatbot.md.\nconst res = $input.first().json || {};\nconst input = $('Extract Input').first().json;\nconst contactIntent = /(cita|presupuesto|contacto|llamar|llamame|reuni[oó]n|hablar|contratar|me interesa|quiero|necesito|reservar|agendar|disponibilidad|horario|email|correo|tel[eé]fono|whatsapp)/i.test(input.message || '');\n\nlet reply = typeof res.reply === 'string' ? res.reply.trim() : '';\nlet mode = 'portal';\nlet errorDetail = null;\n\nif (!reply) {\n  if (res.handledBy === 'human') {\n    // Una persona tiene la conversacion: el bot se calla a proposito.\n    mode = 'human';\n    reply = 'Ahora mismo te atiende una persona del equipo. Escribe aqui tu mensaje y lo vera enseguida.';\n  } else if (res.reason === 'monthly_cap_reached') {\n    // El chatbot agoto su tope de mensajes del mes (lib/chatbot-usage.ts).\n    mode = 'cap';\n    reply = 'Ahora mismo no puedo responderte por aqui. Dejanos tu consulta con un email o telefono y el equipo te contesta en breve.';\n  } else {\n    mode = 'fallback';\n    errorDetail = res.error || res.detail || 'unknown';\n    reply = contactIntent\n      ? 'Gracias por escribir. Para ayudarte mejor, cuentame tu nombre y un email o telefono de contacto y el equipo te respondera en breve.'\n      : 'Gracias por tu mensaje. Ahora mismo no puedo darte una respuesta detallada, pero el equipo lo revisara. Si quieres, dejame tus datos de contacto.';\n  }\n}\n\nreturn [{ json: {\n  sessionId: input.sessionId,\n  publicToken: input.publicToken,\n  reply,\n  timestamp: new Date().toISOString(),\n  mode,\n  contactIntent,\n  error: errorDetail,\n  conversationId: res.conversationId || null,\n} }];"
      }
    },
    {
      "id": "respond-200",
      "name": "Respond 200 (WP contract)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
        -160
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, data: { sessionId: $('Format Response').first().json.sessionId, reply: $('Format Response').first().json.reply, timestamp: $('Format Response').first().json.timestamp, mode: $('Format Response').first().json.mode, contactIntent: $('Format Response').first().json.contactIntent, error: $('Format Response').first().json.error } }) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
