    {
      "id": "kairikos-portal-scan-log",
      "name": "Log Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1570, 300],
      "parameters": {
        "jsCode": "// Aggregate log for both scan types.\n// Each branch appends its own result. We flatten here.\nconst items = $input.all();\nconst results = items.map(item => item.json);\nconst wizardAbandonedCount = results.filter(r => r.clientId && r.milestone === 'wizard_abandoned').length;\nconst reviewOverdueCount = results.filter(r => r.stepId && r.kind && r.kind.startsWith('review-overdue')).length;\nconst dedupedCount = results.filter(r => r.deduped === true).length;\nconst firedCount = results.filter(r => r.deduped === false).length;\nconsole.log(`[kairikos-portal-wizard-scan] wizard-abandoned: ${wizardAbandonedCount} candidates, ${dedupedCount} deduped, ${firedCount} fired`);\nconsole.log(`[kairikos-portal-wizard-scan] review-overdue: ${reviewOverdueCount} candidates, ${dedupedCount} deduped, ${firedCount} fired`);\nreturn results.map(r => ({ json: r }));"
      }
    },
    {
      "id": "kairikos-portal-scan-report",
      "name": "Report Execution to Portal (KAIA-1073)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1790, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PORTAL_API_URL }}/api/internal/n8n-execution",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Kairikos-Internal-Key",
              "value": "={{ $env.PORTAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "body": "={{ JSON.stringify((() => { const exec = $execution; const startedAt = exec && exec.startedAt ? new Date(exec.startedAt).toISOString() : new Date().toISOString(); const finishedAt = new Date().toISOString(); const errObj = $json && $json.error; const isFailure = Boolean(errObj); const code = isFailure ? (errObj.name || (errObj.httpCode ? 'HTTP_' + errObj.httpCode : 'WORKFLOW_ERROR')) : 'OK'; const message = isFailure ? String(errObj.message || errObj.description || 'unknown n8n error').slice(0, 4000) : null; return { id: String(exec.id), clientId: null, clientName: null, workflow: 'Kairikos Portal — Wizard Scan (KAIA-1521)', milestone: 'wizard_scan', status: isFailure ? 'failed' : 'success', startedAt, finishedAt, errorCode: isFailure ? String(code).slice(0, 100) : null, errorMessage: message }; })()) }}",
        "options": {
          "timeout": 15000,
          "retry": {
            "maxTries": 3,
            "waitBetween": 5000
          },
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    }
