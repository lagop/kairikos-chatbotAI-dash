    {
      "id": "kairikos-portal-wizard-abandoned-build-fire",
      "name": "wizard-abandoned — Build Fire Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 200],
      "parameters": {
        "jsCode": "// Build the fire payload for wizard-abandoned.\n// Input: one scan-candidate item from the split batch.\n// Output: body for /api/internal/wizard-abandoned/fire\nconst input = $input.first().json;\nreturn [{\n  json: {\n    clientId: input.clientId,\n    lastDraftAt: input.lastDraftAt,\n    lastStepKey: input.lastStepKey,\n    hoursSinceLastDraft: Math.max(0, Math.round(Number(input.hoursSinceLastDraft) || 0)),\n  },\n}];"
      }
    },
    {
      "id": "kairikos-portal-review-overdue-build-fire",
      "name": "review-overdue — Build Fire Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 400],
      "parameters": {
        "jsCode": "// Build the fire payload for review-overdue.\n// Input: one scan-candidate item from the split batch.\n// Output: body for /api/internal/review-overdue/fire\nconst input = $input.first().json;\nreturn [{\n  json: {\n    stepId: input.stepId,\n    clientId: input.clientId,\n    stepKey: input.stepKey,\n    stepVersion: input.stepVersion,\n    status: input.status,\n    severity: input.severity,\n    businessHoursElapsed: Number(input.businessHoursElapsed) || 0,\n    operatorTimezone: input.operatorTimezone || 'Europe/Madrid',\n  },\n}];"
      }
    },
    {
      "id": "kairikos-portal-wizard-abandoned-fire",
      "name": "wizard-abandoned — Fire",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1350, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PORTAL_API_URL }}/api/internal/wizard-abandoned/fire",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
