      "name": "wizard-abandoned — Skip if alreadyFiredInWindow",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [910, 200],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "uuid-wa-skip",
              "name": "alreadyFiredInWindow is false (process)",
              "operator": {
                "type": "boolean",
                "operation": "false"
              },
              "value1": "={{ $json.alreadyFiredInWindow }}",
              "value2": [true]
            }
          ],
          "combinator": "and"
        }
      }
    },
