{
  "name": "Operator Notify — escalation (KAIA-1061)",
  "nodes": [
    {
      "id": "kairikos-notify-escalation-trigger",
      "name": "escalation — Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "kairikos-notify-escalation-build-payload",
      "name": "Build Notify Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "jsCode": "// Escalation payload builder.\n// Input: a list of clients where the latest activity milestone is T+7\n// and no escalation has been recorded for them. Emits one\n// notify-operator payload per client.\nconst input = $input.first().json;\nreturn [{\n  json: {\n    payload: {\n      kind: 'escalation',\n      clientId: input.clientId,\n      reason: input.reason || 'T+7 follow-up overdue',\n      status: input.status || null,\n    },\n  },\n}];"
      }
    },
    {
      "id": "kairikos-notify-escalation-send",
      "name": "POST /api/internal/notify-operator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PORTAL_API_URL }}/api/internal/notify-operator",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Kairikos-Internal-Key",
              "value": "={{ $env.PORTAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "kairikos-notify-escalation-log",
      "name": "Log Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        910,
        300
      ],
      "parameters": {
        "jsCode": "// Surface the dedup / sent state in the workflow logs so the\n// operator can confirm via n8n that the alert reached the\n// portal. The portal persists the row regardless.\nconst out = $input.first().json;\nconst log = {\n  kind: out.kind,\n  clientId: out.clientId,\n  deduped: Boolean(out.deduped),\n  skipped: out.skipped,\n  resendMessageId: out.resendMessageId,\n  sentAt: out.sentAt,\n};\nconsole.log(`[notify-operator] ${JSON.stringify(log)}`);\nreturn [{ json: log }];"
      }
    },
    {
      "id": "kairikos-notify-escalation-report-execution",
      "name": "Report Execution to Portal (KAIA-1073)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1130,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PORTAL_API_URL }}/api/internal/n8n-execution",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Kairikos-Internal-Key",
              "value": "={{ $env.PORTAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "body": "={{ JSON.stringify((() => { const exec = $execution; const startedAt = exec && exec.startedAt ? new Date(exec.startedAt).toISOString() : new Date().toISOString(); const finishedAt = new Date().toISOString(); const errObj = $json && $json.error; const isFailure = Boolean(errObj); const upstream = $('Build Notify Payload').item && $('Build Notify Payload').item.json; const payload = (upstream && upstream.payload) || {}; const clientId = payload.clientId || null; const code = isFailure ? (errObj.name || (errObj.httpCode ? 'HTTP_' + errObj.httpCode : 'WORKFLOW_ERROR')) : 'OK'; const message = isFailure ? String(errObj.message || errObj.description || 'unknown n8n error').slice(0, 4000) : null; return { id: String(exec.id), clientId, clientName: null, workflow: 'Operator Notify — escalation', milestone: 'T+7', status: isFailure ? 'failed' : 'success', startedAt, finishedAt, errorCode: isFailure ? String(code).slice(0, 100) : null, errorMessage: message }; })()) }}",
        "options": {
          "timeout": 15000,
          "retry": {
            "maxTries": 3,
            "waitBetween": 5000
          },
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    }
  ],
  "connections": {
    "kairikos-notify-escalation-trigger": {
      "main": [
